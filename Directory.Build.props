<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- A single version for the whole solution: the VSIX and the Desktop exe stay aligned (the
         footer of the exe and of the tool window show it). The VSIX manifest takes it from here
         (ExtensionAssemblyVersion): reinstalling without changing it updates nothing, because
         the installer finds the same version already present and exits successfully, leaving
         the old binaries in Program Files. Bump it for every install that must actually reach
         Visual Studio. -->
    <Version>2.0.215</Version>
    <!-- English is the only language: without this, publish output carries the WPF, WinForms
         and SqlClient message translations in thirteen languages. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
