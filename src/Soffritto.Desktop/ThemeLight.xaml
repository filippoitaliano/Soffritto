<!-- Light theme for the whole app (ThemeManager). Both theme files share the same keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <LinearGradientBrush x:Key="Theme.CardBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FCFFFEFB" />
    <GradientStop Offset="1" Color="#F8FFFCF5" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Theme.CardBackgroundAllOnDev" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#FFFAF5" />
    <GradientStop Offset="0.55" Color="#FFF7F4" />
    <GradientStop Offset="1" Color="#FDF5F7" />
  </LinearGradientBrush>
  <Color x:Key="Theme.BusyLight">#FCFFFCF6</Color>
  <Color x:Key="Theme.BusyWarm">#FCFDF8EF</Color>
  <Color x:Key="Theme.Base0">#F7F5EE</Color>
  <Color x:Key="Theme.Base1">#F3F1EA</Color>
  <Color x:Key="Theme.Base2">#EDEFE8</Color>
  <Color x:Key="Theme.SpotMint">#80DCEBE2</Color>
  <Color x:Key="Theme.SpotMintClear">#00DCEBE2</Color>
  <Color x:Key="Theme.SpotLight">#99FFFBEF</Color>
  <Color x:Key="Theme.SpotLightClear">#00FFFBEF</Color>
  <Color x:Key="Theme.SpotWarm">#66F2E0CD</Color>
  <Color x:Key="Theme.SpotWarmClear">#00F2E0CD</Color>
  <Color x:Key="Theme.ChromeGradient">#3A3128</Color>
  <SolidColorBrush x:Key="Theme.Text" Color="#2E2820" />
  <SolidColorBrush x:Key="Theme.TextStrong" Color="#3B3226" />
  <SolidColorBrush x:Key="Theme.TextSoft" Color="#4A4033" />
  <SolidColorBrush x:Key="Theme.LaneText" Color="#2A251E" />
  <SolidColorBrush x:Key="Theme.LaneHeaderText" Color="#5A4C38" />
  <SolidColorBrush x:Key="Theme.FieldText" Color="#1F2328" />
  <SolidColorBrush x:Key="Theme.LabelText" Color="#6B5B45" />
  <SolidColorBrush x:Key="Theme.TextMuted" Color="#8A7A62" />
  <SolidColorBrush x:Key="Theme.IconMuted" Color="#A8946F" />
  <SolidColorBrush x:Key="Theme.CardBorder" Color="#E6DAC0" />
  <SolidColorBrush x:Key="Theme.CardBorderAllOnDev" Color="#F0DDD5" />
  <SolidColorBrush x:Key="Theme.Separator" Color="#EFE6D2" />
  <SolidColorBrush x:Key="Theme.SubtleBorder" Color="#EDE3CC" />
  <SolidColorBrush x:Key="Theme.FieldBorder" Color="#E0D3B4" />
  <SolidColorBrush x:Key="Theme.LaneBorder" Color="#E6DCC4" />
  <SolidColorBrush x:Key="Theme.FieldBorderHover" Color="#CDB98C" />
