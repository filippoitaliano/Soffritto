<!-- Pull requests panel, sliding in on one side of the main window: your own and those to
     review, grouped by work item. The eye must land on what needs doing: blue bar and text, a
     “to do” chip on the group. The vote status is grey text with the cards' status dot, and work
     items with nothing to do start collapsed. -->
<UserControl x:Class="Soffritto.Desktop.PullRequestsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Soffritto.Desktop"
             Background="Transparent">
  <UserControl.Resources>
    <!-- The blue of to-do actions: the same shade for bar, text and chip. -->

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="SectionSummary" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="10,0,0,2" />
    </Style>

    <Style x:Key="EmptyText" TargetType="TextBlock">
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Margin" Value="2,0,0,4" />
    </Style>

    <!-- A PR: blue bar on the left if there is something to do, layer tag, title and context, and on
         the right the muted vote status. The whole row opens the PR. -->
    <DataTemplate x:Key="RowTemplate">
      <Border BorderBrush="{DynamicResource Theme.Separator}" BorderThickness="0,1,0,0" Background="Transparent" Cursor="Hand" ToolTip="{Binding ToolTip}">
        <Border.InputBindings>
          <MouseBinding Gesture="LeftClick" Command="{Binding OpenCommand}" />
        </Border.InputBindings>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Background="{DynamicResource Theme.TagText}" CornerRadius="2" Margin="0,8" Visibility="{Binding TodoVisibility}" />

          <!-- The app's Tag, tinted with the layer color. -->
          <Border Grid.Column="1"
                  Style="{StaticResource Tag}"
                  MinWidth="42"
                  Margin="10,8,10,0"
                  VerticalAlignment="Top"
                  Background="{Binding RepoBackground}"
                  BorderBrush="{Binding RepoBorder}"
                  ToolTip="{Binding RepoToolTip}">
            <TextBlock Text="{Binding RepoTag}" HorizontalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TagText}">
                  <Setter Property="Foreground" Value="{DynamicResource Theme.NeutralTagText}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding RepoLayer}" Value="Backend">
                      <Setter Property="Foreground" Value="{DynamicResource Theme.LayerBackendText}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RepoLayer}" Value="Frontend">
                      <Setter Property="Foreground" Value="{DynamicResource Theme.LayerFrontendText}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RepoLayer}" Value="App">
                      <Setter Property="Foreground" Value="{DynamicResource Theme.LayerAppText}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>

          <StackPanel Grid.Column="2" Margin="0,8,8,8">
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
            <DockPanel Margin="0,2,0,0">
              <Border DockPanel.Dock="Left"
                      Visibility="{Binding DraftVisibility}"
                      Style="{StaticResource Tag}"
                      Background="#1AD13438"
                      BorderBrush="#4DD13438"
                      Padding="5,0"
                      Margin="0,0,6,0">
                <TextBlock Text="Draft" Style="{StaticResource TagText}" Foreground="{DynamicResource Theme.ErrorText}" FontSize="11" />
              </Border>
              <TextBlock Text="{Binding Meta}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding TodoText}"
                       Visibility="{Binding TodoVisibility}"
                       Foreground="{DynamicResource Theme.TagText}"
                       FontSize="12"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0" />
          </StackPanel>

          <StackPanel Grid.Column="3"
                      Orientation="Horizontal"
                      VerticalAlignment="Top"
                      Margin="0,10,12,0"
                      Opacity="0.75"
                      Background="Transparent"
                      ToolTip="{Binding StatusToolTip}">
            <local:StatusDot Color="{Binding StatusDot}" Margin="-6,-6,0,-6" />
            <TextBlock Text="{Binding StatusText}" FontSize="11" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A work item: header with the number (opens the WI) and the title, a “to do” chip when needed,
         then its PRs, one per layer. IsHighlighted (click on a notification) lights the border
         in StatusBadge.OkColor green and fades it out; the thicker border eats into the margin,
         so the content does not move. -->
    <DataTemplate x:Key="GroupTemplate">
      <!-- The background comes from a style: CardBusy (an “Open in” running) replaces it with the
           repository cards' moving stripes and, when it ends, clears its value to give it back. -->
      <Border x:Name="Card"
              local:CardBusy.IsBusy="{Binding IsBusy}"
              BorderBrush="{DynamicResource Theme.CardBorder}"
              BorderThickness="1,1,1,3"
              CornerRadius="18"
              Margin="0,0,0,10">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
          </Style>
        </Border.Style>
        <StackPanel>
          <!-- The whole header expands and collapses the card; the buttons handle their own click. -->
          <DockPanel Margin="14,10,14,9" Background="Transparent" Cursor="Hand" ToolTip="{Binding TitleToolTip}">
            <DockPanel.InputBindings>
              <MouseBinding Gesture="LeftClick" Command="{Binding Expander.ToggleCommand}" />
            </DockPanel.InputBindings>
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding Expander.Glyph}"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontWeight="Normal"
                       FontSize="11"
                       Opacity="0.6"
                       Width="12"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />
            <!-- Opens a menu of environments: the choice moves that environment onto the PRs' branches.
                 First of the Dock="Right" items, so it always stays on the right edge and the
                 environment tag lines up to its left. -->
            <Button DockPanel.Dock="Right"
                    Click="OpenIn_Click"
                    IsEnabled="{Binding CheckoutEnabled}"
                    ToolTip="{Binding CheckoutToolTip}"
                    ToolTipService.ShowOnDisabled="True"
                    Style="{StaticResource TextButton}"
                    Margin="8,0,0,0"
                    Content="Open in ▾" />
            <!-- The environments already on these PRs' branches: the same state that “Open in” leaves.
                 In the info colors, like its mirror on the environment card (an info FlashCard). -->
            <Border DockPanel.Dock="Right"
                    Visibility="{Binding MatchVisibility}"
                    Style="{StaticResource Tag}"
                    Background="{DynamicResource Theme.FlashInfoFill}"
                    BorderBrush="{DynamicResource Theme.FlashInfoBorder}"
                    ToolTip="{Binding MatchToolTip}">
              <TextBlock Text="{Binding MatchText}" Style="{StaticResource TagText}" Foreground="{DynamicResource Theme.InfoText}" />
            </Border>
            <Button DockPanel.Dock="Left"
                    Visibility="{Binding WorkItemVisibility}"
                    Command="{Binding OpenWorkItemCommand}"
                    ToolTip="Open the work item"
                    Style="{StaticResource TextButton}"
                    Margin="0,0,8,0"
                    Content="{Binding WorkItemId}" />
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource CardTitle}"
                       FontSize="14" />
          </DockPanel>
          <!-- What “Open in” is doing, then its outcome: done, partial or failed. -->
          <local:FlashCard Kind="{Binding ActionKind}"
                           Content="{Binding ActionLine}"
                           Visibility="{Binding ActionVisibility}"
                           Margin="12,0,12,10" />
          <local:Reveal Shown="{Binding Expander.BodyVisibility}">
            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" />
          </local:Reveal>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
          <Setter TargetName="Card" Property="BorderThickness" Value="2,2,2,4" />
          <Setter TargetName="Card" Property="Margin" Value="-1,-1,-1,9" />
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <ColorAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#6BB36B" Duration="0:0:0.2" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <ColorAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" Duration="0:0:0.8" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.ExitActions>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <!-- A card floating over the window: wide corners, the window background, a soft shadow on a
       border behind (on the panel it would blur the text). Margins keep the content away from the
       corners, so it needs no clipping. -->
  <Grid>
    <!-- The same background as the main window (MainWindow): a cream base and three soft spots,
         each layer with the card's corners. -->
    <Border CornerRadius="22">
      <Border.Effect>
        <DropShadowEffect Direction="270" ShadowDepth="6" BlurRadius="28" Opacity="0.24" Color="#5C4A2A" />
      </Border.Effect>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0" Color="{DynamicResource Theme.Base0}" />
          <GradientStop Offset="0.5" Color="{DynamicResource Theme.Base1}" />
          <GradientStop Offset="1" Color="{DynamicResource Theme.Base2}" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border CornerRadius="22">
      <Border.Background>
        <RadialGradientBrush Center="0.15,0.08" GradientOrigin="0.15,0.08" RadiusX="0.25" RadiusY="0.4">
          <GradientStop Offset="0" Color="{DynamicResource Theme.SpotMint}" />
          <GradientStop Offset="1" Color="{DynamicResource Theme.SpotMintClear}" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border CornerRadius="22">
      <Border.Background>
        <RadialGradientBrush Center="0.45,0.05" GradientOrigin="0.45,0.05" RadiusX="0.3" RadiusY="0.45">
          <GradientStop Offset="0" Color="{DynamicResource Theme.SpotLight}" />
          <GradientStop Offset="1" Color="{DynamicResource Theme.SpotLightClear}" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border CornerRadius="22">
      <Border.Background>
        <RadialGradientBrush Center="0.88,0.95" GradientOrigin="0.88,0.95" RadiusX="0.25" RadiusY="0.35">
          <GradientStop Offset="0" Color="{DynamicResource Theme.SpotWarm}" />
          <GradientStop Offset="1" Color="{DynamicResource Theme.SpotWarmClear}" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border CornerRadius="22" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1,1,1,3" />

    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Top" Margin="22,18,16,4">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Click="Close_Click"
                  ToolTip="Close the panel (Esc)"
                  Style="{StaticResource IconButton}"
                  Content="&#xE711;" />
          <Button DockPanel.Dock="Right"
                  Command="{Binding RefreshCommand}"
                  ToolTip="Reload the pull requests from Azure DevOps"
                  Style="{StaticResource AppButton}"
                  Tag="#7CC56A"
                  Content="&#xE72C;"
                  local:AppButton.Label="Refresh" />
          <Button DockPanel.Dock="Right"
                  Click="SwitchSide_Click"
                  ToolTip="Move the panel to the other side of the window"
                  Style="{StaticResource AppButton}"
                  Tag="#7B8CDE"
                  Content="&#xE8AB;"
                  local:AppButton.Label="Switch side" />
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Pull request" FontWeight="ExtraBold" FontSize="21" Foreground="{DynamicResource Theme.TextStrong}" />
              <local:StatusDot Color="{Binding StatusColor}" IsLoading="{Binding IsLoading}" ToolTip="{Binding StatusLine}" Margin="4,-6,-6,-6" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </StackPanel>

      <!-- The scrollbar sits over the content's right margin: 4 + 12 = the 16 on the left. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
        <StackPanel Margin="16,0,12,4">
          <local:FlashCard Kind="Error"
                           Content="{Binding ErrorLine}"
                           Visibility="{Binding ErrorVisibility}"
                           Margin="0,12,0,0" />

          <StackPanel Orientation="Horizontal" Margin="2,14,0,8">
            <TextBlock Text="My PRs" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding CreatedSummary}" Style="{StaticResource SectionSummary}" />
          </StackPanel>
          <TextBlock Text="No active PRs opened by you" Visibility="{Binding CreatedEmptyVisibility}" Style="{StaticResource EmptyText}" />
          <ItemsControl x:Name="CreatedList" ItemsSource="{Binding Created}" ItemTemplate="{StaticResource GroupTemplate}" />

          <StackPanel Orientation="Horizontal" Margin="2,14,0,8">
            <TextBlock Text="To review" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding ToReviewSummary}" Style="{StaticResource SectionSummary}" />
          </StackPanel>
          <TextBlock Text="No PRs where you are a reviewer" Visibility="{Binding ToReviewEmptyVisibility}" Style="{StaticResource EmptyText}" />
          <ItemsControl x:Name="ToReviewList" ItemsSource="{Binding ToReview}" ItemTemplate="{StaticResource GroupTemplate}" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- PRs being read: the same island as the main window, top center and
         still (it does not dodge the mouse). -->
    <local:LoadingIsland Margin="0,4,0,0" Label="loading pull requests" />
  </Grid>
</UserControl>
