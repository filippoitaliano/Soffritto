<!-- Dark theme for the whole app (ThemeManager), in warm dark tones. Both theme files share the same keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <LinearGradientBrush x:Key="Theme.CardBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#F2231E1F" />
    <GradientStop Offset="1" Color="#F21C1819" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Theme.CardBackgroundAllOnDev" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#F22C211F" />
    <GradientStop Offset="0.55" Color="#F22A1F22" />
    <GradientStop Offset="1" Color="#F2271D26" />
  </LinearGradientBrush>
  <Color x:Key="Theme.BusyLight">#F2252021</Color>
  <Color x:Key="Theme.BusyWarm">#F22E2725</Color>
  <Color x:Key="Theme.Base0">#1F1B1A</Color>
  <Color x:Key="Theme.Base1">#1C1918</Color>
  <Color x:Key="Theme.Base2">#191717</Color>
  <Color x:Key="Theme.SpotMint">#2E2E4A3E</Color>
  <Color x:Key="Theme.SpotMintClear">#002E4A3E</Color>
  <Color x:Key="Theme.SpotLight">#1AFFF0D8</Color>
  <Color x:Key="Theme.SpotLightClear">#00FFF0D8</Color>
  <Color x:Key="Theme.SpotWarm">#40583848</Color>
  <Color x:Key="Theme.SpotWarmClear">#00583848</Color>
  <Color x:Key="Theme.ChromeGradient">#2B2421</Color>
  <SolidColorBrush x:Key="Theme.Text" Color="#ECE4D8" />
  <SolidColorBrush x:Key="Theme.TextStrong" Color="#F6EEE2" />
  <SolidColorBrush x:Key="Theme.TextSoft" Color="#DACDBA" />
  <SolidColorBrush x:Key="Theme.LaneText" Color="#E8E0D4" />
  <SolidColorBrush x:Key="Theme.LaneHeaderText" Color="#CDBDA6" />
  <SolidColorBrush x:Key="Theme.FieldText" Color="#EEE7DC" />
