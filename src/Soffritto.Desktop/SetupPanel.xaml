<!-- Setup panel: a large card in the middle of the window, above everything, split into tabs.
     In each tab the titles sit on the page and each card holds one subject. Every field has a
     label (FieldLabel) with an “i” button that opens its description; concepts that must always
     be read live in the light-blue notes (Note). The configuration only takes effect with Save,
     and its sections carry the “in configuration” tag; the others (preferences, seed, Docker
     disk space) are handled on their own and apply as soon as they are touched. The footer stays
     put: errors, save outcome and buttons are always visible while scrolling. The DataContext
     is a SetupViewModel. -->
<UserControl x:Class="Soffritto.Desktop.SetupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Soffritto.Desktop"
             xmlns:vm="clr-namespace:Soffritto.Desktop.ViewModels"
             xmlns:core="clr-namespace:Soffritto.Core;assembly=Soffritto.Core"
             Background="Transparent">
  <UserControl.Resources>
    <!-- A setup tab: a pill, filled when it is the open one. -->
    <Style x:Key="SetupTab" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="GroupName" Value="SetupTabs" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextStrong}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Pill" CornerRadius="13" Padding="14,5" Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Theme.Hover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Theme.CardBorder}" />
                <Setter Property="FontWeight" Value="Bold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PreferenceTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextStrong}" />
    </Style>

    <Style x:Key="PreferenceHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <Style x:Key="PreferenceRow" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,0,28,14" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextStrong}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,14" />
    </Style>

    <!-- A section of a tab: title, explanation and notes sit directly on the page. -->
    <Style x:Key="PageSection" TargetType="StackPanel">
      <Setter Property="Margin" Value="4,6,4,26" />
    </Style>

    <!-- The tag of the sections that belong to the configuration: what ends up in config.json
         and in a provisioning soffritto.json. The other sections are handled on their own. -->
    <Style x:Key="ConfigBadge" TargetType="Border">
      <Setter Property="Background" Value="#1F2F8A68" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="8,1,8,2" />
      <Setter Property="Margin" Value="10,1,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip" Value="Part of the configuration: it is what a provisioning soffritto.json contains." />
    </Style>

    <Style x:Key="ConfigBadgeText" TargetType="TextBlock">
      <Setter Property="Text" Value="in configuration" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#2F8A68" />
    </Style>

    <!-- The tag of the DevOps providers shown but not supported yet (GitHub, GitLab). -->
    <Style x:Key="PreviewBadge" TargetType="Border" BasedOn="{StaticResource ConfigBadge}">
      <Setter Property="Background" Value="#1FC27C0E" />
      <Setter Property="ToolTip" Value="Not supported yet: the fields show what will be needed, they are not saved." />
    </Style>

    <Style x:Key="PreviewBadgeText" TargetType="TextBlock" BasedOn="{StaticResource ConfigBadgeText}">
      <Setter Property="Text" Value="preview" />
      <Setter Property="Foreground" Value="#C27C0E" />
    </Style>

    <Style x:Key="ProviderTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextStrong}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ColumnHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
      <Setter Property="Margin" Value="2,0,6,3" />
    </Style>

    <!-- A group of fields of a catalog card: a row with the title (Header) and what it is for (Tag),
         which expands and collapses the fields. -->
    <Style x:Key="Group" TargetType="Expander">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border x:Name="Frame" Background="{DynamicResource Theme.SurfaceSoft}" BorderBrush="{DynamicResource Theme.SubtleBorder}" BorderThickness="1" CornerRadius="12">
              <StackPanel>
                <ToggleButton Cursor="Hand" Focusable="False"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent" Padding="12,8">
                        <DockPanel>
                          <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontWeight="Normal"
                                     FontSize="10" Opacity="0.6" VerticalAlignment="Center" Margin="0,1,9,0" />
                          <ContentPresenter />
                        </DockPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme.TextStrong}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </ToggleButton>
                <ContentPresenter x:Name="Body" Margin="14,6,2,0" Visibility="Collapsed" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Theme.Field}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The panel's text boxes, drop-downs, check boxes and radio buttons are the app's shared ones
         (App.xaml, Form* styles). -->
    <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}" />
    <Style TargetType="PasswordBox" BasedOn="{StaticResource FormPasswordBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource FormComboBox}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource FormCheckBox}" />
    <Style TargetType="RadioButton" BasedOn="{StaticResource FormRadioButton}">
      <Setter Property="Margin" Value="0,0,20,0" />
    </Style>

  </UserControl.Resources>

  <Border CornerRadius="22" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1,1,1,3" Background="{DynamicResource Theme.Panel}">
    <Border.Effect>
      <DropShadowEffect Direction="270" ShadowDepth="6" BlurRadius="28" Opacity="0.24" Color="#5C4A2A" />
    </Border.Effect>
    <DockPanel>
      <!-- Header -->
      <DockPanel DockPanel.Dock="Top" Margin="22,16,22,12">
        <Button x:Name="CloseButton"
                DockPanel.Dock="Right"
                Click="Close_Click"
                ToolTip="Close without saving (Esc)"
                Style="{StaticResource IconButton}"
                Content="&#xE711;" />
        <StackPanel>
          <TextBlock Text="Setup" FontWeight="ExtraBold" FontSize="21" Foreground="{DynamicResource Theme.TextStrong}" />
          <TextBlock x:Name="DemoHint" FontSize="12.5" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"
                     Text="In demo mode only preferences can be changed: configuration, Docker and tunnels stay locked. Press Ctrl+D or use the switch below to leave." />
          <TextBlock x:Name="ConfigurationHint" FontSize="12.5" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0">
            <Run Text="The configuration takes effect with Save: its sections have the “in configuration” tag. To distribute it, put a soffritto.json" />
            <Hyperlink Command="{Binding OpenExeFolderCommand}"><Run Text="next to the exe" /></Hyperlink><Run Text=": at startup, when it has changed, it replaces this one." />
          </TextBlock>
        </StackPanel>
      </DockPanel>

      <!-- Tabs: each one shows the sections with its Tag (SetupPanel.ShowTab). -->
      <StackPanel x:Name="Tabs" DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,0,22,12">
        <RadioButton x:Name="FirstTab" Content="Repositories" Tag="Repository" Checked="Tab_Checked" Style="{StaticResource SetupTab}" />
        <RadioButton Content="Local environments" Tag="Ambienti" Checked="Tab_Checked" Style="{StaticResource SetupTab}" />
        <RadioButton Content="Docker" Tag="Docker" Checked="Tab_Checked" Style="{StaticResource SetupTab}" />
        <RadioButton Content="Tunnels" Tag="Tunnel" Checked="Tab_Checked" Style="{StaticResource SetupTab}" />
        <RadioButton Content="DevOps" Tag="DevOps" Checked="Tab_Checked" Style="{StaticResource SetupTab}" />
        <RadioButton x:Name="ComponentsTab" Content="Components" Tag="Componenti" Checked="Tab_Checked" Style="{StaticResource SetupTab}" />
        <RadioButton x:Name="PreferencesTab" Content="Preferences" Tag="Preferenze" Checked="Tab_Checked" Style="{StaticResource SetupTab}" />
      </StackPanel>

      <!-- Fixed footer: errors, outcome, buttons -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="0,1,0,0" Padding="22,10,22,14">
        <StackPanel>
          <local:FlashCard Kind="Error" Visibility="{Binding ErrorsVisibility}" FontSize="13" Margin="0,0,0,8" MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding ErrorsText}" TextWrapping="Wrap" />
            </ScrollViewer>
          </local:FlashCard>
          <local:FlashCard Kind="Warning" Visibility="{Binding WarningsVisibility}" FontSize="13" Margin="0,0,0,8" MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding WarningsText}" TextWrapping="Wrap" />
            </ScrollViewer>
          </local:FlashCard>
          <Border Visibility="{Binding NoticeVisibility}" Background="{DynamicResource Theme.InfoBackground}" CornerRadius="10" Padding="10,6" Margin="0,0,0,8" MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource Theme.InfoText}" FontSize="13" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
          <DockPanel LastChildFill="False">
            <Button x:Name="ImportButton" DockPanel.Dock="Left" Content="Import json…" Click="Import_Click" Style="{StaticResource TextButton}" Margin="0" IsEnabled="{Binding IsIdle}"
                    ToolTip="Load the fields from a json file, for example a saved configuration. It only takes effect with Save." />
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="{Binding SaveText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="{Binding IsIdle}"
                    ToolTip="Save the configuration, clone the missing folders and reopen the app with the new environments." />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Click="Close_Click" Style="{StaticResource TextButton}" IsEnabled="{Binding IsIdle}" />
          </DockPanel>
        </StackPanel>
      </Border>

      <ScrollViewer x:Name="SectionsScroll" VerticalScrollBarVisibility="Auto" Padding="22,0,22,4">
        <StackPanel x:Name="Sections">

          <!-- Preferences: the DataContext is AppSettings.Current, which saves on every change and the
               window applies (MainWindow.ApplySettings). -->
          <StackPanel Style="{StaticResource PageSection}" Tag="Preferenze" DataContext="{x:Static local:AppSettings.Current}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Preferences" Style="{StaticResource SectionTitle}" />
            </StackPanel>
            <TextBlock Text="They only concern this app and apply right away: they are not part of the configuration and are not distributed with soffritto.json." Style="{StaticResource SectionHint}" />
            <Border Style="{StaticResource FormCard}">
              <StackPanel>
                <DockPanel Style="{StaticResource PreferenceRow}">
                  <ComboBox DockPanel.Dock="Right"
                            Width="220"
                            VerticalAlignment="Center"
                            ItemsSource="{x:Static local:AppSettings.ThemeOptions}"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Mode"
                            SelectedValue="{Binding Theme}" />
                  <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Theme" Style="{StaticResource PreferenceTitle}" />
                    <TextBlock Text="Light or dark for window, cards and panels. “System” follows Windows, “Match background” turns dark on the dark Ctrl+T scenes" Style="{StaticResource PreferenceHint}" />
                  </StackPanel>
                </DockPanel>
                <UniformGrid Columns="2">
                  <DockPanel Style="{StaticResource PreferenceRow}">
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowCat}" Style="{StaticResource Switch}" />
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Kitten" Style="{StaticResource PreferenceTitle}" />
                      <TextBlock Text="Strolls along the bottom of the window and announces new notifications · Ctrl+G" Style="{StaticResource PreferenceHint}" />
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Style="{StaticResource PreferenceRow}">
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowScenery}" Style="{StaticResource Switch}" />
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Background" Style="{StaticResource PreferenceTitle}" />
                      <TextBlock Text="Pixel-art landscape behind the cards · Ctrl+T" Style="{StaticResource PreferenceHint}" />
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Style="{StaticResource PreferenceRow}">
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsDemo}" Style="{StaticResource Switch}" />
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Demo mode" Style="{StaticResource PreferenceTitle}" />
                      <TextBlock Text="Made-up data instead of the real environments; turns off on reopening · Ctrl+D" Style="{StaticResource PreferenceHint}" />
                    </StackPanel>
                  </DockPanel>
                </UniformGrid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Backgrounds: the PixelScenery scenes Ctrl+T picks from. The selection lives in
               AppSettings.Sceneries; the last remaining scene cannot be removed. -->
          <StackPanel Style="{StaticResource PageSection}" Tag="Preferenze">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Backgrounds" Style="{StaticResource SectionTitle}" />
            </StackPanel>
            <TextBlock Text="The scenes the background picks from each time it turns on, at random and different from the previous one. Click a preview to add it to or remove it from the rotation; at least one always stays: to have no background, turn off the “Background” switch above." Style="{StaticResource SectionHint}" />
            <ItemsControl ItemsSource="{x:Static vm:SceneryChoiceViewModel.All}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SceneryChoiceViewModel}">
                  <Button Command="{Binding ToggleCommand}" ToolTip="{Binding ToolTip}" Margin="0,0,14,14" Cursor="Hand"
                          AutomationProperties.Name="{Binding Label}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Width="212" Padding="4" CornerRadius="10" BorderThickness="2"
                                BorderBrush="{DynamicResource Theme.SubtleBorder}" Background="{DynamicResource Theme.SurfaceSoft}">
                          <StackPanel>
                            <Grid>
                              <Border CornerRadius="7" ClipToBounds="True">
                                <Image x:Name="Thumb" Source="{Binding Preview}" Width="200" Height="117" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                              </Border>
                              <Border x:Name="Check" Width="22" Height="22" CornerRadius="11" Background="#2F8A68"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                            </Grid>
                            <TextBlock x:Name="Caption" Text="{Binding Label}" FontWeight="Bold" Margin="4,6,4,2"
                                       Foreground="{DynamicResource Theme.TextStrong}" />
                          </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#2F8A68" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsSelected}" Value="False">
                            <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.45" />
                            <Setter TargetName="Caption" Property="Opacity" Value="0.6" />
                          </DataTrigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Theme.Hover}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Where the clones live -->
          <StackPanel Style="{StaticResource PageSection}" Tag="Repository">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <TextBlock Text="Where the clones live" Style="{StaticResource SectionTitle}" />
              <Border Style="{StaticResource ConfigBadge}"><TextBlock Style="{StaticResource ConfigBadgeText}" /></Border>
            </StackPanel>
            <Border Style="{StaticResource FormCard}">
              <StackPanel>
                <StackPanel Style="{StaticResource FormField}" Margin="0">
                  <local:FieldLabel Text="Clones folder"
                                    Info="The folder that contains the clones of all environments: each repository lives in &lt;clones folder&gt;\&lt;repository folder&gt;. Full path, e.g. C:\Dev. An environment can have its own (Local environments tab)." />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Style="{StaticResource TextButton}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding Root, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Repository catalog: one card per repository, with its type and its groups of fields. -->
          <StackPanel Style="{StaticResource PageSection}" Tag="Repository">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Repository catalog" Style="{StaticResource SectionTitle}" />
              <Border Style="{StaticResource ConfigBadge}"><TextBlock Style="{StaticResource ConfigBadgeText}" /></Border>
            </StackPanel>
            <TextBlock Text="One card per repository, in the order they appear in the environment columns. With Save the missing folders are cloned; existing ones are left untouched." Style="{StaticResource SectionHint}" />
            <!-- The development branch convention: the value comes from GitConventions. -->
            <local:FlashCard Kind="Info" FontSize="12.5" Margin="0,0,0,14">
              <TextBlock TextWrapping="Wrap">
                <Run Text="Every repository must have the branch" /> <Run Text="{x:Static core:GitConventions.DevelopmentBranch}" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" /> <Run Text="on origin: “Reset” brings the repositories back there, and new branches of Docker environments are created from" /> <Run Text="{x:Static core:GitConventions.RemoteDevelopmentBranch}" FontFamily="Cascadia Mono, Consolas" /><Run Text="." />
              </TextBlock>
            </local:FlashCard>
            <ItemsControl ItemsSource="{Binding Repositories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource FormCard}" Padding="20,16,20,8">
                    <StackPanel>
                      <!-- Identity: type, id, where to clone from and into which folder. -->
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="150" />
                          <ColumnDefinition Width="220" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource FormField}">
                          <local:FieldLabel Text="Type"
                                            Info="Decides this card's fields and the repository's buttons and tools. The first repository of each type in the catalog is the default one: it keeps the usual console and tunnel names, and the first backend is the one VSIX and CLI work on." />
                          <ComboBox ItemsSource="{x:Static vm:SetupViewModel.TypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                    SelectedValue="{Binding Type}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Style="{StaticResource FormField}">
                          <local:FieldLabel Text="Id"
                                            Info="The repository's stable name: environments and console and tunnel names use it. Lowercase letters, digits and hyphens; it starts with a letter, at most 24 characters." />
                          <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                          <Button Content="&#xE70E;" ToolTip="Move up in the catalog" CommandParameter="{Binding}" Style="{StaticResource IconButton}" Margin="0"
                                  Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                          <Button Content="&#xE70D;" ToolTip="Move down in the catalog" CommandParameter="{Binding}" Style="{StaticResource IconButton}"
                                  Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                          <Button Content="&#xE74D;" ToolTip="Remove from the catalog (the folder on disk stays)" CommandParameter="{Binding}" Style="{StaticResource IconButton}" Margin="10,0,0,0"
                                  Command="{Binding DataContext.RemoveRepositoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                      </Grid>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="2*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource FormField}">
                          <local:FieldLabel Text="Clone URL"
                                            Info="Save clones the missing folders from here; empty = no cloning. The last segment of the URL is the name used to recognize the repository's pull requests." />
                          <TextBox Text="{Binding CloneUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Style="{StaticResource FormField}" Margin="0,0,0,14">
                          <local:FieldLabel Text="Folder" LockText="{Binding DockerLockToolTip}"
                                            Info="The name of the clone's folder inside the clones folder. Write {n} where the environment number goes: backend-{n} becomes backend-1, backend-2… Always needed when the repository is in more than one environment." />
                          <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsReadOnly="{Binding IsDockerLocked}" />
                        </StackPanel>
                      </Grid>

                      <!-- Backend fields -->
                      <Expander Style="{StaticResource Group}" Header="Backend" Tag="Kestrel startup, connection string and migrations · paths relative to the clone" IsExpanded="True" Visibility="{Binding BackendVisibility}">
                        <StackPanel>
                          <UniformGrid Columns="3">
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Solution" Info="The .sln file the card's VS button opens." />
                              <TextBox Text="{Binding Backend.Solution, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="API project folder" Info="The project folder Kestrel starts from with dotnet run." />
                              <TextBox Text="{Binding Backend.ApiProject, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Launch profile" Info="The launchSettings.json profile Kestrel starts with: dotnet run --launch-profile &lt;profile&gt;." />
                              <TextBox Text="{Binding Backend.LaunchProfile, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="API process" Info="The name of the running exe, e.g. MyApp.Web.Api.exe: it recognizes a running Kestrel even when it was started from Visual Studio." />
                              <TextBox Text="{Binding Backend.ApiProcess, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Connection string name" Info="The key under ConnectionStrings from which the environment's server and database are read. The first appsettings in the list that contains it wins: the same connection dotnet ef uses." />
                              <TextBox Text="{Binding Backend.ConnectionStringName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                            </StackPanel>
                          </UniformGrid>
                          <StackPanel Style="{StaticResource FormField}" Margin="0,0,14,14">
                            <local:FieldLabel Text="Appsettings" Hint="One per line, in reading order"
                                              Info="The files in which to look for the connection string, in order: the first one that contains it wins." />
                            <TextBox Text="{Binding AppSettingsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" AcceptsReturn="True" MinHeight="48" />
                          </StackPanel>
                          <DockPanel Margin="0,0,14,4">
                            <Button DockPanel.Dock="Right" Content="Add context" Command="{Binding AddContextCommand}" Style="{StaticResource TextButton}" />
                            <local:FieldLabel Text="Context EF Core" VerticalAlignment="Center" Margin="0"
                                              Info="The DbContexts whose migrations to track. Each one needs all four fields: name, migrations folder, project that contains them (--project) and project with the DbContext configuration (--startup-project)." />
                          </DockPanel>
                          <Grid Margin="0,2,46,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="0.8*" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="1" Text="Migrations folder" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="2" Text="Project (--project)" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="3" Text="Startup project (--startup-project)" Style="{StaticResource ColumnHeader}" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Contexts}" Margin="0,0,14,8">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                  <Button DockPanel.Dock="Right" Content="&#xE74D;" ToolTip="Remove the context"
                                          Command="{Binding DataContext.RemoveContextCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}" Style="{StaticResource IconButton}" Margin="6,0,0,0" />
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="0.8*" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Migrations, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="2" Text="{Binding Project, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="3" Text="{Binding StartupProject, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                                  </Grid>
                                </DockPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Expander>

                      <!-- Frontend fields -->
                      <Expander Style="{StaticResource Group}" Header="Frontend" Tag="commands and dev server port" IsExpanded="True" Visibility="{Binding FrontendVisibility}">
                        <UniformGrid Columns="3">
                          <StackPanel Style="{StaticResource FormField}">
                            <local:FieldLabel Text="Start command" Info="The command the card's start button runs in a console, in the clone folder." />
                            <TextBox Text="{Binding Frontend.StartCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                          </StackPanel>
                          <StackPanel Style="{StaticResource FormField}">
                            <local:FieldLabel Text="Extra command" Info="Optional. Adds a button to the card that runs this command, named after its last word (e.g. to regenerate the APIs)." />
                            <TextBox Text="{Binding Frontend.ExtraCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                          </StackPanel>
                          <StackPanel Style="{StaticResource FormField}">
                            <local:FieldLabel Text="Dev server process" Info="A text found in the command line of the dev server's node (e.g. webpack, vite): it tells it apart from the clone's other node processes, to know whether it is running." />
                            <TextBox Text="{Binding Frontend.DevServerProcessHint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                          </StackPanel>
                          <StackPanel Style="{StaticResource FormField}">
                            <local:FieldLabel Text="Env file" Info="The clone's file from which the dev server port is read, relative to the clone." />
                            <TextBox Text="{Binding Frontend.EnvFile, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                          </StackPanel>
                          <StackPanel Style="{StaticResource FormField}">
                            <local:FieldLabel Text="Port variable" Info="The name of the variable in the env file that holds the dev server port (lines “set NAME=port” or “NAME=port”)." />
                            <TextBox Text="{Binding Frontend.DevServerPortVariable, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                          </StackPanel>
                          <StackPanel Style="{StaticResource FormField}">
                            <local:FieldLabel Text="Default port" Info="The dev server port when the env file or the variable is missing." />
                            <TextBox Text="{Binding Frontend.DevServerDefaultPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                          </StackPanel>
                        </UniformGrid>
                      </Expander>

                      <!-- App fields -->
                      <Expander Style="{StaticResource Group}" Header="App" Tag="commands" IsExpanded="True" Visibility="{Binding AppVisibility}">
                        <UniformGrid Columns="3">
                          <StackPanel Style="{StaticResource FormField}">
                            <local:FieldLabel Text="Start command" Info="The command the card's start button runs in a console, in the clone folder." />
                            <TextBox Text="{Binding App.StartCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                          </StackPanel>
                          <StackPanel Style="{StaticResource FormField}">
                            <local:FieldLabel Text="Bundler command" Info="Optional. Adds the “Metro” button to the card, which runs this command in its own console." />
                            <TextBox Text="{Binding App.BundlerCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                          </StackPanel>
                        </UniformGrid>
                      </Expander>

                      <!-- Dev tunnel -->
                      <Expander Style="{StaticResource Group}" Header="Dev tunnel" Tag="share the repository outside the PC">
                        <StackPanel>
                          <DockPanel Margin="0,0,14,12">
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding TunnelEnabled}" Style="{StaticResource Switch}" Margin="0,0,12,0" />
                            <StackPanel>
                              <TextBlock Text="Shareable" Style="{StaticResource PreferenceTitle}" />
                              <TextBlock Text="“Tunnel” in its environment's header gives it a port on a pool tunnel (Tunnels tab)." Style="{StaticResource PreferenceHint}" />
                            </StackPanel>
                          </DockPanel>
                          <UniformGrid Columns="3" Visibility="{Binding TunnelVisibility}">
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Ports"
                                                Info="The ports to expose, e.g. 8443/https, 3000/http. Empty = the type's defaults: Kestrel's https port (from the appsettings) for a backend, the dev server's (from the env file) for a frontend. For a generic repository they must be written." />
                              <TextBox Text="{Binding TunnelPortsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                            </StackPanel>
                          </UniformGrid>
                        </StackPanel>
                      </Expander>

                      <!-- Docker: empty fields take the type's defaults, which the field shows. -->
                      <Expander Style="{StaticResource Group}" Header="Docker" Tag="Docker environments only · worktrees, compose and containers">
                        <StackPanel>
                          <local:FlashCard Kind="Info" FontSize="12.5" Margin="0,0,14,14">
                            <TextBlock TextWrapping="Wrap" Text="Compose, Dockerfile, service and ports show the type's default value until you change them; paths are relative to the repository root. Only the environment's default backend and frontend run in the containers." />
                          </local:FlashCard>
                          <StackPanel Style="{StaticResource FormField}">
                            <local:FieldLabel Text="Source clone" LockText="{Binding DockerLockToolTip}"
                                              Info="The bare clone the Docker environments' worktrees are created from. If it is missing, Save creates it with git init --bare and fetch. Empty = the repository is not part of Docker environments." />
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Content="Suggest" Command="{Binding ProposeSourceCloneCommand}" Style="{StaticResource TextButton}" Margin="8,0,0,0"
                                      IsEnabled="{Binding IsDockerEditable}"
                                      ToolTip="Writes &lt;worktree folder&gt;\sorgenti\&lt;repository name&gt;.git (the worktree folder is in the Docker tab)" />
                              <TextBox Text="{Binding SourceClone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsReadOnly="{Binding IsDockerLocked}" />
                            </DockPanel>
                          </StackPanel>
                          <UniformGrid Columns="4">
                            <StackPanel Style="{StaticResource FormField}" Visibility="{Binding ComposeVisibility}">
                              <local:FieldLabel Text="Compose" LockText="{Binding DockerLockToolTip}"
                                                Info="The Docker environment's compose file, with the api, web and database services. It lives in the backend repository." />
                              <TextBox Text="{Binding DockerCompose, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsReadOnly="{Binding IsDockerLocked}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Dockerfile"
                                                Info="The Dockerfile that builds the repository's image. The path must also hold relative to the build context: no absolute paths and no “..”." />
                              <TextBox Text="{Binding DockerDockerfile, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Compose service" LockText="{Binding DockerLockToolTip}"
                                                Info="The name of this repository's service in the compose file: api for the backend and web for the frontend by default." />
                              <TextBox Text="{Binding DockerService, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsReadOnly="{Binding IsDockerLocked}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Published ports" LockText="{Binding DockerLockToolTip}"
                                                Info="Format base:container port, multiple entries comma-separated. Environment N publishes port base + N on the PC: with 15000:8080 environment 11 answers on 15011." />
                              <TextBox Text="{Binding DockerPublishedPortsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsReadOnly="{Binding IsDockerLocked}" />
                            </StackPanel>
                          </UniformGrid>
                          <StackPanel Style="{StaticResource FormField}">
                            <local:FieldLabel Text="Fallback Docker files"
                                              Info="Folder of a checkout that has the Docker files: the ones the branch lacks are copied from here into the worktree. The copies in the worktree are rewritten at every start and disappear with Destroy: edit the files here or in the repository." />
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseFallback_Click" Style="{StaticResource TextButton}" Margin="8,0,0,0" />
                              <TextBox Text="{Binding DockerFilesFallback, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                            </DockPanel>
                          </StackPanel>
                          <UniformGrid Columns="2">
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Local files from the model environment" Hint="One per line, relative to the root"
                                                Info="Files copied byte for byte from the same repository of the model environment into the worktree, when the environment is created and with “Repair env”. Don't put the env file or the secrets file here: the Env group writes them." />
                              <TextBox Text="{Binding DockerLocalFilesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" AcceptsReturn="True" MinHeight="48" />
                            </StackPanel>
                          </UniformGrid>
                        </StackPanel>
                      </Expander>

                      <!-- Env: constants from the model, secrets from their source, per-slot values. -->
                      <Expander Style="{StaticResource Group}" Header="Env" Tag="Docker environments only · the repository's environment variables">
                        <StackPanel>
                          <local:FlashCard Kind="Info" FontSize="12.5" Margin="0,0,14,14">
                            <TextBlock TextWrapping="Wrap" Text="A Docker environment receives three kinds of variables: constants, copied from the model environment; secrets, read from their file; per-environment values, computed below. The worktree receives them in the env file (on creation and with “Repair env”), the container at every start." />
                          </local:FlashCard>
                          <StackPanel Orientation="Horizontal" Margin="0,0,14,14">
                            <Button Content="Suggested values" Command="{Binding ProposeEnvCommand}" Style="{StaticResource TextButton}" Margin="0"
                                    ToolTip="Replace the whole Env group with the typical values for the repository type: a good starting point to fine-tune." />
                            <Button Content="Preview" Command="{Binding PreviewEnvCommand}" Style="{StaticResource TextButton}" Margin="8,0,0,0"
                                    ToolTip="Show below the variables a test Docker environment would receive: names and origins, never the values." />
                          </StackPanel>
                          <UniformGrid Columns="3">
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Env file format"
                                                Info="How the env file is read and written: .bat (lines set NAME=value), dotenv (NAME=value), appsettings (A:B keys of a json), manual (no file: only the variables written here). “(none)” = Soffritto does not manage this repository's env." />
                              <ComboBox ItemsSource="{x:Static vm:RepositoryCardEditor.EnvAdapterOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                        SelectedValue="{Binding EnvAdapterKey}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Env file" Info="The file written into the worktree, relative to the repository root." />
                              <TextBox Text="{Binding EnvTarget, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsEnabled="{Binding EnvEnabled}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Constants source" Info="The model environment's file the constants are copied from, relative to the root. Empty = the same path as the env file." />
                              <TextBox Text="{Binding EnvConstantsSource, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsEnabled="{Binding EnvEnabled}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Secrets format" Info="The format of the shared secrets file; “(none)” = the repository has no secrets. Secret values never go through the setup." />
                              <ComboBox ItemsSource="{x:Static vm:RepositoryCardEditor.SecretsAdapterOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                        SelectedValue="{Binding SecretsAdapterKey}" IsEnabled="{Binding EnvEnabled}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Secrets file" Info="Relative to the repository root in the model environment, or a full path." />
                              <TextBox Text="{Binding SecretsSource, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsEnabled="{Binding EnvEnabled}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Excluded from the container" Info="Name prefixes, comma-separated: constants starting with them don't go to the container. A backend needs Kestrel: otherwise the model environment's Kestrel endpoints win over the Dockerfile's port." />
                              <TextBox Text="{Binding EnvContainerExcludeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsEnabled="{Binding EnvEnabled}" />
                            </StackPanel>
                          </UniformGrid>

                          <DockPanel Margin="0,0,14,4">
                            <Button DockPanel.Dock="Right" Content="Add value" Command="{Binding AddSlotCommand}" Style="{StaticResource TextButton}" IsEnabled="{Binding EnvEnabled}" />
                            <local:FieldLabel Text="Per-environment values" VerticalAlignment="Center" Margin="0"
                                              Info="Variables that change from one environment to another. If “In the container” is empty the variable does not go to the container.&#x0a;&#x0a;Placeholders allowed in values:&#x0a;{n} · environment number&#x0a;{hostPort}, {containerPort} · the repository's published port&#x0a;{apiHostUrl}, {apiContainerUrl} · api address&#x0a;{hostConnection}, {containerConnection} · database connection string&#x0a;{poolUrl} · address of this repository's pool port&#x0a;{poolUrl:&lt;id&gt;} · that of another repository" />
                          </DockPanel>
                          <Grid Margin="0,2,46,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="1" Text="In the worktree" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="2" Text="In the container" Style="{StaticResource ColumnHeader}" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding EnvSlotRows}" Margin="0,0,14,10">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <DockPanel Margin="0,0,0,6" ToolTip="{Binding LockToolTip}" ToolTipService.ShowOnDisabled="True">
                                  <Button DockPanel.Dock="Right" Content="&#xE74D;" ToolTip="Remove the value" CommandParameter="{Binding}" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                          IsEnabled="{Binding IsEditable}"
                                          Command="{Binding DataContext.RemoveSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" Margin="0,0,6,0" IsReadOnly="{Binding IsLocked}" />
                                    <TextBox Grid.Column="1" Text="{Binding Local, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" Margin="0,0,6,0" IsReadOnly="{Binding IsLocked}" />
                                    <TextBox Grid.Column="2" Text="{Binding Container, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsReadOnly="{Binding IsLocked}" />
                                  </Grid>
                                </DockPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <DockPanel Margin="0,0,14,4">
                            <Button DockPanel.Dock="Right" Content="Add variable" Command="{Binding AddManualCommand}" Style="{StaticResource TextButton}" IsEnabled="{Binding EnvEnabled}" />
                            <local:FieldLabel Text="Manual variables" VerticalAlignment="Center" Margin="0"
                                              Info="Constants written here by hand, the same for all Docker environments. They end up in plain text in the configuration: don't put secrets here." />
                          </DockPanel>
                          <Grid Margin="0,2,46,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="1" Text="Value" Style="{StaticResource ColumnHeader}" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding EnvManualRows}" Margin="0,0,14,8">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                  <Button DockPanel.Dock="Right" Content="&#xE74D;" ToolTip="Remove the variable" CommandParameter="{Binding}" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                          Command="{Binding DataContext.RemoveManualCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                                  </Grid>
                                </DockPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="{Binding EnvPreviewText}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,14,8" Opacity="0.85" />
                        </StackPanel>
                      </Expander>

                      <!-- Database seed: the backup Docker environments start from. -->
                      <Expander Style="{StaticResource Group}" Header="Database seed" Tag="Docker environments only · the backup their database starts from" Visibility="{Binding BackendVisibility}">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="160" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Type" Info="The seed's database: it decides how it is restored and saved." />
                              <ComboBox ItemsSource="{x:Static vm:RepositoryCardEditor.SeedKindOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                        SelectedValue="{Binding SeedKind}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Seed file"
                                                Info="A .bak, or a .7z containing a single .bak; full path. “Align seed” (Docker tab) writes a new file next to this one and puts its path here: to go back, restore the previous path." />
                              <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseSeed_Click" Style="{StaticResource TextButton}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding SeedPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                              </DockPanel>
                            </StackPanel>
                          </Grid>
                          <UniformGrid Columns="3">
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="SQL Server image" Info="The SQL Server Docker image for the environments' databases and for the seed's temporary container." />
                              <TextBox Text="{Binding SeedImage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Database" LockText="{Binding DockerLockToolTip}" Info="The database name inside the seed and in the Docker environments." />
                              <TextBox Text="{Binding SeedDatabaseName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsReadOnly="{Binding IsDockerLocked}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Database service" LockText="{Binding DockerLockToolTip}" Info="The name of the database service in the backend's compose file." />
                              <TextBox Text="{Binding SeedService, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsReadOnly="{Binding IsDockerLocked}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="SQL Server password" LockText="{Binding DockerLockToolTip}" Info="The SQL Server password in the containers. It is not a secret: it only protects containers reachable from 127.0.0.1, holding development data." />
                              <TextBox Text="{Binding SeedPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsReadOnly="{Binding IsDockerLocked}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FormField}">
                              <local:FieldLabel Text="Memory (MB)" Info="SQL Server's memory cap in each container (MSSQL_MEMORY_LIMIT_MB). At least 512." />
                              <TextBox Text="{Binding SeedMemoryText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                            </StackPanel>
                          </UniformGrid>
                          <DockPanel Margin="0,0,14,12">
                            <Button DockPanel.Dock="Left" Content="Verify seed" Command="{Binding VerifySeedCommand}" IsEnabled="{Binding CanVerifySeed}" Style="{StaticResource TextButton}" Margin="0" VerticalAlignment="Top"
                                    ToolTip="Restore the seed in a temporary SQL Server and compare it with the migrations of the development branch (or of the model environment's backend). Works on the fields shown, even unsaved." />
                            <TextBlock Text="{Binding SeedVerifyText}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap" />
                          </DockPanel>
                        </StackPanel>
                      </Expander>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add repository" Command="{Binding AddRepositoryCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="0"
                    ToolTip="Add a generic repository at the end, not included in any environment: pick type, id and folder, then tick it in the Local environments tab." />
          </StackPanel>

          <!-- Local environments: which repositories each one includes. Docker environments are not listed. -->
          <StackPanel Style="{StaticResource PageSection}" Tag="Ambienti">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Local environments" Style="{StaticResource SectionTitle}" />
              <Border Style="{StaticResource ConfigBadge}"><TextBlock Style="{StaticResource ConfigBadgeText}" /></Border>
            </StackPanel>
            <TextBlock Text="Each environment is a column of the app, with the repositories ticked here." Style="{StaticResource SectionHint}" />
            <local:FlashCard Kind="Info" FontSize="12.5" Margin="0,0,0,14">
              <TextBlock TextWrapping="Wrap" Text="A local environment is made of clones on the PC, with services started in consoles: these are the non-Docker environments, and they are added and removed here. Docker environments are not in this list: they are created from the “+” next to the environment numbers in the header, and removed with “Destroy environment” in their column." />
            </local:FlashCard>
            <Border Style="{StaticResource FormCard}">
              <StackPanel>
                <Grid Margin="0,0,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="32" />
                  </Grid.ColumnDefinitions>
                  <local:FieldLabel Text="Number" Info="From 1 to 99, no duplicates: not even with the Docker environment numbers. It replaces {n} in the repository folder names." />
                  <local:FieldLabel Grid.Column="1" Text="Included repositories" Info="The catalog repositories the environment contains: one card each in its column. At least one is required." />
                  <local:FieldLabel Grid.Column="2" Text="Own folder" Info="Optional: the folder holding this environment's repositories, as a full path. Empty = the clones folder from the Repositories tab. Changing it does not move existing clones." />
                  <local:FieldLabel Grid.Column="3" Text="Protected DB" Info="The backend's database is protected, for example because others use it too: migrations are read but not applied, neither from the app nor from the VSIX, and the MCP server declares it. Everything else in the environment works as usual." />
                </Grid>
                <ItemsControl ItemsSource="{Binding EnvironmentsList}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="72" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="250" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Width="48" HorizontalAlignment="Left" TextAlignment="Center" FontWeight="Bold" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Inclusions}" VerticalAlignment="Center">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <CheckBox Content="{Binding Repository.Id}" IsChecked="{Binding IsIncluded}" Margin="0,2,16,2" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Grid.Column="2" Text="{Binding Root, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                        <CheckBox Grid.Column="3" IsChecked="{Binding ProtectedDatabase}" Style="{StaticResource Switch}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  ToolTip="Protected database: migrations are read but not applied and the schema is not altered" />
                        <Button Grid.Column="4" Content="&#xE74D;" ToolTip="Remove the environment (the folders on disk stay)" CommandParameter="{Binding}" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                Command="{Binding DataContext.RemoveEnvironmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Add environment" Command="{Binding AddEnvironmentCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                        ToolTip="Add a local environment with the same repositories as the last one." />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Docker environments: shared settings; while Docker environments exist, folder and ports
               stay locked. -->
          <StackPanel Style="{StaticResource PageSection}" Tag="Docker">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <TextBlock Text="Docker environments" Style="{StaticResource SectionTitle}" />
              <Border Style="{StaticResource ConfigBadge}"><TextBlock Style="{StaticResource ConfigBadgeText}" /></Border>
            </StackPanel>
            <local:FlashCard Kind="Info" FontSize="12.5" Margin="0,0,0,14">
              <TextBlock TextWrapping="Wrap" Text="A Docker environment is disposable: it is created from the “+” next to the environment numbers in the header. Each repository is a worktree created from its source clone; api, web and database run in containers; variables and local files come from the model environment. Shared settings are here: the rest lives in the Docker, Env and Seed groups of each card in the Repositories tab." />
            </local:FlashCard>
            <Border Style="{StaticResource FormCard}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource FormField}" Margin="0,0,14,0">
                    <local:FieldLabel Text="Worktree folder" LockText="{Binding DockerGlobalToolTip}"
                                      Info="Contains the Docker environments' worktrees and the source clones (sorgenti\&lt;repository&gt;.git). Full path." />
                    <TextBox Text="{Binding Draft.Docker.WorktreeRoot, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsReadOnly="{Binding HasDockerEnvironments}" />
                    <TextBlock Text="{Binding WorktreeRootHint}" Style="{StaticResource PreferenceHint}" Margin="2,3,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Style="{StaticResource FormField}" Margin="0,0,14,0">
                    <local:FieldLabel Text="Database port base" LockText="{Binding DockerGlobalToolTip}"
                                      Info="Environment N's database answers on the PC at port base + N; the seed's temporary container uses the base." />
                    <TextBox Text="{Binding Draft.Docker.DatabasePortBase, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" IsReadOnly="{Binding HasDockerEnvironments}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Style="{StaticResource FormField}" Margin="0">
                    <local:FieldLabel Text="Model environment"
                                      Info="The number of the local environment from which Docker environments read constants, secrets and local files. Empty = the first local environment." />
                    <TextBox Text="{Binding TemplateEnvironmentText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Seed: status of the configured seed and “Align seed”, which takes effect right away without
               Save (DockerPanelViewModel). The new path also goes into the open draft. -->
          <StackPanel Style="{StaticResource PageSection}" Tag="Docker" DataContext="{Binding Pool}">
            <DockPanel>
              <Button DockPanel.Dock="Right"
                      Command="{Binding RefreshCommand}"
                      ToolTip="Reload the seed (with git fetch of the source clone) and the Docker disk space"
                      Style="{StaticResource IconButton}"
                      Content="&#xE72C;" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Database seed" Style="{StaticResource SectionTitle}" />
              </StackPanel>
            </DockPanel>
            <TextBlock Text="The backup every Docker environment's database starts from. It is configured in the “Database seed” group of the backend card (Repositories tab). “Align seed” acts right away, without Save." Style="{StaticResource SectionHint}" />
            <Border Style="{StaticResource FormCard}">
              <StackPanel>
                <TextBlock Text="{Binding SeedText}" TextWrapping="Wrap" FontSize="13" />
                <TextBlock Text="{Binding MissingText}" TextWrapping="Wrap" FontSize="13" Opacity="0.75" Margin="0,4,0,0" />
                <Button HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Command="{Binding AlignCommand}"
                        IsEnabled="{Binding IsIdle}"
                        ToolTip="Restore the seed in a temporary SQL Server, apply the development branch migrations, compact it and save a new file next to the configured seed."
                        Style="{StaticResource TextButton}"
                        Content="Align seed" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Docker disk space: the preference applies and saves right away like the others, the
               buttons act right away (DockerPanelViewModel). -->
          <StackPanel Style="{StaticResource PageSection}" Tag="Docker">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Text="Docker disk space" Style="{StaticResource SectionTitle}" />
            </StackPanel>
            <Border Style="{StaticResource FormCard}">
              <StackPanel>
                <StackPanel DataContext="{Binding Pool}">
                  <TextBlock Text="{Binding DiskText}" TextWrapping="Wrap" FontSize="13" />
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,14">
                    <Button Command="{Binding CleanCommand}"
                            IsEnabled="{Binding IsIdle}"
                            ToolTip="Remove the images of Docker environments that no longer exist and shrink the build cache to 10 GB. Stops nothing."
                            Style="{StaticResource TextButton}"
                            Margin="0"
                            Content="Clean up now" />
                    <Button Command="{Binding CompactCommand}"
                            IsEnabled="{Binding IsIdle}"
                            Margin="8,0,0,0"
                            ToolTip="Give the space freed inside Docker back to the PC: closes Docker Desktop and WSL, compacts docker_data.vhdx with administrator rights and starts Docker Desktop again."
                            Style="{StaticResource TextButton}"
                            Content="Compact disk" />
                  </StackPanel>
                </StackPanel>
                <DockPanel DataContext="{x:Static local:AppSettings.Current}">
                  <CheckBox DockPanel.Dock="Left" IsChecked="{Binding DockerCleanupOnExit}" Style="{StaticResource Switch}" Margin="0,0,12,0" />
                  <StackPanel>
                    <TextBlock Text="Clean up when the app closes" Style="{StaticResource PreferenceTitle}" />
                    <TextBlock Text="The same cleanup as “Clean up now”; skipped if a build or an action is in progress." Style="{StaticResource PreferenceHint}" />
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Log of global Docker operations: seed, disk space, tunnel pool, creation and destruction
               outcomes. An environment's details live in its card. -->
          <StackPanel Style="{StaticResource PageSection}" Tag="Docker" DataContext="{Binding Pool}">
            <TextBlock Text="Log" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Seed, Docker disk space, tunnel pool and one line for each environment created or destroyed. An environment's details are under “Operations” in its card." Style="{StaticResource SectionHint}" />
            <TextBox Text="{Binding Log, Mode=OneWay}"
                     local:LogAutoScroll.IsEnabled="True"
                     Style="{StaticResource LogBox}"
                     MinHeight="80" />
          </StackPanel>

          <!-- Tunnels: the pool and its actions, which take effect right away without Save (DockerPanelViewModel). -->
          <StackPanel Style="{StaticResource PageSection}" Tag="Tunnel" DataContext="{Binding Pool}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Tunnel pool" Style="{StaticResource SectionTitle}" />
              <Border Style="{StaticResource ConfigBadge}"><TextBlock Style="{StaticResource ConfigBadgeText}" /></Border>
            </StackPanel>
            <TextBlock Text="The dev tunnels used to share environments outside the PC." Style="{StaticResource SectionHint}" />
            <local:FlashCard Kind="Info" FontSize="12.5" Margin="0,0,0,14">
              <TextBlock TextWrapping="Wrap" Text="The pool is created here, and the buttons act right away, without Save; ports are assigned from the environments. “Tunnel” in an environment's header claims a free tunnel and gives a port, with anonymous access, to each of its repositories with the “Dev tunnel” group turned on (Repositories tab). A tunnel serves a single environment and carries at most 9 ports." />
            </local:FlashCard>
            <TextBlock Text="{Binding PoolText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Theme.TextStrong}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding PoolTunnels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource FormCard}" Padding="16,10" Margin="0,0,0,8">
                    <StackPanel>
                      <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding DeleteCommand}"
                                IsEnabled="{Binding CanDelete}"
                                ToolTip="{Binding DeleteToolTip}"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource TextButton}"
                                Margin="6,0,0,0"
                                Content="Delete" />
                        <local:StatusDot DockPanel.Dock="Left" Color="{Binding HostColor}" ToolTip="{Binding HostText}" VerticalAlignment="Center" Margin="-6" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Margin="8,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding HostText}" />
                      </DockPanel>
                      <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0" />
                      <!-- Only the ports left to an environment that no longer exists: the others are released
                           by turning off “Tunnel” in the environment's header. -->
                      <ItemsControl ItemsSource="{Binding Assignments}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <DockPanel Margin="0,3,0,0">
                              <Button DockPanel.Dock="Right"
                                      Command="{Binding ReleaseCommand}"
                                      IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      ToolTip="{Binding ReleaseToolTip}"
                                      Style="{StaticResource TextButton}"
                                      Content="Release" />
                              <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{Binding Text}" FontSize="12" />
                                <TextBlock Text="{Binding Url}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
                              </StackPanel>
                            </DockPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Button Content="Add tunnel" Command="{Binding AddTunnelCommand}" IsEnabled="{Binding IsIdle}" Style="{StaticResource TextButton}" Margin="0,0,8,0"
                      ToolTip="Create one more tunnel, private (Owner only) and without ports, on the first free pool-K name. Fails if the devtunnel account allows no more tunnels." />
              <Button Content="Create all possible tunnels" Command="{Binding FillPoolCommand}" IsEnabled="{Binding IsIdle}" Style="{StaticResource TextButton}" Margin="0"
                      ToolTip="Create pool-K tunnels as long as the devtunnel account allows: the pool grows as large as the quota." />
            </StackPanel>
            <TextBlock Text="{Binding PoolNotice}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>

          <!-- Components: external programs, MCP server, VSIX and updates (ComponentsViewModel).
               They act right away and don't touch config.json. -->
          <StackPanel Style="{StaticResource PageSection}" Tag="Componenti" DataContext="{Binding Components}">
            <DockPanel>
              <Button DockPanel.Dock="Right"
                      Command="{Binding RefreshCommand}"
                      ToolTip="Check again what is installed"
                      Style="{StaticResource IconButton}"
                      Content="&#xE72C;" />
              <TextBlock Text="External programs" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <TextBlock Text="The app uses them but does not install them by itself. “Install” opens a console with winget, where you choose and confirm; once installed, press “Check again” above." Style="{StaticResource SectionHint}" />
            <local:FlashCard Kind="Warning" Content="{Binding WingetStatus}" FontSize="13" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Prerequisites}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource FormCard}" Padding="16,10" Margin="0,0,0,8">
                    <DockPanel>
                      <Button DockPanel.Dock="Right"
                              Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding CanInstall}"
                              ToolTip="{Binding InstallCommandText}"
                              ToolTipService.ShowOnDisabled="True"
                              Style="{StaticResource TextButton}"
                              VerticalAlignment="Center"
                              Content="Install" />
                      <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource PreferenceTitle}" />
                        <TextBlock Text="{Binding Purpose}" Style="{StaticResource PreferenceHint}" />
                        <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,2,0,0" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button HorizontalAlignment="Left"
                    Command="{Binding DevTunnelLoginCommand}"
                    ToolTip="Open a console with “devtunnel user login”: the tunnel pool uses the account you sign in with."
                    Style="{StaticResource TextButton}"
                    Margin="0,2,0,0"
                    Content="Sign in to dev tunnels" />
          </StackPanel>

          <StackPanel Style="{StaticResource PageSection}" Tag="Componenti" DataContext="{Binding Components}">
            <TextBlock Text="Server MCP" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="The same environments as tools for an MCP client, for example Claude Code." Style="{StaticResource SectionHint}" />
            <Border Style="{StaticResource FormCard}">
              <StackPanel>
                <TextBlock Text="{Binding McpStatus}" TextWrapping="Wrap" FontSize="13" />
                <DockPanel Margin="0,8,0,0">
                  <Button DockPanel.Dock="Right"
                          Command="{Binding CopyMcpPathCommand}"
                          ToolTip="Copy the path of the server exe"
                          Style="{StaticResource IconButton}"
                          Content="&#xE8C8;" />
                  <TextBlock Text="{Binding McpPath}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" ToolTip="{Binding McpPath}" VerticalAlignment="Center" />
                </DockPanel>
                <Button HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Command="{Binding RegisterMcpCommand}"
                        IsEnabled="{Binding CanRegisterMcp}"
                        ToolTip="Open a console with “claude mcp add --scope user soffritto”; a server with the same name is removed first."
                        Style="{StaticResource TextButton}"
                        Content="Register in Claude Code" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Style="{StaticResource PageSection}" Tag="Componenti" DataContext="{Binding Components}">
            <TextBlock Text="Visual Studio extension" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="The status of the open clone in a Visual Studio panel." Style="{StaticResource SectionHint}" />
            <Border Style="{StaticResource FormCard}">
              <StackPanel>
                <TextBlock Text="{Binding VsixStatus}" TextWrapping="Wrap" FontSize="13" />
                <Button HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Command="{Binding InstallVsixCommand}"
                        IsEnabled="{Binding CanInstallVsix}"
                        ToolTip="Open the Visual Studio extension installer with the package that came with Setup.exe."
                        Style="{StaticResource TextButton}"
                        Content="Install in Visual Studio" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Style="{StaticResource PageSection}" Tag="Componenti" DataContext="{Binding Components}">
            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="The app installed with Setup.exe looks for a new release at every startup, downloads it and installs it when you close the app. Configuration and notes stay where they are." Style="{StaticResource SectionHint}" />
            <Border Style="{StaticResource FormCard}">
              <StackPanel>
                <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" FontSize="13" />
                <Button HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Command="{Binding CheckUpdatesCommand}"
                        IsEnabled="{Binding CanCheckUpdates}"
                        Style="{StaticResource TextButton}"
                        Content="Check now" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- DevOps: only Azure DevOps works today; GitHub and GitLab are mock cards, disabled,
               with no bindings and nothing in config.json, to show where they will go. -->
          <StackPanel Style="{StaticResource PageSection}" Tag="DevOps">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="DevOps" Style="{StaticResource SectionTitle}" />
              <Border Style="{StaticResource ConfigBadge}"><TextBlock Style="{StaticResource ConfigBadgeText}" /></Border>
            </StackPanel>
            <TextBlock Text="The service that hosts repositories, pull requests and work items: it feeds the pull requests panel. Leave the URL empty to not use it." Style="{StaticResource SectionHint}" />
            <local:FieldLabel Text="Provider" Info="For now only Azure DevOps can be connected. GitHub and GitLab are in preview: their cards show what will be needed, but they cannot be chosen yet." />
            <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
              <RadioButton GroupName="DevOpsProvider" Content="Azure DevOps" IsChecked="True" />
              <StackPanel Orientation="Horizontal" IsEnabled="False" Margin="18,0,0,0">
                <RadioButton GroupName="DevOpsProvider" Content="GitHub" VerticalAlignment="Center" />
                <Border Style="{StaticResource PreviewBadge}" Margin="6,0,0,0"><TextBlock Style="{StaticResource PreviewBadgeText}" /></Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" IsEnabled="False" Margin="18,0,0,0">
                <RadioButton GroupName="DevOpsProvider" Content="GitLab" VerticalAlignment="Center" />
                <Border Style="{StaticResource PreviewBadge}" Margin="6,0,0,0"><TextBlock Style="{StaticResource PreviewBadgeText}" /></Border>
              </StackPanel>
            </StackPanel>
            <Border Style="{StaticResource FormCard}">
              <StackPanel>
                <TextBlock Text="Azure DevOps" Style="{StaticResource ProviderTitle}" Margin="0,0,0,10" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource FormField}">
                    <local:FieldLabel Text="Collection URL" Info="The URL of the collection or organization, e.g. https://server/tfs/Collection or https://dev.azure.com/org." />
                    <TextBox Text="{Binding Draft.AzureDevOps.CollectionUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormMono}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Style="{StaticResource FormField}" Margin="0,0,0,14">
                    <local:FieldLabel Text="Project" Info="The Azure DevOps project name. Always required when the URL is filled in." />
                    <TextBox Text="{Binding Draft.AzureDevOps.Project, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
                <local:FieldLabel Text="Authentication" Info="Windows user: the user running the app is used, with no secrets to keep. PAT: a personal access token, which Save encrypts with your Windows user; only you can read it, on this PC." />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                  <RadioButton GroupName="Auth" Content="My Windows user" IsChecked="{Binding UsesWindows}" />
                  <RadioButton GroupName="Auth" Content="Personal access token (PAT)" IsChecked="{Binding UsesPat}" />
                </StackPanel>
                <StackPanel Visibility="{Binding PatVisibility}" Margin="0,0,0,12">
                  <PasswordBox x:Name="PatBox" PasswordChanged="Pat_Changed" MaxWidth="460" HorizontalAlignment="Left" Width="460" />
                  <TextBlock Text="{Binding PatHint}" FontSize="12" Opacity="0.65" Margin="2,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Test connection" Command="{Binding TestAzureCommand}" Style="{StaticResource TextButton}" Margin="0"
                          ToolTip="Test the URL, project and authentication entered here, even unsaved." />
                  <TextBlock Text="{Binding AzureStatus}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13" TextWrapping="Wrap" MaxWidth="560" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource FormCard}" Opacity="0.6">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <TextBlock Text="GitHub" Style="{StaticResource ProviderTitle}" />
                  <Border Style="{StaticResource PreviewBadge}"><TextBlock Style="{StaticResource PreviewBadgeText}" /></Border>
                </StackPanel>
                <Grid IsEnabled="False">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource FormField}">
                    <local:FieldLabel Text="Organization or user" Info="The owner of the repositories on github.com or on GitHub Enterprise." />
                    <TextBox Text="e.g. my-org" Style="{StaticResource FormMono}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Style="{StaticResource FormField}" Margin="0,0,0,14">
                    <local:FieldLabel Text="Authentication" Info="A fine-grained personal access token, encrypted with your Windows user like the Azure DevOps PAT." />
                    <TextBox Text="fine-grained token" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource FormCard}" Opacity="0.6">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <TextBlock Text="GitLab" Style="{StaticResource ProviderTitle}" />
                  <Border Style="{StaticResource PreviewBadge}"><TextBlock Style="{StaticResource PreviewBadgeText}" /></Border>
                </StackPanel>
                <Grid IsEnabled="False">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource FormField}">
                    <local:FieldLabel Text="Instance URL" Info="https://gitlab.com or the address of a self-managed GitLab." />
                    <TextBox Text="e.g. https://gitlab.com" Style="{StaticResource FormMono}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Style="{StaticResource FormField}" Margin="0,0,0,14">
                    <local:FieldLabel Text="Group" Info="The group that contains the repositories' projects." />
                    <TextBox Text="e.g. my-group" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
