<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows version is needed by the WebView2CompositionControl of the Pomodoro panel:
         its WPF assembly uses the WinRT projections (Windows.Graphics.Capture), which only come
         with a target that declares the Windows version. -->
    <TargetFramework>net11.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon: Windows notifications start from the tray icon balloon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Soffritto.Desktop</RootNamespace>
    <AssemblyName>Soffritto</AssemblyName>
    <!-- The product icon: 16, 32, 48 and 256 px. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- The Debug build can run next to the published one: lava and rock instead of grass and
         violet tell it apart in the taskbar, the window and the tray. -->
    <ApplicationIcon Condition="'$(Configuration)' == 'Debug'">app-debug.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NETSDK1057</NoWarn>

    <!-- On a machine that only has a runtime newer than 11 the exe does not start without roll
         forward. A prerelease is not picked without DOTNET_ROLL_FORWARD_TO_PRERELEASE. -->
    <RollForward>LatestMajor</RollForward>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- The native SNI of SqlClient goes inside the exe and is extracted at startup: without
         this, the single file would still ship alongside its native DLL. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Program.Main serves Velopack before WPF starts (Infrastructure/Installation.cs). -->
    <StartupObject>Soffritto.Desktop.Program</StartupObject>
  </PropertyGroup>

  <!-- The release the installation updates from: release.ps1 passes it, so there is no address
       in the code. Development builds don't have it and don't update. -->
  <ItemGroup Condition="'$(UpdateRepository)' != ''">
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The implicit WinForms usings make WPF's Application, Image and KeyEventArgs ambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Soffritto.Core\Soffritto.Core.csproj" />
    <ProjectReference Include="..\Soffritto.Presentation\Soffritto.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- VS Code Codicons (@vscode/codicons 0.0.45, CC BY 4.0, license next to the font): git
         icons matching Visual Studio's, which Segoe Fluent Icons lacks. -->
    <Resource Include="Fonts\codicon.ttf" />
    <!-- Nunito (SIL OFL 1.1, license next to the fonts), the rounded typeface of the playful style:
         four static weights from Google Fonts, because WPF uses only one weight of the variable
         font and fakes the bold. -->
    <Resource Include="Fonts\Nunito-*.ttf" />
  </ItemGroup>

</Project>
