<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- La versione di Windows serve alla WebView2CompositionControl del pannello del
         pomodoro: il suo assembly WPF usa le proiezioni WinRT (Windows.Graphics.Capture), che
         arrivano solo con un target che dichiara la versione di Windows. -->
    <TargetFramework>net11.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Solo per NotifyIcon: le notifiche Windows partono dal fumetto dell'icona di sistema. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Soffritto.Desktop</RootNamespace>
    <AssemblyName>Soffritto</AssemblyName>
    <!-- L'icona del prodotto: 16, 32, 48 e 256 px. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- La build Debug puo' girare accanto a quella pubblicata: lava e roccia al posto di erba e
         violetto la distinguono in barra delle applicazioni, finestra e tray. -->
    <ApplicationIcon Condition="'$(Configuration)' == 'Debug'">app-debug.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NETSDK1057</NoWarn>

    <!-- Su una macchina che ha solo un runtime piu' recente dell'11 l'exe non parte senza roll
         forward. La prerelease non viene scelta senza DOTNET_ROLL_FORWARD_TO_PRERELEASE. -->
    <RollForward>LatestMajor</RollForward>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- La SNI nativa di SqlClient finisce dentro l'exe e viene estratta all'avvio: senza,
         il file singolo resterebbe accompagnato dalla sua DLL nativa. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Program.Main serve Velopack prima che parta WPF (Infrastructure/Installation.cs). -->
    <StartupObject>Soffritto.Desktop.Program</StartupObject>
  </PropertyGroup>

  <!-- La release da cui l'installazione si aggiorna: la passa release.ps1, cosi' nel codice non
       c'e' nessun indirizzo. Le build di sviluppo non ce l'hanno e non si aggiornano. -->
  <ItemGroup Condition="'$(UpdateRepository)' != ''">
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gli using impliciti di WinForms rendono ambigui Application, Image, KeyEventArgs di WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Soffritto.Core\Soffritto.Core.csproj" />
    <ProjectReference Include="..\Soffritto.Presentation\Soffritto.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- Codicons di VS Code (@vscode/codicons 0.0.45, CC BY 4.0, licenza accanto al font): le
         icone git uguali a quelle di Visual Studio, che Segoe Fluent Icons non ha. -->
    <Resource Include="Fonts\codicon.ttf" />
    <!-- Nunito (SIL OFL 1.1, licenza accanto ai font), il carattere tondo dello stile giocoso:
         quattro pesi statici da Google Fonts, perche' del font variabile WPF usa un peso solo e
         il grassetto lo simula. -->
    <Resource Include="Fonts\Nunito-*.ttf" />
  </ItemGroup>

</Project>
