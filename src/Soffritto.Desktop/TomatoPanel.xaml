<!-- Pannello del pomodoro: la stessa card galleggiante dei pannelli PR e notifiche, con dentro il
     tomato timer del giardino (garden.filippoitaliano.com) in una cornice arrotondata. -->
<UserControl x:Class="Soffritto.Desktop.TomatoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Soffritto.Desktop">
  <Grid>
    <Border CornerRadius="22">
      <Border.Effect>
        <DropShadowEffect Direction="270" ShadowDepth="6" BlurRadius="28" Opacity="0.24" Color="#5C4A2A" />
      </Border.Effect>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0" Color="{DynamicResource Theme.Base0}" />
          <GradientStop Offset="0.5" Color="{DynamicResource Theme.Base1}" />
          <GradientStop Offset="1" Color="{DynamicResource Theme.Base2}" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border CornerRadius="22">
      <Border.Background>
        <RadialGradientBrush Center="0.15,0.08" GradientOrigin="0.15,0.08" RadiusX="0.25" RadiusY="0.4">
          <GradientStop Offset="0" Color="{DynamicResource Theme.SpotMint}" />
          <GradientStop Offset="1" Color="{DynamicResource Theme.SpotMintClear}" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border CornerRadius="22">
      <Border.Background>
        <RadialGradientBrush Center="0.88,0.95" GradientOrigin="0.88,0.95" RadiusX="0.25" RadiusY="0.35">
          <GradientStop Offset="0" Color="{DynamicResource Theme.SpotWarm}" />
          <GradientStop Offset="1" Color="{DynamicResource Theme.SpotWarmClear}" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border CornerRadius="22" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1,1,1,3" />

    <DockPanel Margin="0,0,0,16">
      <DockPanel DockPanel.Dock="Top" Margin="22,18,16,12">
        <Button DockPanel.Dock="Right"
                Click="Close_Click"
                ToolTip="Chiudi il pannello (Esc): il timer continua a correre"
                Style="{StaticResource IconButton}"
                Content="&#xE711;" />
        <Button DockPanel.Dock="Right"
                Click="OpenInBrowser_Click"
                ToolTip="Apri il tomato timer nel browser predefinito"
                Style="{StaticResource IconButton}"
                Content="&#xE8A7;" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Pomodoro" FontWeight="ExtraBold" FontSize="21" Foreground="{DynamicResource Theme.TextStrong}" />
          <TextBlock Text="garden.filippoitaliano.com" FontSize="12" Opacity="0.55" Margin="1,1,0,0" />
        </StackPanel>
      </DockPanel>

      <!-- Cornice della pagina: bordo crema col labbro come le card; la WebView e' ritagliata
           sugli angoli da Clip (TomatoPanel.xaml.cs), perche' Border non ritaglia i figli. -->
      <Border Margin="16,0" CornerRadius="18" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1,1,1,3" Background="{DynamicResource Theme.Surface}">
        <Grid x:Name="PageHost">
          <TextBlock x:Name="Message"
                     Text="Carico il tomato timer…"
                     FontSize="12"
                     Opacity="0.65"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="24" />
        </Grid>
      </Border>
    </DockPanel>
  </Grid>
</UserControl>
