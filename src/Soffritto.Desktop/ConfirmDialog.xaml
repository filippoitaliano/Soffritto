<!-- La conferma delle azioni di scrittura, nello stile dell'exe al posto del MessageBox di Windows:
     una card senza cornice di sistema, che si trascina dal corpo. Il margine attorno alla card e'
     lo spazio dell'ombra. Sempre nello stesso ordine: titolo, paragrafo breve, elenchi nelle
     LaneGrid delle card (come le migrazioni), azioni in basso. -->
<Window x:Class="Soffritto.Desktop.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Soffritto.Desktop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        FontSize="14"
        FontFamily="{StaticResource Rounded}"
        FontWeight="SemiBold"
        Foreground="{DynamicResource Theme.Text}">
  <Border Margin="28"
          MinWidth="420"
          MaxWidth="640"
          CornerRadius="22"
          BorderBrush="{DynamicResource Theme.CardBorder}"
          BorderThickness="1,1,1,3"
          Background="{DynamicResource Theme.Panel}"
          MouseLeftButtonDown="Card_MouseLeftButtonDown">
    <Border.Effect>
      <DropShadowEffect Direction="270" ShadowDepth="6" BlurRadius="28" Opacity="0.3" Color="#5C4A2A" />
    </Border.Effect>
    <DockPanel Margin="24,20,24,18">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
        <TextBlock DockPanel.Dock="Left"
                   Text="&#xE7BA;"
                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontWeight="Normal"
                   FontSize="20"
                   Foreground="{DynamicResource Theme.WarningText}"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
        <TextBlock x:Name="TitleText" FontWeight="ExtraBold" FontSize="18" Foreground="{DynamicResource Theme.TextStrong}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock x:Name="DescriptionText"
                 DockPanel.Dock="Top"
                 TextWrapping="Wrap"
                 FontWeight="Normal"
                 FontSize="13.5"
                 LineHeight="20"
                 Opacity="0.85" />
      <!-- Annulla e' il bottone predefinito, anche per Invio: le conferme proteggono azioni di scrittura. -->
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button x:Name="CancelButton" IsCancel="True" IsDefault="True" Style="{StaticResource TextButton}" Margin="0" />
        <Button x:Name="ConfirmButton" Click="Confirm_Click" Style="{StaticResource TextButton}" Background="#C8553D" Foreground="White" Margin="8,0,0,0" />
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440" Focusable="False">
        <ItemsControl x:Name="ListsControl" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,14,0,0">
                <TextBlock Text="{Binding Heading}" FontWeight="Bold" FontSize="12.5" Opacity="0.7" Margin="2,0,0,6" />
                <local:LaneGrid ItemsSource="{Binding Rows}">
                  <local:LaneGrid.ItemTemplate>
                    <DataTemplate>
                      <local:Lane Badge="{Binding Badge}" Text="{Binding Text}" Note="{Binding Note}" ToolTip="{Binding Text}" />
                    </DataTemplate>
                  </local:LaneGrid.ItemTemplate>
                </local:LaneGrid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
