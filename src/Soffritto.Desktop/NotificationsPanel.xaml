<!-- Notifications panel, sliding in from the right: new work on pull requests the user has not
     dealt with yet. Clicking a notification goes to the PR panel, on its work item's card, and
     leaves the notification where it is; only the tick removes it. Those whose work is gone from
     Azure DevOps stay, faded and marked “resolved”. -->
<UserControl x:Class="Soffritto.Desktop.NotificationsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Soffritto.Desktop"
             Background="Transparent">
  <UserControl.Resources>
    <!-- The blue of the PR panel's to-do actions. -->

    <DataTemplate x:Key="NotificationTemplate">
      <Border x:Name="Card"
              Background="{DynamicResource Theme.Surface}"
              BorderBrush="{DynamicResource Theme.CardBorder}"
              BorderThickness="1,1,1,3"
              CornerRadius="18"
              Margin="0,0,0,8"
              Cursor="Hand"
              ToolTip="Show the PR in the pull requests panel; the notification stays until you mark it as read">
        <Border.InputBindings>
          <MouseBinding Gesture="LeftClick" Command="{Binding OpenCommand}" />
        </Border.InputBindings>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border x:Name="Bar" Grid.Column="0" Background="{DynamicResource Theme.TagText}" CornerRadius="2" Margin="0,12" />

          <StackPanel x:Name="Body" Grid.Column="1" Margin="12,10,8,10">
            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Theme.TagText}" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Title}" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Margin="0,3,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="{Binding When}" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
              <Border Visibility="{Binding ResolvedVisibility}"
                      Style="{StaticResource Tag}"
                      Background="#1A6BB36B"
                      BorderBrush="#4D6BB36B"
                      Padding="5,0"
                      ToolTip="This work is no longer on Azure DevOps">
                <TextBlock Text="Resolved" Style="{StaticResource TagText}" Foreground="{DynamicResource Theme.SuccessText}" FontSize="11" />
              </Border>
            </StackPanel>
          </StackPanel>

          <Button Grid.Column="2"
                  Command="{Binding DismissCommand}"
                  ToolTip="Mark as read: the notification goes away"
                  Style="{StaticResource IconButton}"
                  VerticalAlignment="Top"
                  Margin="0,8,10,0"
                  Content="&#xE73E;" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsResolved}" Value="True">
          <Setter TargetName="Bar" Property="Visibility" Value="Hidden" />
          <Setter TargetName="Body" Property="Opacity" Value="0.6" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <!-- Same background and shadow as the PR panel (PullRequestsPanel.xaml). -->
  <Grid>
    <Border CornerRadius="22">
      <Border.Effect>
        <DropShadowEffect Direction="270" ShadowDepth="6" BlurRadius="28" Opacity="0.24" Color="#5C4A2A" />
      </Border.Effect>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0" Color="{DynamicResource Theme.Base0}" />
          <GradientStop Offset="0.5" Color="{DynamicResource Theme.Base1}" />
          <GradientStop Offset="1" Color="{DynamicResource Theme.Base2}" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border CornerRadius="22">
      <Border.Background>
        <RadialGradientBrush Center="0.15,0.08" GradientOrigin="0.15,0.08" RadiusX="0.25" RadiusY="0.4">
          <GradientStop Offset="0" Color="{DynamicResource Theme.SpotMint}" />
          <GradientStop Offset="1" Color="{DynamicResource Theme.SpotMintClear}" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border CornerRadius="22">
      <Border.Background>
        <RadialGradientBrush Center="0.88,0.95" GradientOrigin="0.88,0.95" RadiusX="0.25" RadiusY="0.35">
          <GradientStop Offset="0" Color="{DynamicResource Theme.SpotWarm}" />
          <GradientStop Offset="1" Color="{DynamicResource Theme.SpotWarmClear}" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border CornerRadius="22" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1,1,1,3" />

    <DockPanel Margin="0,0,0,16">
      <DockPanel DockPanel.Dock="Top" Margin="22,18,16,12">
        <Button DockPanel.Dock="Right"
                Click="Close_Click"
                ToolTip="Close the panel (Esc)"
                Style="{StaticResource IconButton}"
                Content="&#xE711;" />
        <Button DockPanel.Dock="Right"
                Command="{Binding DismissAllCommand}"
                Visibility="{Binding DismissAllVisibility}"
                ToolTip="Mark all notifications as read, without opening the PRs"
                Style="{StaticResource AppButton}"
                Tag="#6BB36B"
                Content="&#xE73E;"
                local:AppButton.Label="Mark all as read" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Notifications" FontWeight="ExtraBold" FontSize="21" Foreground="{DynamicResource Theme.TextStrong}" />
          <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.55" Margin="1,1,0,0" />
        </StackPanel>
      </DockPanel>

      <!-- The scrollbar sits over the content's right margin: 4 + 12 = the 16 on the left. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
        <StackPanel Margin="16,0,12,4">
          <TextBlock Text="No new work on pull requests"
                     Visibility="{Binding EmptyVisibility}"
                     Opacity="0.5"
                     FontSize="12"
                     FontStyle="Italic"
                     Margin="6,4,0,0" />
          <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NotificationTemplate}" ItemContainerStyle="{StaticResource EnterSoftly}" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
