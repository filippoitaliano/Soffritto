<!-- Story points meeting, designed for a TV watched from a distance: it fills the whole
     window, with large texts and one color per phase (purple expert, blue description, amber
     thinking, green votes) that also tints the background halo. Light or dark theme, chosen at
     the start: the colors are dynamic resources that ApplyTheme swaps. The text color is
     inherited from the root, so it also reaches inside the list templates. The scene is drawn at
     1600x900 inside a Viewbox: it scales as a whole to any screen without reflow. Titles are
     never cut: they wrap, and the story card scrolls.
     Buttons and boxes must not be confused: buttons are the app's filled pills (half-height
     radius, as in App.xaml), boxes are bordered rectangles as in the setup. Screens:
     participants, recap, turns, final summary. The DataContext is a
     StoryPointsMeetingViewModel; closing does not stop the meeting. -->
<UserControl x:Class="Soffritto.Desktop.StoryPointsMeetingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Soffritto.Desktop"
             xmlns:vm="clr-namespace:Soffritto.Desktop.ViewModels"
             Background="Transparent">
  <UserControl.Resources>
    <!-- Dark theme values: ApplyTheme replaces them according to the choice. -->
    <SolidColorBrush x:Key="Bg" Color="#1A1717" />
    <SolidColorBrush x:Key="Card" Color="#262021" />
    <SolidColorBrush x:Key="CardLine" Color="#3D3330" />
    <SolidColorBrush x:Key="Tile" Color="#3B332E" />
    <!-- The app button colors, redefined here: the meeting has its own theme, chosen at the start. -->
    <SolidColorBrush x:Key="Theme.Control" Color="#3B332E" />
    <SolidColorBrush x:Key="Theme.ChipOutline" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Theme.TextSoft" Color="#DACDBA" />
    <SolidColorBrush x:Key="Field" Color="#1F1B1B" />
    <SolidColorBrush x:Key="Line" Color="#8A7A68" />
    <SolidColorBrush x:Key="Text" Color="#F6EEE2" />
    <SolidColorBrush x:Key="Dim" Color="#A8987F" />
    <SolidColorBrush x:Key="Body" Color="#DACDBA" />
    <SolidColorBrush x:Key="ExpertBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="DescriptionBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="ThinkingBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="VotesBrush" Color="#34D399" />
    <SolidColorBrush x:Key="ExpiredBrush" Color="#F87171" />
    <SolidColorBrush x:Key="OnAccent" Color="#1C1918" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#80CDBDA6" />

    <!-- Buttons are the app's TV variants (App.xaml): TvTextButton for the secondary ones,
         TvAppButton (glyph, label and the color in Tag) for the main action of each screen. -->

    <!-- Box: a bordered rectangle, like the setup's TextBoxes. The text sits slightly above the
         geometric center: Segoe UI leaves more room below capitals. -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Field}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
              <ScrollViewer x:Name="PART_ContentHost" Margin="6,0,6,5" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource DescriptionBrush}" />
                <Setter TargetName="Frame" Property="BorderThickness" Value="3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardLine}" />
      <!-- The bottom lip of the app's cards (FormCard), scaled to the TV. -->
      <Setter Property="BorderThickness" Value="2,2,2,5" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="Padding" Value="40,32" />
    </Style>

    <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource CardBorder}">
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="28,20" />
      <Setter Property="Margin" Value="0,0,16,16" />
    </Style>

    <Style x:Key="DimText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Dim}" />
    </Style>

    <!-- Section label in the story card: FEATURE, USER STORY, DESCRIPTION. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource DimText}">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- A work item number: a TextButton enlarged a little less than the others, to sit next to
         the text, that opens it on Azure DevOps. -->
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource TvTextButton}">
      <Setter Property="LayoutTransform">
        <Setter.Value>
          <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
        </Setter.Value>
      </Setter>
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="ContentStringFormat" Value="{}{0}  ↗" />
    </Style>

    <!-- In the points circle Nunito's large digits sit above the center of their line: they are
         lowered to the circle's center, as measured on screen. -->
    <TranslateTransform x:Key="BigDigitsLift" Y="2.5" />

    <!-- A step of the phase flow: a numbered circle and its label. The circle is background
         only, no border (a border next to a fill of another color looks jagged). To do: soft
         circle and faint text; done: stronger circle with a check mark; current: circle and
         label in the phase color. -->
    <DataTemplate x:Key="PhaseStep">
      <StackPanel Orientation="Horizontal" Height="48">
        <Border Width="44" Height="44" CornerRadius="22" VerticalAlignment="Center">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource Tile}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Line}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                  <Setter Property="Background" Value="{Binding DataContext.PhaseColor, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding Mark}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Dim}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Card}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Border>
        <TextBlock Text="{Binding Label}" FontSize="26" VerticalAlignment="Center" Margin="14,0,0,2">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource Dim}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                  <Setter Property="Foreground" Value="{Binding DataContext.PhaseColor, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <!-- The line from a step to the next one (DataContext = the step it leaves): faint, solid
         once that step is done. -->
    <Style x:Key="StepLine" TargetType="Border">
      <Setter Property="Height" Value="3" />
      <Setter Property="CornerRadius" Value="1.5" />
      <Setter Property="Margin" Value="20,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Line}" />
      <Setter Property="Opacity" Value="0.35" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDone}" Value="True">
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Border Background="{DynamicResource Bg}"
          TextElement.Foreground="{DynamicResource Text}"
          TextElement.FontFamily="{StaticResource Rounded}"
          CornerRadius="22"
          ClipToBounds="True">
    <Grid>
      <!-- Halo in the phase color, top right behind the timer. -->
      <Border Opacity="0.22">
        <Border.Background>
          <RadialGradientBrush Center="0.78,0.25" GradientOrigin="0.78,0.25" RadiusX="0.6" RadiusY="0.8">
            <GradientStop Offset="0" Color="{Binding PhaseColor}" />
            <GradientStop Offset="1" Color="Transparent" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>

      <Viewbox Stretch="Uniform">
        <Grid Width="1600" Height="900">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Header: title, then during the turns a dot and the story counter; utility commands on the right. -->
          <DockPanel Grid.Row="0" Margin="48,30,40,0" Height="60">
            <Button DockPanel.Dock="Right"
                    Click="Close_Click"
                    ToolTip="Close (Esc): the meeting stays where it is"
                    Style="{StaticResource TvTextButton}"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontWeight="Normal"
                    FontSize="11"
                    Width="26"
                    Padding="0"
                    Content="&#xE711;" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding NewMeetingCommand}"
                    Visibility="{Binding TurnVisibility}"
                    ToolTip="Stop the meeting and go back to the participants"
                    Style="{StaticResource TvTextButton}"
                    Margin="0,0,12,0"
                    Content="Start over" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding SkipCommand}"
                    Visibility="{Binding TurnVisibility}"
                    ToolTip="Move to the next story without saving points"
                    Style="{StaticResource TvTextButton}"
                    Margin="0,0,12,0"
                    Content="Skip story" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Story points meeting" FontSize="24" Style="{StaticResource DimText}" VerticalAlignment="Center" />
              <Ellipse Visibility="{Binding TurnVisibility}" Width="6" Height="6" Fill="{DynamicResource Dim}" VerticalAlignment="Center" Margin="16,2,16,0" />
              <TextBlock Text="{Binding StoryCounter}" Visibility="{Binding TurnVisibility}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>

          <!-- Participants and theme. -->
          <StackPanel Grid.Row="1" Visibility="{Binding StartVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,50">
            <TextBlock Text="Story points meeting" FontSize="76" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="One turn per story: expert, description, thinking, vote" FontSize="28" Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,8,0,48" />

            <TextBlock Text="Who's taking part?" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Initials can be changed: click a box and type" FontSize="20" Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,4,0,16" />
            <DockPanel HorizontalAlignment="Center" MaxWidth="1400">
              <Button DockPanel.Dock="Right" Command="{Binding MoreCommand}" IsEnabled="{Binding CanAdd}" ToolTip="Add a participant" Style="{StaticResource TvTextButton}" Width="26" Padding="0,0,0,2" FontSize="17" VerticalAlignment="Top" Margin="0,19,0,0" Content="+" />
              <Button DockPanel.Dock="Right" Command="{Binding LessCommand}" IsEnabled="{Binding CanRemove}" ToolTip="Remove the last participant" Style="{StaticResource TvTextButton}" Width="26" Padding="0,0,0,2" FontSize="17" VerticalAlignment="Top" Margin="10,19,14,0" Content="−" />
              <ItemsControl ItemsSource="{Binding Participants}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBox Text="{Binding Initials, UpdateSourceTrigger=PropertyChanged}"
                             CharacterCasing="Upper"
                             MaxLength="4"
                             Width="130"
                             Height="90"
                             FontSize="44"
                             Margin="0,0,14,14" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,40">
              <TextBlock Text="Theme" FontSize="26" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,18,0" />
              <Button Command="{Binding DarkCommand}" Content="Dark">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource TvTextButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsDark}" Value="True">
                        <Setter Property="Background" Value="{Binding Source={x:Static vm:MeetingButtonColors.Description}}" />
                        <Setter Property="Foreground" Value="White" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Command="{Binding LightCommand}" Margin="12,0,0,0" Content="Light">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource TvTextButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsLight}" Value="True">
                        <Setter Property="Background" Value="{Binding Source={x:Static vm:MeetingButtonColors.Description}}" />
                        <Setter Property="Foreground" Value="White" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </StackPanel>

            <Button Command="{Binding PrepareCommand}"
                    IsEnabled="{Binding CanPrepare}"
                    Style="{StaticResource TvAppButton}"
                    Tag="{x:Static vm:MeetingButtonColors.Description}"
                    HorizontalAlignment="Center"
                    Content="&#xE716;"
                    local:AppButton.Label="Prepare the meeting" />
            <Border Visibility="{Binding ErrorVisibility}" Background="#33F87171" CornerRadius="16" Padding="24,14" Margin="0,28,0,0" MaxWidth="1100">
              <TextBlock Text="{Binding ErrorLine}" FontSize="22" TextWrapping="Wrap" TextAlignment="Center" />
            </Border>
          </StackPanel>

          <TextBlock Grid.Row="1"
                     Visibility="{Binding LoadingVisibility}"
                     Text="Reading the stories from Azure DevOps…"
                     FontSize="40"
                     Style="{StaticResource DimText}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />

          <!-- Recap before starting: how many stories, how long it takes, when it ends. -->
          <Grid Grid.Row="1" Visibility="{Binding RecapVisibility}" Margin="48,24,48,44">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="6*" />
              <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,24,0">
              <TextBlock DockPanel.Dock="Top" Text="Before we start" FontSize="52" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,16,24" />
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,16,0">
                <Button Command="{Binding BackCommand}" Style="{StaticResource TvTextButton}" Content="Back" />
                <Button Command="{Binding BeginCommand}"
                        IsEnabled="{Binding CanBegin}"
                        Style="{StaticResource TvAppButton}"
                        Tag="{x:Static vm:MeetingButtonColors.Votes}"
                        Margin="16,0,0,0"
                        Content="&#xE768;"
                        local:AppButton.Label="Start the meeting" />
              </StackPanel>
              <!-- Four tiles with the same layout: the value, as large as fits (a long one like
                   "~26 min" shrinks instead of being cut), and its label below. -->
              <UniformGrid Columns="2" Rows="2" Margin="0,0,0,24">
                <UniformGrid.Resources>
                  <!-- 5 px up: the large value's line keeps empty room above the digits, and the
                       group measured below the tile's center. -->
                  <Style TargetType="StackPanel">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                  </Style>
                  <Style TargetType="Viewbox">
                    <Setter Property="Stretch" Value="Uniform" />
                    <Setter Property="StretchDirection" Value="DownOnly" />
                  </Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="FontSize" Value="24" />
                    <Setter Property="Foreground" Value="{DynamicResource Dim}" />
                  </Style>
                  <Style x:Key="StatValue" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="80" />
                    <Setter Property="FontWeight" Value="Bold" />
                  </Style>
                </UniformGrid.Resources>
                <Border Style="{StaticResource StatTile}">
                  <StackPanel>
                    <Viewbox>
                      <TextBlock Text="{Binding StoryCount}" Style="{StaticResource StatValue}" Foreground="{DynamicResource DescriptionBrush}" />
                    </Viewbox>
                    <TextBlock Text="{Binding StoryCountLabel}" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                  <StackPanel>
                    <Viewbox>
                      <TextBlock Text="{Binding EstimatedDuration}" Style="{StaticResource StatValue}" Foreground="{DynamicResource ExpertBrush}" />
                    </Viewbox>
                    <TextBlock Text="estimated duration" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                  <StackPanel>
                    <Viewbox>
                      <TextBlock Text="{Binding EstimatedEnd}" Style="{StaticResource StatValue}" Foreground="{DynamicResource ThinkingBrush}" />
                    </Viewbox>
                    <TextBlock Text="expected end" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}">
                  <StackPanel>
                    <Viewbox>
                      <TextBlock Text="{Binding Participants.Count}" Style="{StaticResource StatValue}" Foreground="{DynamicResource VotesBrush}" />
                    </Viewbox>
                    <TextBlock Text="participants" />
                  </StackPanel>
                </Border>
              </UniformGrid>
            </DockPanel>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Stories up for estimation" FontSize="30" FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding EstimatedDurationHint}" FontSize="20" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4,0,18" />
                <Grid>
                  <TextBlock Visibility="{Binding NoStoriesVisibility}"
                             Text="Nothing to estimate: the stories of accepted or active features and the open bugs already have points."
                             FontSize="26"
                             TextWrapping="Wrap"
                             Style="{StaticResource DimText}" />
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecapStories}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <DockPanel Margin="0,0,0,18">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding WorkItem}" Width="96" FontSize="22" FontWeight="SemiBold" Foreground="{Binding Color}" />
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" FontSize="24" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Feature}" FontSize="18" Style="{StaticResource DimText}" TextWrapping="Wrap" />
                            </StackPanel>
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </DockPanel>
            </Border>
          </Grid>

          <!-- The turn: phase strip, story on the left, time or result on the right. -->
          <Grid Grid.Row="1" Visibility="{Binding TurnVisibility}" Margin="48,20,48,44">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The phases as a flow of steps, not buttons, across the whole width: the steps
                 keep their size and the lines between them stretch. -->
            <Grid Grid.Row="0" Margin="4,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentControl Grid.Column="0" Content="{Binding PhaseSteps[0]}" ContentTemplate="{StaticResource PhaseStep}" />
              <Border Grid.Column="1" DataContext="{Binding PhaseSteps[0]}" Style="{StaticResource StepLine}" />
              <ContentControl Grid.Column="2" Content="{Binding PhaseSteps[1]}" ContentTemplate="{StaticResource PhaseStep}" />
              <Border Grid.Column="3" DataContext="{Binding PhaseSteps[1]}" Style="{StaticResource StepLine}" />
              <ContentControl Grid.Column="4" Content="{Binding PhaseSteps[2]}" ContentTemplate="{StaticResource PhaseStep}" />
              <Border Grid.Column="5" DataContext="{Binding PhaseSteps[2]}" Style="{StaticResource StepLine}" />
              <ContentControl Grid.Column="6" Content="{Binding PhaseSteps[3]}" ContentTemplate="{StaticResource PhaseStep}" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,24,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="3*" />
              </Grid.ColumnDefinitions>

              <!-- The story being estimated, work item information only: parent feature (a bug may
                   not have one) and user story or bug with its link, then the description. The
                   sections scroll together with the app's scrollbar, titles always whole; the bar
                   sits over the content and the right margin keeps the text out of its strip.
                   Everything is shown even when feature, title and description repeat the same
                   text: that is the work item's data. The border has the Azure DevOps colour of the
                   type: light blue for a user story, red for a bug. -->
              <Border Grid.Column="0" Style="{StaticResource CardBorder}" BorderBrush="{Binding StoryKindColor}" Margin="0,0,24,0" Padding="40,26,24,28">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,16,0">
                    <StackPanel Visibility="{Binding FeatureSectionVisibility}" Margin="0,0,0,22">
                      <TextBlock Text="FEATURE" Style="{StaticResource SectionLabel}" />
                      <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Left"
                                Command="{Binding OpenFeatureCommand}"
                                ToolTip="Open the feature on Azure DevOps"
                                Style="{StaticResource LinkButton}"
                                Content="{Binding FeatureId}" />
                        <TextBlock Text="{Binding FeatureTitle}"
                                   FontSize="24"
                                   Foreground="{DynamicResource Body}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0" />
                      </DockPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding StoryKindLabel}" Style="{StaticResource SectionLabel}" />
                    <DockPanel Margin="0,6,0,0">
                      <Button DockPanel.Dock="Left"
                              Command="{Binding OpenStoryCommand}"
                              ToolTip="Open the user story on Azure DevOps"
                              Style="{StaticResource LinkButton}"
                              Margin="0,4,0,0"
                              Content="{Binding StoryId}" />
                      <TextBlock Text="{Binding StoryTitle}"
                                 FontSize="38"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center"
                                 Margin="16,0,0,0" />
                    </DockPanel>

                    <StackPanel Visibility="{Binding DescriptionSectionVisibility}" Margin="0,22,0,0">
                      <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionLabel}" />
                      <TextBlock Text="{Binding StoryDescription}" FontSize="24" LineHeight="34" TextWrapping="Wrap" Foreground="{DynamicResource Body}" Margin="0,6,0,0" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Border>

              <!-- The phase: time, commands and votes. Everything you interact with lives here. -->
              <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="32,28">
                <Grid>
                  <!-- Phases before the votes: title, in the middle the phase commands (expert or
                       scale) or, during the description, the stopwatch (it fits the space), below
                       next and, with the stopwatch, pause. -->
                  <DockPanel Visibility="{Binding BeforeVotesVisibility}">
                    <StackPanel DockPanel.Dock="Top">
                      <TextBlock Text="{Binding PhaseTitle}" Foreground="{Binding PhaseColor}" FontSize="42" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" />
                      <TextBlock Text="{Binding PhaseHint}" FontSize="22" Style="{StaticResource DimText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                      <Button Command="{Binding PauseCommand}"
                              Visibility="{Binding StopwatchVisibility}"
                              Style="{StaticResource TvTextButton}"
                              Content="{Binding PauseLabel}"
                              Margin="0,0,16,0" />
                      <Button Command="{Binding NextCommand}"
                              Style="{StaticResource TvAppButton}"
                              Tag="{Binding PhaseButtonColor}"
                              Content="&#xE72A;"
                              local:AppButton.Label="Next" />
                    </StackPanel>

                    <Grid>
                      <Grid VerticalAlignment="Center" Margin="0,0,0,18">
                        <!-- Phase 1: one click picks the expert. -->
                        <ItemsControl ItemsSource="{Binding Participants}" Visibility="{Binding ExpertVisibility}" HorizontalAlignment="Center">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Command="{Binding ChooseExpertCommand}"
                                      Width="48"
                                      Padding="0"
                                      FontSize="14"
                                      Margin="5"
                                      Content="{Binding Label}">
                                <Button.Style>
                                  <Style TargetType="Button" BasedOn="{StaticResource TvTextButton}">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsExpert}" Value="True">
                                        <Setter Property="Background" Value="{Binding Source={x:Static vm:MeetingButtonColors.Expert}}" />
                                        <Setter Property="Foreground" Value="White" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Button.Style>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Phase 3: the scale as a reminder. -->
                        <TextBlock Text="{Binding ScaleText}"
                                   Visibility="{Binding ThinkingVisibility}"
                                   FontSize="40"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThinkingBrush}"
                                   HorizontalAlignment="Center" />
                      </Grid>

                      <!-- Stopwatch kept quiet: during the description the room looks at the
                           speaker, not at the clock. A mid-sized thin ring with neutral digits;
                           only the ring changes color at one and two minutes. -->
                      <Viewbox Visibility="{Binding StopwatchVisibility}" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,14">
                        <Grid Width="220" Height="220">
                          <local:CountdownRing Ratio="{Binding TimeRatio}" Stroke="{Binding TimeColor}" Track="{DynamicResource Tile}" Thickness="12" />
                          <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Dim}" FontSize="64" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                      </Viewbox>
                    </Grid>
                  </DockPanel>

                  <!-- Votes: the boxes, then the value to save. The scale stays hidden:
                       it appears with “Change”, to change the average at the end; “Use the average”
                       cancels. -->
                  <DockPanel Visibility="{Binding VotesVisibility}">
                    <StackPanel DockPanel.Dock="Top">
                      <TextBlock Text="{Binding PhaseTitle}" Foreground="{DynamicResource VotesBrush}" FontSize="42" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" />
                      <TextBlock Text="{Binding VotesSummary}" FontSize="22" Style="{StaticResource DimText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- One vote per participant; beyond two rows it scrolls. -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">
                      <TextBlock Text="Enter your votes (empty = abstain)" FontSize="20" Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="196">
                        <ItemsControl ItemsSource="{Binding Participants}" HorizontalAlignment="Center">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Width="96" Margin="5,0,5,8">
                                <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="SemiBold" Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBox Text="{Binding VoteText, UpdateSourceTrigger=PropertyChanged}" Height="60" FontSize="32">
                                  <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasInvalidVote}" Value="True">
                                          <Setter Property="BorderBrush" Value="{DynamicResource ExpiredBrush}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBox.Style>
                                </TextBox>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                      <Border Visibility="{Binding ErrorVisibility}" Background="#33F87171" CornerRadius="16" Padding="18,10" Margin="0,0,0,14">
                        <TextBlock Text="{Binding ErrorLine}" FontSize="18" TextWrapping="Wrap" />
                      </Border>
                      <Button Command="{Binding SaveCommand}"
                              IsEnabled="{Binding CanSave}"
                              Style="{StaticResource TvAppButton}"
                              Tag="{x:Static vm:MeetingButtonColors.Votes}"
                              HorizontalAlignment="Center"
                              Content="&#xE74E;"
                              local:AppButton.Label="{Binding SaveLabel}" />
                    </StackPanel>

                    <!-- The value to save, alone and centred: a faint circle until the votes give a
                         value, then the votes color with the value inside, and below it the commands
                         to change it. It shrinks if the boxes take two rows. -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,12">
                      <StackPanel>
                        <Grid Width="160" Height="160" HorizontalAlignment="Center">
                          <Ellipse Fill="{DynamicResource VotesBrush}">
                            <Ellipse.Style>
                              <Style TargetType="Ellipse">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasPoints}" Value="False">
                                    <Setter Property="Opacity" Value="0.12" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Ellipse.Style>
                          </Ellipse>
                          <TextBlock Text="{Binding SelectedPoints}" Foreground="{DynamicResource OnAccent}" FontSize="84" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransform="{StaticResource BigDigitsLift}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                          <Button Command="{Binding EditCommand}"
                                  Visibility="{Binding EditVisibility}"
                                  ToolTip="Show the scale to save a value other than the average"
                                  Style="{StaticResource TvTextButton}"
                                  Content="Change" />
                          <Button Command="{Binding UseAverageCommand}"
                                  Visibility="{Binding UseAverageVisibility}"
                                  ToolTip="Go back to the value closest to the average"
                                  Style="{StaticResource TvTextButton}"
                                  Margin="10,0,0,0"
                                  Content="Use the average" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Choices}" Visibility="{Binding ChoicesVisibility}" HorizontalAlignment="Center" Margin="0,12,0,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Command="{Binding SelectCommand}"
                                      Width="26"
                                      Padding="0"
                                      FontSize="13"
                                      Margin="5"
                                      Content="{Binding Value}">
                                <Button.Style>
                                  <Style TargetType="Button" BasedOn="{StaticResource TvTextButton}">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{Binding Source={x:Static vm:MeetingButtonColors.Votes}}" />
                                        <Setter Property="Foreground" Value="White" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Button.Style>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Viewbox>
                  </DockPanel>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <!-- End: how it went, how long it took. -->
          <Grid Grid.Row="1" Visibility="{Binding FinishedVisibility}" Margin="48,24,48,44" Width="1200">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                <TextBlock Text="Meeting over" FontSize="76" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding FinishedSummary}" FontSize="32" Foreground="{DynamicResource VotesBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="{Binding FinishedDuration}" FontSize="24" Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,6,0,28" />
              </StackPanel>
              <Button DockPanel.Dock="Bottom"
                      Command="{Binding NewMeetingCommand}"
                      Style="{StaticResource TvAppButton}"
                      Tag="{x:Static vm:MeetingButtonColors.Description}"
                      HorizontalAlignment="Center"
                      Margin="0,24,0,0"
                      Content="&#xE710;"
                      local:AppButton.Label="New meeting" />
              <Border Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Outcomes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,14">
                          <TextBlock DockPanel.Dock="Left" Text="{Binding WorkItem}" Width="110" FontSize="24" Style="{StaticResource DimText}" />
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Result}" FontSize="26" FontWeight="Bold" Margin="20,0,0,0">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource VotesBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Dim}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBlock Text="{Binding Title}" FontSize="26" TextWrapping="Wrap" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </DockPanel>
          </Grid>
        </Grid>
      </Viewbox>
    </Grid>
  </Border>
</UserControl>
