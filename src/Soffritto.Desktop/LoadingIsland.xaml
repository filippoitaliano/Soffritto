<!-- Indicator of reads in progress, like a dynamic island: a semi-transparent pill (warm graphite on the
     dark theme, cream on the light one) with a
     glowing border, a breathing halo, a sliding sheen and three bobbing dots. It appears when the
     DataContext's IsLoading turns true, spreading out like a drop, and closes again when it turns
     false; the animations live in LoadingIsland.xaml.cs. It does not catch the mouse. With
     FromBottom it comes in from the bottom; with DodgesMouse it moves to the opposite side of the
     window when the mouse passes over it. The shadow sits on a border behind, so text rendering is untouched. -->
<UserControl x:Class="Soffritto.Desktop.LoadingIsland"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"
             IsHitTestVisible="False">
  <UserControl.Resources>
    <Style x:Key="Dot" TargetType="Ellipse">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource Theme.IslandDot}" />
    </Style>
  </UserControl.Resources>

  <Grid x:Name="Shell" Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" Margin="6">
    <Grid.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="Scale" />
        <TranslateTransform x:Name="Shift" />
      </TransformGroup>
    </Grid.RenderTransform>

    <!-- Blurred warm-grey halo behind the pill: it breathes while the island is on. -->
    <Border x:Name="Halo" CornerRadius="22" Margin="-3" Background="{DynamicResource Theme.IslandHalo}" Opacity="0.25">
      <Border.Effect>
        <BlurEffect Radius="14" />
      </Border.Effect>
    </Border>

    <!-- Colors from the theme: warm graphite on the dark theme, cream on the light one. -->
    <Border CornerRadius="20" BorderThickness="1" Background="{DynamicResource Theme.IslandBackground}" BorderBrush="{DynamicResource Theme.IslandBorder}">
      <Border.Effect>
        <DropShadowEffect Direction="270" ShadowDepth="3" BlurRadius="16" Opacity="0.22" Color="#1E1A16" />
      </Border.Effect>
    </Border>

    <!-- Sheen sweeping across the pill: a rounded border's background stays inside the corners. -->
    <Border CornerRadius="20" Margin="1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
          <LinearGradientBrush.RelativeTransform>
            <TranslateTransform x:Name="Sheen" X="-1" />
          </LinearGradientBrush.RelativeTransform>
          <GradientStop Offset="0.3" Color="#00FFFFFF" />
          <GradientStop Offset="0.5" Color="#26FFFFFF" />
          <GradientStop Offset="0.7" Color="#00FFFFFF" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <StackPanel Orientation="Horizontal" Margin="16,9,19,10">
      <Ellipse x:Name="Dot1" Style="{StaticResource Dot}">
        <Ellipse.RenderTransform>
          <TranslateTransform />
        </Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="Dot2" Style="{StaticResource Dot}">
        <Ellipse.RenderTransform>
          <TranslateTransform />
        </Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="Dot3" Style="{StaticResource Dot}">
        <Ellipse.RenderTransform>
          <TranslateTransform />
        </Ellipse.RenderTransform>
      </Ellipse>
      <TextBlock Text="{Binding Label, ElementName=Root}"
                 Foreground="{DynamicResource Theme.IslandText}"
                 FontFamily="{StaticResource Rounded}"
                 FontSize="13"
                 FontWeight="Bold"
                 VerticalAlignment="Center"
                 Margin="6,0,0,1" />
    </StackPanel>
  </Grid>
</UserControl>
