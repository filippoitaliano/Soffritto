<!-- “New Docker environment” pane, sliding in from the right like the notifications one:
     it opens from the “+” next to the environment numbers in the header. Seed, Docker disk space
     and logs live in the “Docker” tab of the setup. The DataContext is a DockerPanelViewModel. -->
<UserControl x:Class="Soffritto.Desktop.DockerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Soffritto.Desktop"
             Background="Transparent">
  <UserControl.Resources>
    <!-- The panel's text boxes and drop-downs are the app's shared ones (App.xaml, Form* styles). -->
    <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource FormComboBox}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource FormCheckBox}" />
  </UserControl.Resources>
  <Grid>
    <Border CornerRadius="22" Background="{DynamicResource Theme.PanelWarm}" />
    <Border CornerRadius="22" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1,1,1,3" />

    <DockPanel Margin="0,0,0,16">
      <DockPanel DockPanel.Dock="Top" Margin="22,18,16,12">
        <Button DockPanel.Dock="Right"
                Click="Close_Click"
                ToolTip="Close (Esc)"
                Style="{StaticResource IconButton}"
                Content="&#xE711;" />
        <Button DockPanel.Dock="Right"
                Command="{Binding RefreshCreateCommand}"
                ToolTip="Reload the suggested number and the branches of the source clones"
                Style="{StaticResource IconButton}"
                Content="&#xE72C;" />
        <TextBlock Text="New Docker environment" FontWeight="ExtraBold" FontSize="21" Foreground="{DynamicResource Theme.TextStrong}" VerticalAlignment="Center" />
      </DockPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
        <StackPanel Margin="16,0,12,4">
          <TextBlock Text="Worktrees from the source clones, database from the seed and the slot's containers. Creation details show up under “Operations” in the new environment's card."
                     TextWrapping="Wrap"
                     FontSize="13"
                     Opacity="0.7"
                     Margin="6,0,6,12" />
          <Border Style="{StaticResource FormCard}">
            <StackPanel>
              <StackPanel Style="{StaticResource FormField}">
                <local:FieldLabel Text="Number" Info="The column number of the new environment. The first free one above the local environments is suggested." />
                <TextBox Text="{Binding CreateNumber, UpdateSourceTrigger=PropertyChanged}" Width="64" HorizontalAlignment="Left" TextAlignment="Center" FontWeight="Bold" />
              </StackPanel>
              <local:FieldLabel Text="Repositories and branches"
                                Info="Tick the repositories to include and pick a branch for each: a remote branch (marked ones are already in a worktree) or a new name, created from the development branch." />
              <ItemsControl ItemsSource="{Binding CreateRows}" Margin="0,2,0,14">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,8" IsEnabled="{Binding IsEnabled}" ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True">
                      <CheckBox DockPanel.Dock="Left"
                                Width="120"
                                VerticalAlignment="Center"
                                IsChecked="{Binding Include}"
                                Content="{Binding Id}" />
                      <ComboBox IsEditable="True"
                                ItemsSource="{Binding Branches}"
                                Text="{Binding Branch, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding Include}"
                                FontFamily="Cascadia Mono, Consolas"
                                FontWeight="Normal" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="0,0,0,16">
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding AssignPool}" Style="{StaticResource Switch}" Margin="0,0,12,0" />
                <StackPanel>
                  <TextBlock Text="Tunnel" FontWeight="Bold" Foreground="{DynamicResource Theme.TextStrong}" />
                  <TextBlock Text="The environment claims a free tunnel from the pool: one port for the backend and one for the frontend, with anonymous access."
                             FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,1,0,0" />
                </StackPanel>
              </DockPanel>
              <DockPanel>
                <Button DockPanel.Dock="Left"
                        Command="{Binding CreateCommand}"
                        IsEnabled="{Binding CanCreate}"
                        ToolTip="Create worktrees, env, database from the seed and containers, then open the web watch"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0"
                        Content="Create environment" />
                <TextBlock Text="{Binding CreateBlockReason}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" />
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
