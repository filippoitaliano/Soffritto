<!-- Riquadro «Nuovo ambiente Docker», a scomparsa sul lato destro come quello delle notifiche:
     si apre dal «+» accanto ai numeri degli ambienti nella testata. Seed, spazio di Docker e log
     stanno nella scheda «Docker» del setup. Il DataContext e' un DockerPanelViewModel. -->
<UserControl x:Class="Soffritto.Desktop.DockerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Soffritto.Desktop"
             Background="Transparent">
  <UserControl.Resources>
    <!-- Caselle e tendine del pannello sono quelle comuni dell'exe (App.xaml, stili Form*). -->
    <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource FormComboBox}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource FormCheckBox}" />
  </UserControl.Resources>
  <Grid>
    <Border CornerRadius="22" Background="{DynamicResource Theme.PanelWarm}" />
    <Border CornerRadius="22" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1,1,1,3" />

    <DockPanel Margin="0,0,0,16">
      <DockPanel DockPanel.Dock="Top" Margin="22,18,16,12">
        <Button DockPanel.Dock="Right"
                Click="Close_Click"
                ToolTip="Chiudi (Esc)"
                Style="{StaticResource IconButton}"
                Content="&#xE711;" />
        <Button DockPanel.Dock="Right"
                Command="{Binding RefreshCreateCommand}"
                ToolTip="Rilegge il numero proposto e i branch dei cloni sorgente"
                Style="{StaticResource IconButton}"
                Content="&#xE72C;" />
        <TextBlock Text="Nuovo ambiente Docker" FontWeight="ExtraBold" FontSize="21" Foreground="{DynamicResource Theme.TextStrong}" VerticalAlignment="Center" />
      </DockPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
        <StackPanel Margin="16,0,12,4">
          <TextBlock Text="Worktree dai cloni sorgente, database dal seed e container dello slot. Il dettaglio della creazione va in «Operazioni» nella card del nuovo ambiente."
                     TextWrapping="Wrap"
                     FontSize="13"
                     Opacity="0.7"
                     Margin="6,0,6,12" />
          <Border Style="{StaticResource FormCard}">
            <StackPanel>
              <StackPanel Style="{StaticResource FormField}">
                <local:FieldLabel Text="Numero" Info="Il numero della colonna del nuovo ambiente. Viene proposto il primo libero sopra gli ambienti locali." />
                <TextBox Text="{Binding CreateNumber, UpdateSourceTrigger=PropertyChanged}" Width="64" HorizontalAlignment="Left" TextAlignment="Center" FontWeight="Bold" />
              </StackPanel>
              <local:FieldLabel Text="Repository e branch"
                                Info="Spunta i repository da includere e scegli il branch di ognuno: un branch remoto (quelli marcati sono già in un worktree) oppure un nome nuovo, che nasce dal branch di sviluppo." />
              <ItemsControl ItemsSource="{Binding CreateRows}" Margin="0,2,0,14">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,8" IsEnabled="{Binding IsEnabled}" ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True">
                      <CheckBox DockPanel.Dock="Left"
                                Width="120"
                                VerticalAlignment="Center"
                                IsChecked="{Binding Include}"
                                Content="{Binding Id}" />
                      <ComboBox IsEditable="True"
                                ItemsSource="{Binding Branches}"
                                Text="{Binding Branch, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding Include}"
                                FontFamily="Cascadia Mono, Consolas"
                                FontWeight="Normal" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="0,0,0,16">
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding AssignPool}" Style="{StaticResource Switch}" Margin="0,0,12,0" />
                <StackPanel>
                  <TextBlock Text="Tunnel" FontWeight="Bold" Foreground="{DynamicResource Theme.TextStrong}" />
                  <TextBlock Text="L'ambiente reclama un tunnel libero del pool: una porta al backend e una al frontend, con accesso anonimo."
                             FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,1,0,0" />
                </StackPanel>
              </DockPanel>
              <DockPanel>
                <Button DockPanel.Dock="Left"
                        Command="{Binding CreateCommand}"
                        IsEnabled="{Binding CanCreate}"
                        ToolTip="Crea worktree, env, database dal seed e container, poi apre il watch del web"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0"
                        Content="Crea ambiente" />
                <TextBlock Text="{Binding CreateBlockReason}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0" />
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
