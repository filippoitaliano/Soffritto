<!-- The sections mirror those of the VSIX (UI/StatusControl.xaml): same rows, and only the
     contents (migrations, ports, errors) change height. Unlike the VSIX, the app does not write
     the status and “updated HH:mm:ss” under the cards: they live in the dot's tooltip. Icons are
     Segoe Fluent Icons glyphs instead of KnownMonikers, which don't exist outside Visual Studio.
     The color #26808080 is a translucent grey used for separators. -->
<Window x:Class="Soffritto.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Soffritto.Desktop"
        Title="{Binding WindowTitle}"
        Width="1900"
        Height="950"
        MinWidth="1100"
        MinHeight="600"
        WindowState="Maximized"
        UseLayoutRounding="True"
        FontSize="14"
        FontFamily="{StaticResource Rounded}"
        FontWeight="SemiBold"
        Foreground="{DynamicResource Theme.Text}"
        Background="{DynamicResource Theme.WindowBackground}">
  <Window.Resources>
    <!-- Service start/stop (Tag = the group's IsStop): standard grey when it starts, solid purple
         when it stops, so what is running and needs stopping stands out at a glance without the
         weight of the alert red; the white glyph on top is about 4.6:1. The template is
         IconButton's, with a hover that darkens the purple instead of the grey. -->
    <Style x:Key="ServiceToggle" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Background" Value="#8764B8" />
          <Setter Property="Foreground" Value="White" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Machine resources box in the header: label, bar and value. -->
    <Style x:Key="MeterLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MeterValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Meter" TargetType="ProgressBar">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Margin" Value="6,1,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="4" Background="{DynamicResource Theme.MeterBar}" />
              <Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tag of the full copy: the same colors as Tag, already blended onto the card's white, but
         solid, because over the buttons a translucent tag would let them show through. -->
    <Style x:Key="OpaqueTag" TargetType="Border" BasedOn="{StaticResource Tag}">
      <Setter Property="Background" Value="{DynamicResource Theme.OpaqueTagBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.OpaqueTagBorder}" />
    </Style>

    <!-- Full copy of the tags above the row, in the same position as the real tags: no background
         or shadow, just the tags, fading in with the mouse over the row. -->
    <Style x:Key="TagsOverlay" TargetType="Border">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Second line of the dots' tooltips: “updated HH:mm:ss”, small and grey; when empty it disappears. -->
    <Style x:Key="DotStamp" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
        <Trigger Property="Text" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Column header note: a dashed sticky note at least two lines tall, text centered
         horizontally and vertically, up to four visible lines and then scrolling. The border
         turns solid green while typing. The minimum height is on the box and not on the lines
         (MinLines): with MinLines the text area would be two lines tall and a one-line note
         would stay at the top. Transparent background because the placeholder sits beneath it,
         centered the same way. -->
    <Style x:Key="NoteBox" TargetType="TextBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="MaxLines" Value="4" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}" />
      <Setter Property="BorderBrush" Value="#26808080" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="ToolTip" Value="Environment note: it saves itself and is the same one shown in the VSIX" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid Background="{TemplateBinding Background}">
              <Rectangle x:Name="Frame"
                         RadiusX="10"
                         RadiusY="10"
                         Stroke="{DynamicResource Theme.NoteFrame}"
                         StrokeThickness="1.2"
                         StrokeDashArray="4 3"
                         SnapsToDevicePixels="True" />
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource Theme.NoteFrameHover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="Stroke" Value="#3E9B78" />
                <Setter TargetName="Frame" Property="StrokeDashArray" Value="{x:Null}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Environment header tags: protected database first, then Docker, database and server of
         the default backend. Each tag is 4 px from the previous one and the group 4 px from the
         title, so the first visible one is always at 8 px. Used by the environment card and by its
         chip's card in the header. -->
    <DataTemplate x:Key="EnvironmentTags">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
        <!-- Local environment with a protected database: migrations are read but not applied. -->
        <Border Visibility="{Binding ProtectedDatabaseVisibility}" ToolTip="{Binding ProtectedDatabaseToolTip}">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Tag}">
              <Setter Property="Margin" Value="4,0,0,0" />
              <Setter Property="Background" Value="#26DC2626" />
              <Setter Property="BorderBrush" Value="#80DC2626" />
              <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.ProtectedDatabaseTagText}" />
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding ProtectedDatabaseTag}" Style="{StaticResource TagText}" />
        </Border>
        <Border Visibility="{Binding KindBadgeVisibility}"
                ToolTip="Docker environment: worktrees from the source clones, api, web and database in the slot's containers">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Tag}">
              <Setter Property="Margin" Value="4,0,0,0" />
              <Setter Property="Background" Value="#1A7C3AED" />
              <Setter Property="BorderBrush" Value="#4D7C3AED" />
              <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.DockerTagText}" />
            </Style>
          </Border.Style>
          <TextBlock Text="Docker" Style="{StaticResource TagText}" />
        </Border>
        <!-- Database and server of the environment's default backend, read from the
             appsettings. In a Docker environment the server is always the slot's container
             and is not shown. Orange, each on its own, for a tag whose name the
             configuration asks to highlight (the backend's highlightedTags). -->
        <Border Visibility="{Binding DatabaseTagVisibility}" ToolTip="{Binding DatabaseTagToolTip}">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Tag}">
              <Setter Property="Margin" Value="4,0,0,0" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDatabaseHighlighted}" Value="True">
                  <Setter Property="Background" Value="#26F59E0B" />
                  <Setter Property="BorderBrush" Value="#80D97706" />
                  <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.HighlightTagText}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding DatabaseTag}" Style="{StaticResource TagText}" />
        </Border>
        <Border Visibility="{Binding ServerTagVisibility}" ToolTip="{Binding ServerTagToolTip}">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Tag}">
              <Setter Property="Margin" Value="4,0,0,0" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsServerHighlighted}" Value="True">
                  <Setter Property="Background" Value="#26F59E0B" />
                  <Setter Property="BorderBrush" Value="#80D97706" />
                  <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.HighlightTagText}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding ServerTag}" Style="{StaticResource TagText}" />
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- Same look as the cards' small grey texts (the git status under the drop-down). -->
    <Style x:Key="NotePlaceholder" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Each section of the column is a card like those of the PR panel: wide corners, a barely
         visible border, 8 px from the next one. Top and bottom padding is shorter than at the
         sides because the header row (26 px) already adds air.
         Vertical padding, separator margin and nested header margin are all 8 px: so every
         header row has the same air above and below and is centered in its band.
         Light frosted-glass effect: 97-95% white that lets the gradient barely show through.
         WPF does not blur the background behind an element, so opacity stays high to keep the
         text readable even over the Ctrl+T scenery. -->
    <Style x:Key="Section" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Theme.CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardBorder}" />
      <Setter Property="BorderThickness" Value="1,1,1,3" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Style.Triggers>
        <!-- Environment entirely on dev, usually unused: the card is solid like the others but with
             a faint sunset, peach at the top left fading into pink at the bottom right, so it
             looks "at rest" next to the warm white of the environments in use without looking
             disabled. -->
        <Trigger Property="local:CardTint.AllOnDev" Value="True">
          <Setter Property="Background" Value="{DynamicResource Theme.CardBackgroundAllOnDev}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardBorderAllOnDev}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Separator between a card's header and body, edge to edge as in the PR panel: the
         negative margins cancel the Section's side padding. It follows the body's visibility,
         so a collapsed card leaves no orphan line. -->
    <Style x:Key="CardSeparator" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Theme.Separator}" />
      <Setter Property="Margin" Value="-14,8,-14,0" />
    </Style>

    <!-- Card expand arrow: the whole header is clickable (MouseBinding); the buttons inside it
         handle their own click and don't expand it. -->
    <Style x:Key="ExpanderGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Width" Value="12" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- Card header: same minimum height with or without buttons, so arrow, icon, title and
         dot sit on the same line in every card. -->
    <Style x:Key="CardHeader" TargetType="DockPanel">
      <Setter Property="LastChildFill" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="26" />
    </Style>

    <!-- Fixed width: different icons don't shift the title. -->
    <Style x:Key="CardIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Width" Value="16" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- “Log” section, collapsed by default (LogSectionViewModel): container log in the repository
         card, operations log in the Docker environment card. The text can be selected and
         copied; with the section open it sticks to the last line if the reader is at the bottom. -->
    <DataTemplate x:Key="LogSectionTemplate">
      <StackPanel>
        <Border Style="{StaticResource CardSeparator}" />
        <DockPanel Style="{StaticResource CardHeader}" Margin="0,8,0,0">
          <DockPanel.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{Binding Expander.ToggleCommand}" />
          </DockPanel.InputBindings>
          <TextBlock DockPanel.Dock="Left" Text="{Binding Expander.Glyph}" Style="{StaticResource ExpanderGlyph}" />
          <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" Style="{StaticResource CardIcon}" />
          <Button DockPanel.Dock="Right"
                  Command="{Binding ConsoleCommand}"
                  Visibility="{Binding ConsoleVisibility}"
                  ToolTip="{Binding ConsoleToolTip}"
                  Style="{StaticResource IconButton}"
                  Content="&#xE756;" />
          <TextBlock DockPanel.Dock="Right"
                     Text="{Binding State}"
                     ToolTip="{Binding State}"
                     Opacity="0.6"
                     FontSize="11"
                     MaxWidth="260"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     Margin="8,0,0,0" />
          <TextBlock DockPanel.Dock="Left" Text="{Binding Header}" Style="{StaticResource CardTitle}" />
        </DockPanel>
        <TextBox Visibility="{Binding Expander.BodyVisibility}"
                 Text="{Binding Text, Mode=OneWay}"
                 local:LogAutoScroll.IsEnabled="True"
                 Style="{StaticResource LogBox}"
                 MinHeight="60"
                 Margin="0,8,0,0" />
      </StackPanel>
    </DataTemplate>

    <!-- One card per repository: git section with fetch, pull, branch cleanup and drop-down, then
         the errors box. Clone and branch have no header of their own: they already show in the
         repository row and in the drop-down. -->
    <DataTemplate x:Key="RepoCardTemplate">
      <Border Style="{StaticResource Section}" local:CardBusy.IsBusy="{Binding IsBusyVisual}">
        <StackPanel>
          <StackPanel Visibility="{Binding MissingVisibility}">
            <TextBlock Text="{Binding RepoLine}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding RepoDetail}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
          </StackPanel>

          <StackPanel Visibility="{Binding ContentVisibility}">
            <!-- Pull stays fast-forward only: git itself refuses when it is not a
                 fast-forward, which is why the button can always be visible. -->
            <DockPanel Style="{StaticResource CardHeader}">
              <DockPanel.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding Expander.ToggleCommand}" />
              </DockPanel.InputBindings>
              <!-- Status: green running, orange console open only, grey stopped, pulsing light blue
                   while the repository is being read. In every header the dot is the first
                   element docked right, so it sits on the card's edge, after the buttons: the
                   status always shows in the same spot. The tunnel host has its own dot in the
                   tunnel section, in the body of the backend and frontend cards. -->
              <local:StatusDot DockPanel.Dock="Right"
                               Color="{Binding Tool.StateColor}"
                               IsLoading="{Binding IsLoading}">
                <local:StatusDot.ToolTip>
                  <StackPanel>
                    <TextBlock Text="{Binding Tool.StateToolTip}" />
                    <TextBlock Text="{Binding RepoStamp}" Style="{StaticResource DotStamp}" />
                  </StackPanel>
                </local:StatusDot.ToolTip>
              </local:StatusDot>
              <TextBlock DockPanel.Dock="Left" Text="{Binding Expander.Glyph}" Style="{StaticResource ExpanderGlyph}" />
              <TextBlock DockPanel.Dock="Left" Text="&#xEA68;" FontFamily="{StaticResource Codicons}" FontSize="16" Style="{StaticResource CardIcon}" />
              <Button DockPanel.Dock="Right"
                      Command="{Binding PullCommand}"
                      Visibility="{Binding GitActionsVisibility}"
                      ToolTip="{Binding PullToolTip}"
                      IsEnabled="{Binding IsNotBusy}"
                      Style="{StaticResource IconButton}"
                      FontFamily="{StaticResource Codicons}" FontSize="16"
                      Content="&#xEA9A;" />
              <Button DockPanel.Dock="Right"
                      Command="{Binding FetchCommand}"
                      Visibility="{Binding GitActionsVisibility}"
                      ToolTip="git fetch — update the remote-tracking refs and reload the repository status"
                      IsEnabled="{Binding IsNotBusy}"
                      Style="{StaticResource IconButton}"
                      FontFamily="{StaticResource Codicons}" FontSize="16"
                      Content="&#xF101;" />
              <Button DockPanel.Dock="Right"
                      Command="{Binding PruneCommand}"
                      Visibility="{Binding GitActionsVisibility}"
                      ToolTip="Delete local branches whose remote branch no longer exists (asks for confirmation)"
                      IsEnabled="{Binding IsNotBusy}"
                      Style="{StaticResource IconButton}"
                      Content="&#xE74D;" />
              <!-- The editor (Visual Studio or VS Code, as the tooltip says) is the first action after the git ones. -->
              <Button DockPanel.Dock="Right"
                      Command="{Binding Tool.OpenCommand}"
                      ToolTip="{Binding Tool.OpenToolTip}"
                      Style="{StaticResource IconButton}"
                      Content="&#xE943;" />
              <!-- Start and stop are the same button: the glyph says what it will do, red if it stops. -->
              <Button DockPanel.Dock="Right"
                      Command="{Binding Tool.ToggleCommand}"
                      Visibility="{Binding Tool.ToggleVisibility}"
                      IsEnabled="{Binding Tool.ToggleEnabled}"
                      ToolTip="{Binding Tool.ToggleToolTip}"
                      ToolTipService.ShowOnDisabled="True"
                      Tag="{Binding Tool.IsStop}"
                      Style="{StaticResource ServiceToggle}"
                      Content="{Binding Tool.ToggleGlyph}" />
              <Button DockPanel.Dock="Right"
                      Command="{Binding Tool.SideCommand}"
                      Visibility="{Binding Tool.SideIconVisibility}"
                      IsEnabled="{Binding Tool.SideEnabled}"
                      ToolTip="{Binding Tool.SideToolTip}"
                      ToolTipService.ShowOnDisabled="True"
                      Style="{StaticResource IconButton}"
                      Content="{Binding Tool.SideGlyph}" />
              <Button DockPanel.Dock="Right"
                      Command="{Binding Tool.SideCommand}"
                      Visibility="{Binding Tool.SideTextVisibility}"
                      IsEnabled="{Binding Tool.SideEnabled}"
                      ToolTip="{Binding Tool.SideToolTip}"
                      ToolTipService.ShowOnDisabled="True"
                      Style="{StaticResource TextButton}"
                      Content="{Binding Tool.SideText}" />
              <Button DockPanel.Dock="Right"
                      Command="{Binding Tool.ExtraCommand}"
                      Visibility="{Binding Tool.ExtraVisibility}"
                      ToolTip="{Binding Tool.ExtraToolTip}"
                      Style="{StaticResource TextButton}"
                      Content="{Binding Tool.ExtraText}" />
              <TextBlock DockPanel.Dock="Left"
                         Text="{Binding RepoLine}"
                         ToolTip="{Binding RepoToolTip}"
                         Style="{StaticResource CardTitle}" />
              <!-- The card's tag: the catalog id, only for non-default repositories (it tells which of
                   the two backends this is). Database and server are on the environment card.
                   In the row the tags get cut off; on hover a full copy appears over the buttons
                   (a Canvas, which does not clip, with a ZIndex above the DockPanel's siblings).
                   The copy ignores the mouse: moving onto the buttons makes it disappear and
                   leaves them clickable. -->
              <Grid VerticalAlignment="Center" Visibility="{Binding TagsVisibility}" Background="Transparent" Panel.ZIndex="1">
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                  <Border Style="{StaticResource Tag}" Visibility="{Binding IdTagVisibility}" Margin="0,0,4,0">
                    <Border.ToolTip>
                      <TextBlock Text="{Binding Id, StringFormat='Catalog id: {0}. Consoles and dev tunnels of this repository use names with this id.'}" />
                    </Border.ToolTip>
                    <TextBlock Text="{Binding Id}" Style="{StaticResource TagText}" />
                  </Border>
                </StackPanel>
                <Canvas>
                  <Border Style="{StaticResource TagsOverlay}">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                      <Border Style="{StaticResource OpaqueTag}" Visibility="{Binding IdTagVisibility}" Margin="0,0,4,0">
                        <TextBlock Text="{Binding Id}" Style="{StaticResource TagText}" />
                      </Border>
                    </StackPanel>
                  </Border>
                </Canvas>
              </Grid>
            </DockPanel>

            <!-- Card body: with the card collapsed, header, timestamp and errors remain. -->
            <Border Visibility="{Binding Expander.BodyVisibility}" Style="{StaticResource CardSeparator}" />
            <StackPanel Visibility="{Binding Expander.BodyVisibility}">
            <!-- Editable drop-down with built-in search: typing filters the items by substring and
                 the menu opens by itself; the arrows only move the highlight and a choice
                 (Enter or click) runs git switch.
                 IsTextSearchEnabled=False leaves filtering to the ViewModel instead of jumping by
                 prefix; StaysOpenOnEdit keeps the menu open while typing. -->
            <local:BranchComboBox DataContext="{Binding BranchPicker}"
                                  ItemsSource="{Binding Branches}"
                                  SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                                  Text="{Binding BranchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsDropDownOpen="{Binding BranchDropDownOpen, Mode=TwoWay}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  Visibility="{Binding DataContext.GitActionsVisibility, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                  IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                  ToolTip="Type to search, arrows to scroll, Enter or click to switch branch (git switch)"
                                  FontFamily="Consolas" FontWeight="Normal"
                                  FontSize="13"
                                  Margin="0,6,0,0" />

            <!-- Git status and warning on the same line, centered: if space runs out the status is shortened. -->
            <DockPanel HorizontalAlignment="Center" Margin="0,6,0,0">
              <TextBlock DockPanel.Dock="Right"
                         Text="{Binding UpstreamWarning}"
                         Visibility="{Binding UpstreamWarningVisibility}"
                         Foreground="#C42B1C"
                         FontSize="12"
                         FontWeight="Bold" />
              <TextBlock DockPanel.Dock="Right"
                         Text="·"
                         Visibility="{Binding UpstreamWarningVisibility}"
                         Opacity="0.65"
                         FontSize="12"
                         Margin="5,0" />
              <TextBlock Text="{Binding RepoDetail}"
                         ToolTip="{Binding RepoDetail}"
                         Opacity="0.65"
                         FontSize="12"
                         TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- Dev tunnel, in the backend and frontend cards: a section with its own
                 header, expanding and collapsing on its own inside the card body. -->
            <StackPanel DataContext="{Binding Tunnel}"
                        Visibility="{Binding DataContext.TunnelVisibility, RelativeSource={RelativeSource AncestorType=Border}}">
              <Border Style="{StaticResource CardSeparator}" />
              <DockPanel Style="{StaticResource CardHeader}" Margin="0,8,0,0">
                <DockPanel.InputBindings>
                  <MouseBinding Gesture="LeftClick" Command="{Binding State.Expander.ToggleCommand}" />
                </DockPanel.InputBindings>
                <TextBlock DockPanel.Dock="Left" Text="{Binding State.Expander.Glyph}" Style="{StaticResource ExpanderGlyph}" />
                <TextBlock DockPanel.Dock="Left" Text="&#xE774;" Style="{StaticResource CardIcon}" />
                <!-- No commands here: the tunnel is turned on and off for the whole environment,
                     from the header. The dot is the host's status. -->
                <local:StatusDot DockPanel.Dock="Right"
                                 Color="{Binding Host.StateColor}"
                                 IsLoading="{Binding State.IsLoading}">
                  <local:StatusDot.ToolTip>
                    <StackPanel>
                      <TextBlock Text="{Binding Host.StateToolTip}" />
                      <TextBlock Text="{Binding State.Stamp}" Style="{StaticResource DotStamp}" />
                    </StackPanel>
                  </local:StatusDot.ToolTip>
                </local:StatusDot>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding State.Line}"
                           ToolTip="{Binding State.Line}"
                           Style="{StaticResource CardTitle}" />
              </DockPanel>

              <StackPanel DataContext="{Binding State}" Visibility="{Binding Expander.BodyVisibility}">
                <TextBlock Text="{Binding Detail}"
                           Visibility="{Binding DetailVisibility}"
                           Opacity="0.65"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,8,0,0" />

                <!-- One row per port: number in the badge, host without scheme (public URLs are https),
                     two buttons on the right: copy the URL and open it in the default browser.
                     The note appears only for a port that does not respond or as copy
                     feedback. -->
                <local:LaneGrid ItemsSource="{Binding Ports}"
                                Visibility="{Binding PortsVisibility}"
                                Margin="0,8,0,0">
                  <local:LaneGrid.ItemTemplate>
                    <DataTemplate>
                      <local:Lane Badge="{Binding PortNumber}" Text="{Binding Host}" Note="{Binding Note}" NoteBrush="{Binding NoteColor}">
                        <local:LaneAction Glyph="&#xE8C8;" Command="{Binding CopyCommand}" ToolTip="{Binding CopyToolTip}" />
                        <local:LaneAction Glyph="&#xE8A7;" Command="{Binding OpenCommand}" ToolTip="{Binding OpenToolTip}" />
                      </local:Lane>
                    </DataTemplate>
                  </local:LaneGrid.ItemTemplate>
                </local:LaneGrid>

                <!-- No tunnel matches the clone: the account's tunnels with a short status. -->
                <!-- Status dot, tunnel name and, in the grey note, host and ports. -->
                <local:LaneGrid ItemsSource="{Binding List}"
                                Visibility="{Binding ListVisibility}"
                                Margin="0,8,0,0">
                  <local:LaneGrid.ItemTemplate>
                    <DataTemplate>
                      <local:Lane Dot="{Binding StatusColor}" Text="{Binding Title}" ToolTip="{Binding Title}" Note="{Binding Kind}" NoteBrush="#5F6368" />
                    </DataTemplate>
                  </local:LaneGrid.ItemTemplate>
                </local:LaneGrid>
              </StackPanel>

            </StackPanel>

            <!-- Frontend preview, only in the frontend card: the playwright-cli browser open on this
                 environment's dev server port, live and usable in a 16:9 frame. The dot is
                 green when Claude's browser is there. -->
            <StackPanel DataContext="{Binding Preview}"
                        Visibility="{Binding DataContext.PreviewVisibility, RelativeSource={RelativeSource AncestorType=Border}}">
              <Border Style="{StaticResource CardSeparator}" />
              <DockPanel Style="{StaticResource CardHeader}" Margin="0,8,0,0">
                <DockPanel.InputBindings>
                  <MouseBinding Gesture="LeftClick" Command="{Binding Expander.ToggleCommand}" />
                </DockPanel.InputBindings>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Expander.Glyph}" Style="{StaticResource ExpanderGlyph}" />
                <TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" Style="{StaticResource CardIcon}" />
                <local:StatusDot DockPanel.Dock="Right"
                                 Color="{Binding SessionColor}"
                                 ToolTip="{Binding HeaderToolTip}" />
                <Button DockPanel.Dock="Right"
                        Click="OpenPreview_Click"
                        ToolTip="Expand to the whole window"
                        Style="{StaticResource IconButton}"
                        Content="&#xE740;" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding OpenExternalCommand}"
                        ToolTip="Open the page of Claude's browser in the default browser (or the dev server if there is none)"
                        Style="{StaticResource IconButton}"
                        Content="&#xE8A7;" />
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Header}"
                           ToolTip="{Binding HeaderToolTip}"
                           Style="{StaticResource CardTitle}" />
              </DockPanel>

              <!-- The Viewbox sets the maximum height: 16:9, or the frame's aspect ratio when it is
                   wider. With a frame the box shrinks to the image (a Uniform Image measures
                   only the frame's area); without one it stays full. The content is clipped to
                   the rounded corners with a mask: ClipToBounds would only clip to a
                   rectangle. -->
              <Grid Visibility="{Binding Expander.BodyVisibility}" Margin="0,8,0,0">
                <Viewbox x:Name="PreviewSizer" Stretch="Uniform">
                  <Rectangle Width="{Binding SizerWidth}" Height="{Binding SizerHeight}" />
                </Viewbox>
                <Border MaxHeight="{Binding ActualHeight, ElementName=PreviewSizer}">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource LaneFrame}">
                      <Setter Property="HorizontalAlignment" Value="Center" />
                      <Setter Property="VerticalAlignment" Value="Top" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Frame}" Value="{x:Null}">
                          <Setter Property="HorizontalAlignment" Value="Stretch" />
                          <Setter Property="VerticalAlignment" Value="Stretch" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Border x:Name="PreviewMask" CornerRadius="12" Background="{DynamicResource Theme.Field}" />
                    <Grid>
                      <Grid.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=PreviewMask}" />
                      </Grid.OpacityMask>
                      <local:PlaywrightLiveView Visibility="{Binding ClaudeViewVisibility}" />
                      <TextBlock Text="{Binding ClaudePlaceholder}"
                                 Visibility="{Binding ClaudePlaceholderVisibility}"
                                 Opacity="0.55"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Margin="12" />
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </StackPanel>

            <!-- Container log, only in the backend and frontend cards of a Docker environment:
                 it is read only while the section is open (DevToolsController.FollowContainerLogAsync). -->
            <ContentControl Content="{Binding ContainerLog}"
                            ContentTemplate="{StaticResource LogSectionTemplate}"
                            Visibility="{Binding ContainerLogVisibility}"
                            Focusable="False" />

            <!-- Migrations and contexts, only in the backend card: one section each at the bottom
                 of the body, applied migrations unknown to the code first, because they must
                 be seen before reading the context counters. -->
            <StackPanel DataContext="{Binding Migrations}"
                        Visibility="{Binding DataContext.MigrationsVisibility, RelativeSource={RelativeSource AncestorType=Border}}">
              <StackPanel Visibility="{Binding UnknownVisibility}">
                <Border Style="{StaticResource CardSeparator}" />
                <DockPanel Style="{StaticResource CardHeader}" Margin="0,8,0,0">
                  <DockPanel.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding UnknownExpander.ToggleCommand}" />
                  </DockPanel.InputBindings>
                  <TextBlock DockPanel.Dock="Left" Text="{Binding UnknownExpander.Glyph}" Style="{StaticResource ExpanderGlyph}" />
                  <TextBlock DockPanel.Dock="Left" Text="&#xE9CE;" Style="{StaticResource CardIcon}" />
                  <local:StatusDot DockPanel.Dock="Right" Color="#E76F6F" ToolTip="{Binding UnknownHeader}" />
                  <TextBlock DockPanel.Dock="Left"
                             Text="{Binding UnknownHeader}"
                             ToolTip="{Binding UnknownHeader}"
                             Style="{StaticResource CardTitle}" />
                </DockPanel>
                <local:LaneGrid ItemsSource="{Binding Unknown}" Margin="0,8,0,0" Visibility="{Binding UnknownExpander.BodyVisibility}">
                  <local:LaneGrid.ItemTemplate>
                    <DataTemplate>
                      <local:Lane Text="{Binding MigrationId}" ToolTip="{Binding MigrationId}" />
                    </DataTemplate>
                  </local:LaneGrid.ItemTemplate>
                </local:LaneGrid>
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Contexts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <Border Style="{StaticResource CardSeparator}" />
                      <!-- Clickable header: expands and collapses the section. The database update
                           starts from the migration rows, not from here. -->
                      <DockPanel Style="{StaticResource CardHeader}" Margin="0,8,0,0">
                        <DockPanel.InputBindings>
                          <MouseBinding Gesture="LeftClick" Command="{Binding Expander.ToggleCommand}" />
                        </DockPanel.InputBindings>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Expander.Glyph}" Style="{StaticResource ExpanderGlyph}" />
                        <TextBlock DockPanel.Dock="Left" Text="&#xEE94;" Style="{StaticResource CardIcon}" />
                        <!-- Green when in sync, orange with migrations to fix. -->
                        <local:StatusDot DockPanel.Dock="Right"
                                         Color="{Binding StatusColor}"
                                         IsLoading="{Binding IsLoading}">
                          <local:StatusDot.ToolTip>
                            <StackPanel>
                              <TextBlock Text="{Binding StatusToolTip}" />
                              <TextBlock Text="{Binding Stamp}" Style="{StaticResource DotStamp}" />
                            </StackPanel>
                          </local:StatusDot.ToolTip>
                        </local:StatusDot>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding Name}"
                                   ToolTip="{Binding Name}"
                                   Style="{StaticResource CardTitle}" />
                      </DockPanel>

                      <!-- Body: expanded by default only if the context is out of sync. -->
                      <StackPanel Visibility="{Binding Expander.BodyVisibility}">
                      <TextBlock Text="{Binding Note}"
                                 Visibility="{Binding NoteVisibility}"
                                 Opacity="0.65"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 Margin="0,8,0,0" />

                      <!-- Latest migrations, with the position in the context in the badge: the row's
                           button runs the update up to that migration, with confirmation. The
                           glyph tells the direction: Play forward, Undo for a rollback. -->
                      <local:LaneGrid ItemsSource="{Binding Recent}"
                                      Visibility="{Binding RecentVisibility}"
                                      Margin="0,8,0,0">
                        <local:LaneGrid.ItemTemplate>
                          <DataTemplate>
                            <local:Lane Badge="{Binding Position}" Text="{Binding Name}" Note="{Binding Note}" NoteBrush="{Binding NoteColor}">
                              <local:LaneAction Glyph="{Binding RunGlyph}" Command="{Binding RunCommand}" IsEnabled="{Binding RunEnabled}" ToolTip="{Binding RunToolTip}" />
                            </local:Lane>
                          </DataTemplate>
                        </local:LaneGrid.ItemTemplate>
                      </local:LaneGrid>

                      <StackPanel Orientation="Horizontal"
                                  HorizontalAlignment="Center"
                                  Visibility="{Binding PagerVisibility}"
                                  Margin="0,8,0,0">
                        <Button Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}"
                                ToolTip="Newer migrations"
                                Style="{StaticResource IconButton}"
                                Margin="0"
                                Content="&#xE76B;" />
                        <TextBlock Text="{Binding PageLabel}"
                                   FontSize="11"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"
                                   Margin="6,0,2,0" />
                        <Button Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoNext}"
                                ToolTip="Older migrations"
                                Style="{StaticResource IconButton}"
                                Content="&#xE76C;" />
                      </StackPanel>
                      </StackPanel>

                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            </StackPanel>

            <!-- Configuration, database, git or action errors. -->
            <local:FlashCard Kind="Error"
                             Content="{Binding ErrorLine}"
                             Visibility="{Binding ErrorVisibility}"
                             FontSize="11"
                             Margin="0,8,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Window background under the header and the cards: the brand gradient, without the
         logo. A light lavender base darkening toward the bottom right, plus three soft spots:
         light blue at the top left, pale at the top center, lilac at the bottom right. It also
         covers the header row, so the gradient shows in the rounded corners. -->
    <Grid Grid.Row="0" Grid.RowSpan="2">
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="{DynamicResource Theme.Base0}" />
            <GradientStop Offset="0.5" Color="{DynamicResource Theme.Base1}" />
            <GradientStop Offset="1" Color="{DynamicResource Theme.Base2}" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border>
        <Border.Background>
          <RadialGradientBrush Center="0.15,0.08" GradientOrigin="0.15,0.08" RadiusX="0.25" RadiusY="0.4">
            <GradientStop Offset="0" Color="{DynamicResource Theme.SpotMint}" />
            <GradientStop Offset="1" Color="{DynamicResource Theme.SpotMintClear}" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>
      <Border>
        <Border.Background>
          <RadialGradientBrush Center="0.45,0.05" GradientOrigin="0.45,0.05" RadiusX="0.3" RadiusY="0.45">
            <GradientStop Offset="0" Color="{DynamicResource Theme.SpotLight}" />
            <GradientStop Offset="1" Color="{DynamicResource Theme.SpotLightClear}" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>
      <Border>
        <Border.Background>
          <RadialGradientBrush Center="0.88,0.95" GradientOrigin="0.88,0.95" RadiusX="0.25" RadiusY="0.35">
            <GradientStop Offset="0" Color="{DynamicResource Theme.SpotWarm}" />
            <GradientStop Offset="1" Color="{DynamicResource Theme.SpotWarmClear}" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>
    </Grid>

    <!-- Ctrl+T easter egg: a pixel-art landscape over the gradient, under the header and the
         cards, with the ground on the window's bottom edge like the kitten's feet. -->
    <local:PixelScenery x:Name="Scenery" Grid.Row="0" Grid.RowSpan="2" />

    <!-- Fixed header (app row and column headers): a single card, on the same plane as the
         column cards: same background, border, radius and distance from the window edge
         (Section style), and 8 px from the first card as between cards. No shadow. Shadows
         belong to the panels, which sit on top. -->
    <Border x:Name="HeaderCard"
            Grid.Row="0"
            Margin="8,8,8,0"
            CornerRadius="20"
            Background="{DynamicResource Theme.CardBackground}"
            BorderBrush="{DynamicResource Theme.CardBorder}"
            BorderThickness="1,1,1,3"
            TextElement.Foreground="{DynamicResource Theme.Text}">
      <StackPanel>
        <!-- App row, in the spirit of the Animal Crossing phone: one button per panel (round colored
             icon and label). On the left the work panels; on the right, from left to right,
             machine resources, Setup, Refresh all and Notifications: with Dock right the first
             declared is the rightmost. Reads in progress are shown by the island at the top of
             the window. -->
        <!-- Four groups in the same grid: panels on the left, commands on the right, environment
             chips right after the panels and machine resources right before the commands. If
             they don't all fit on one row, chips and resources drop to the second, chips on the
             left and resources on the right; resources go to the third only if there is no
             room there either (TopBar_SizeChanged). -->
        <Grid x:Name="TopBar" Margin="12,10,12,10" SizeChanged="TopBar_SizeChanged">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel x:Name="TopBarLeft" Orientation="Horizontal" HorizontalAlignment="Left" SizeChanged="TopBar_SizeChanged">
          <Button x:Name="PullRequestsButton"
                  DockPanel.Dock="Left"
                  Click="OpenPullRequests_Click"
                  ToolTip="The pull requests that concern you, grouped by work item"
                  Style="{StaticResource AppButton}"
                  Tag="#3FB8A0"
                  Content="&#xE943;"
                  local:AppButton.Label="Pull request" />
          <Button DockPanel.Dock="Left"
                  Click="OpenMeeting_Click"
                  ToolTip="A timed, turn-based game to give points to user stories"
                  Style="{StaticResource AppButton}"
                  Tag="#E07A9B"
                  Content="&#xE716;"
                  local:AppButton.Label="Story points" />
          <Button x:Name="TomatoButton"
                  DockPanel.Dock="Left"
                  Click="OpenTomato_Click"
                  ToolTip="The garden's tomato timer, in a panel that doesn't stop the timer when closed"
                  Style="{StaticResource AppButton}"
                  Tag="#D9544D"
                  Content="&#xE916;"
                  local:AppButton.Label="Pomodoro" />
          </StackPanel>
          <DockPanel x:Name="TopBarRight" LastChildFill="False" HorizontalAlignment="Right" SizeChanged="TopBar_SizeChanged">
          <Button x:Name="NotificationsButton"
                  DockPanel.Dock="Right"
                  Click="OpenNotifications_Click"
                  ToolTip="New work on pull requests, until you read it"
                  Style="{StaticResource AppButton}"
                  Tag="#A98BE3"
                  Content="&#xEA8F;"
                  local:AppButton.Label="Notifications"
                  local:AppButton.Badge="{Binding Notifications.BadgeText}" />
          <Button DockPanel.Dock="Right"
                  Command="{Binding RefreshAllCommand}"
                  ToolTip="Reload all idle environments: git fetch, migrations and dev tunnels"
                  Style="{StaticResource AppButton}"
                  Tag="#7CC56A"
                  Content="&#xE72C;"
                  local:AppButton.Label="Refresh all" />
          <!-- The badge counts the dev migrations missing from the seed: sync it from the “Docker” tab. -->
          <Button x:Name="SetupButton"
                  DockPanel.Dock="Right"
                  Click="OpenSetup_Click"
                  ToolTip="App preferences (theme, kitten, background, demo), environments, repositories, Docker (seed, disk space, logs), tunnels and DevOps"
                  Style="{StaticResource AppButton}"
                  Tag="#55B7EA"
                  Content="&#xE713;"
                  local:AppButton.Label="Setup"
                  local:AppButton.Badge="{Binding Docker.MissingBadge}" />
          </DockPanel>
          <!-- Machine resources (SystemLoad: system disk and RAM): in the first row to the left of
               Setup, or on the right in the chips row when the first one is not enough
               (TopBar_SizeChanged). The shape of the app buttons, but flat, with no lip and a
               thin border, so it doesn't look clickable. The filled bar is the used part, the
               empty track the free part; GB values and free percentages are in the tooltip.
               The source is static: it stays even when the Ctrl+D demo changes the DataContext. -->
          <Grid x:Name="TopBarMeter"
                Height="34"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                SizeChanged="TopBar_SizeChanged"
                DataContext="{x:Static local:SystemLoad.Current}"
                ToolTip="{Binding ToolTip}"
                ToolTipService.InitialShowDelay="200"
                TextElement.Foreground="{DynamicResource Theme.TextSoft}">
            <Border CornerRadius="13" Background="{DynamicResource Theme.MeterTrack}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
              <TextBlock Text="{Binding DiskLabel}" Style="{StaticResource MeterLabel}" />
              <ProgressBar Value="{Binding DiskPercent, Mode=OneWay}" Foreground="{Binding DiskBrush}" Style="{StaticResource Meter}" />
              <TextBlock Text="{Binding DiskText}" Style="{StaticResource MeterValue}" />
              <Border Width="1" Height="14" Background="{DynamicResource Theme.MeterSeparator}" Margin="10,0" />
              <TextBlock Text="RAM" Style="{StaticResource MeterLabel}" />
              <ProgressBar Value="{Binding RamPercent, Mode=OneWay}" Foreground="{Binding RamBrush}" Style="{StaticResource Meter}" />
              <TextBlock Text="{Binding RamText}" Style="{StaticResource MeterValue}" />
            </StackPanel>
          </Grid>
          <StackPanel x:Name="TopBarChips" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" SizeChanged="TopBar_SizeChanged">
          <!-- One chip per environment, always visible even when scrolling the columns horizontally.
               From the left: number, status dot (pulsing light blue while the environment reads
               or the containers start) and the environment markers only when they apply: a
               purple layer stack for Docker, a red padlock for the protected database, a teal
               check if every repository is on dev.
               The background only tells whether the column is shown (warm beige, raised) or
               hidden (slate, flat).
               Hovering opens the environment's card (ChipCard, at the bottom of the window). A
               click shows or hides the column; showing it scrolls it into view. -->
          <ItemsControl ItemsSource="{Binding Environments}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Click="StatusChip_Click"
                        MouseEnter="StatusChip_MouseEnter"
                        MouseLeave="ChipCard_MouseLeave"
                        AutomationProperties.Name="{Binding Title}"
                        AutomationProperties.HelpText="{Binding StatusLine}"
                        Margin="0,0,5,0"
                        Padding="8,1,9,0">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                      <Style.Triggers>
                        <!-- Hidden column: flat chip, without the buttons' lip and sheen, with a thin
                             border; the hover veil stays so it is clear that it can be clicked. -->
                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Theme.ChipHidden}" />
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="Button">
                                <Grid>
                                  <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Theme.ChipHiddenBorder}" BorderThickness="1" CornerRadius="{DynamicResource ButtonRadius}" />
                                  <Border x:Name="Veil" Background="White" Opacity="0" CornerRadius="{DynamicResource ButtonRadius}" />
                                  <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Veil" Property="Opacity" Value="0.3" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Number}" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    <local:StatusDot Color="{Binding StatusColor}" IsLoading="{Binding IsHeaderBusy}" DotSize="8" Width="8" Height="8" Margin="6,0,0,0" />
                    <TextBlock Text="&#xE81E;" Visibility="{Binding KindBadgeVisibility}" Foreground="{DynamicResource Theme.DockerTagText}" Style="{StaticResource ChipGlyph}" />
                    <TextBlock Text="&#xE72E;" Visibility="{Binding ProtectedDatabaseVisibility}" Foreground="{DynamicResource Theme.ProtectedDatabaseTagText}" Style="{StaticResource ChipGlyph}" />
                    <TextBlock Text="&#xE930;" Visibility="{Binding SunsetVisibility}" Foreground="{DynamicResource Theme.ChipSunset}" Style="{StaticResource ChipGlyph}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- After the environment chips: opens the Docker environment creation pane. -->
          <Button x:Name="NewDockerButton"
                  DockPanel.Dock="Left"
                  Click="OpenDocker_Click"
                  Visibility="{Binding NewDockerVisibility}"
                  ToolTip="New Docker environment: worktrees from the source clones, database from the seed and the slot's containers"
                  Style="{StaticResource TextButton}"
                  Margin="0"
                  VerticalAlignment="Center"
                  FontWeight="Bold"
                  Content="+" />
          <TextBlock DockPanel.Dock="Left"
                     Text="{Binding DemoBanner}"
                     Foreground="{DynamicResource Theme.TagText}"
                     FontWeight="Bold"
                     FontSize="13"
                     VerticalAlignment="Center"
                     Margin="12,0,0,0" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- A single scroll for all columns, environment cards included: they scroll together, and the
         grid row is as tall as the longest column. The scrollbar appears only if there is
         something to scroll. Horizontally the grid is as wide as the viewport, but never less
         than ColumnsMinWidth (MinWidth wins over Width): below that threshold the columns don't
         shrink and the horizontal scroll appears. -->
    <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextElement.Foreground="{DynamicResource Theme.Text}">
      <ItemsControl x:Name="BodyColumns"
                    ItemsSource="{Binding Environments}"
                    MinWidth="{Binding ColumnsMinWidth}"
                    Width="{Binding ViewportWidth, ElementName=BodyScroll}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <local:ColumnsPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="local:ColumnsPanel.IsCollapsed" Value="{Binding IsCollapsed}" />
            <Setter Property="Visibility" Value="{Binding ColumnVisibility}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- The first row is the environment card, as tall as its content: each column has
                 its own. A hidden column disappears entirely and reopens from its chip in the header. -->
            <Grid x:Name="Column"
                  Margin="8,8,8,3"
                  local:CardTint.AllOnDev="{Binding AllOnDev}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
                <!-- The environment card, at the top of the column: name, dot, activity, environment
                     actions, eye to hide the column, and note. -->
                <Border Style="{StaticResource Section}" Visibility="{Binding ColumnVisibility}" local:CardBusy.IsBusy="{Binding IsHeaderBusy}">
                  <StackPanel>
                    <DockPanel Style="{StaticResource CardHeader}" Cursor="Arrow">
                      <!-- Pulsing light blue while the environment reads, runs an action or (Docker) the
                           containers start; red if a container is in error. -->
                      <local:StatusDot DockPanel.Dock="Right"
                                       Color="{Binding StatusColor}"
                                       IsLoading="{Binding IsHeaderBusy}"
                                       ToolTip="{Binding StatusLine}" />
                      <Button DockPanel.Dock="Right"
                              Command="{Binding ToggleCollapseCommand}"
                              ToolTip="Hide the column: reopen it from its number in the header"
                              Style="{StaticResource IconButton}"
                              Content="&#xED1A;" />
                      <Button DockPanel.Dock="Right"
                              Command="{Binding RefreshCommand}"
                              ToolTip="Reload the environment, run git fetch and query the dev tunnels"
                              Style="{StaticResource IconButton}"
                              Content="&#xE72C;" />
                      <!-- Environment start/stop: Kestrel, dev server and tunnel hosts of all the
                           cards; stop also stops the app and Metro, start does not (see DevToolsController). -->
                      <Button DockPanel.Dock="Right"
                              Command="{Binding Tools.Stack.ToggleCommand}"
                              IsEnabled="{Binding Tools.Stack.ToggleEnabled}"
                              ToolTip="{Binding Tools.Stack.ToggleToolTip}"
                              ToolTipService.ShowOnDisabled="True"
                              Tag="{Binding Tools.Stack.IsStop}"
                              Style="{StaticResource ServiceToggle}"
                              Content="{Binding Tools.Stack.ToggleGlyph}" />
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="ExtraBold" FontSize="15" Foreground="{DynamicResource Theme.TextStrong}" VerticalAlignment="Center" />
                      <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource EnvironmentTags}" Focusable="False" IsTabStop="False" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- Only in Docker environments: docker not responding and warnings about the slot's env files (names, never values). -->
                    <local:FlashCard Kind="Error"
                                     Content="{Binding Docker.UnreachableText}"
                                     Visibility="{Binding Docker.UnreachableVisibility, FallbackValue=Collapsed}"
                                     FontSize="11"
                                     Margin="0,6,0,0" />
                    <local:FlashCard Kind="Warning"
                                     Content="{Binding Docker.EnvWarningText}"
                                     Visibility="{Binding Docker.EnvWarningVisibility, FallbackValue=Collapsed}"
                                     FontSize="11"
                                     Margin="0,6,0,0" />
                    <!-- Free-form environment note, shared with the VSIX: typed here, it saves
                         itself. The placeholder sits under the transparent box. -->
                    <Border Margin="0,6,0,2" CornerRadius="10" Background="{DynamicResource Theme.Note}">
                      <Grid>
                        <!-- While typing the placeholder disappears: the centered caret would land in the middle of it. -->
                        <TextBlock Text="Note"
                                   Visibility="{Binding NotePlaceholderVisibility}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NotePlaceholder}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=NoteInput}" Value="True">
                                  <Setter Property="Opacity" Value="0" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="NoteInput"
                                 Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NoteBox}" />
                      </Grid>
                    </Border>
                    <!-- Secondary actions under the note: the header keeps only start/stop, reload and
                         eye, so name, tags and status have room. The tunnel switch is on the left,
                         the actions on the right. -->
                    <DockPanel LastChildFill="False" Margin="0,6,0,0">
                      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <!-- The environment's tunnel: when checked, the environment has a pool tunnel with a
                             port for each repository that exposes one. -->
                        <TextBlock Text="Tunnel"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.TextStrong}"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding TunnelToolTip}"
                                   Margin="0" />
                        <CheckBox Style="{StaticResource Switch}"
                                  IsChecked="{Binding TunnelOn, Mode=OneWay}"
                                  Command="{Binding TunnelCommand}"
                                  IsEnabled="{Binding TunnelEnabled}"
                                  ToolTip="{Binding TunnelToolTip}"
                                  ToolTipService.ShowOnDisabled="True"
                                  VerticalAlignment="Center"
                                  Margin="6,0,4,0" />
                      </StackPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- Only in Docker environments: “Destroy environment” and “Repair env”. The env files of local
                             environments realign by themselves on every full reload (EnvironmentController.Refresh). -->
                        <Button Command="{Binding Docker.DestroyCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Visibility="{Binding KindBadgeVisibility}"
                                ToolTip="Destroy the environment: containers and database volume, worktrees (only if they have no code to lose), slot folder, api and web images, pool ports and entry. Branches and the note remain"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource TextButton}"
                                Content="Destroy environment" />
                        <Button Command="{Binding Docker.RepairEnvCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Visibility="{Binding KindBadgeVisibility}"
                                ToolTip="Rewrite the worktrees' env files and the containers' env_file from the configuration; values set by hand that the slot cannot compute are kept"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource TextButton}"
                                Content="Repair env" />
                        <!-- Reset: same logic as the PR checkout, with every repository on dev. -->
                        <Button Command="{Binding ResetCommand}"
                                ToolTip="Stop the whole environment, app included, and if the repositories are clean bring them back to dev with a pull"
                                Style="{StaticResource TextButton}"
                                Content="Reset to dev" />
                      </StackPanel>
                    </DockPanel>
                    <!-- Only in Docker environments: the environment's operations log
                         (create, start, stop, repair env, destroy). -->
                    <ContentControl Content="{Binding OperationLog}"
                                    ContentTemplate="{StaticResource LogSectionTemplate}"
                                    Visibility="{Binding KindBadgeVisibility}"
                                    Focusable="False" />
                  </StackPanel>
                </Border>
                <!-- The catalog cards the environment includes, in catalog order. -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Repos}" ItemTemplate="{StaticResource RepoCardTemplate}" Visibility="{Binding ColumnVisibility}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Ctrl+G easter egg: above the content, with its feet on the window's bottom edge. -->
    <local:PixelCat x:Name="Cat" Grid.Row="1" VerticalAlignment="Bottom" Panel.ZIndex="2" />

    <!-- Pull requests panel: a card floating on one side (left at startup, “Switch side” moves it:
         MainWindow.SwitchPullRequestsSide), above the header and the columns (which don't shrink
         below 480 px each: a side-by-side panel would make them scroll), detached from the
         edges. The DataContext is its ViewModel, assigned by the window: the Ctrl+D demo does
         not touch it. Scale and translation serve the opening animation
         (MainWindow.ShowPullRequests). -->
    <local:PullRequestsPanel x:Name="PullRequests"
                             Grid.Row="0"
                             Grid.RowSpan="2"
                             Width="620"
                             Margin="8,8,0,8"
                             HorizontalAlignment="Left"
                             Visibility="Collapsed"
                             RenderTransformOrigin="0,0"
                             Panel.ZIndex="2">
      <local:PullRequestsPanel.RenderTransform>
        <TransformGroup>
          <ScaleTransform />
          <TranslateTransform />
        </TransformGroup>
      </local:PullRequestsPanel.RenderTransform>
    </local:PullRequestsPanel>

    <!-- Pomodoro panel: a card floating on the left side like the PRs, with the tomato timer in
         a WebView2. Closing it makes it transparent and not clickable but does not hide it
         (MainWindow.HideTomato): for Chromium the page stays visible and the timer is not
         throttled. -->
    <local:TomatoPanel x:Name="Tomato"
                       Grid.Row="0"
                       Grid.RowSpan="2"
                       Width="620"
                       Margin="8,8,0,8"
                       HorizontalAlignment="Left"
                       Visibility="Collapsed"
                       RenderTransformOrigin="0,0"
                       Panel.ZIndex="2">
      <local:TomatoPanel.RenderTransform>
        <TransformGroup>
          <ScaleTransform />
          <TranslateTransform />
        </TransformGroup>
      </local:TomatoPanel.RenderTransform>
    </local:TomatoPanel>

    <!-- Notifications panel: a card floating on the right side, with the same animations as the
         PR panel. The two are never open together: if the PRs moved to the right they would
         overlap. The window assigns the DataContext (real or demo). -->
    <local:NotificationsPanel x:Name="Notifications"
                              Grid.Row="0"
                              Grid.RowSpan="2"
                              Width="460"
                              Margin="0,8,8,8"
                              HorizontalAlignment="Right"
                              Visibility="Collapsed"
                              RenderTransformOrigin="1,0"
                              Panel.ZIndex="2">
      <local:NotificationsPanel.RenderTransform>
        <TransformGroup>
          <ScaleTransform />
          <TranslateTransform />
        </TransformGroup>
      </local:NotificationsPanel.RenderTransform>
    </local:NotificationsPanel>

    <!-- The “+” pane “New Docker environment”: floating on the right like the notifications, never
         open together with them, as tall as its content. -->
    <local:DockerPanel x:Name="Docker"
                       DataContext="{Binding Docker}"
                       Grid.Row="0"
                       Grid.RowSpan="2"
                       Width="520"
                       Margin="0,8,8,8"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Visibility="Collapsed"
                       RenderTransformOrigin="1,0"
                       Panel.ZIndex="2">
      <local:DockerPanel.RenderTransform>
        <TransformGroup>
          <ScaleTransform />
          <TranslateTransform />
        </TransformGroup>
      </local:DockerPanel.RenderTransform>
    </local:DockerPanel>

    <!-- No environments configured (first run): instead of the columns, an invitation to the setup. -->
    <StackPanel Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding EmptyVisibility}">
      <TextBlock Text="No environments configured" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Theme.TextStrong}" HorizontalAlignment="Center" />
      <TextBlock Text="Open the setup to choose repositories, folders and the number of environments." Opacity="0.7" Margin="0,4,0,0" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- Setup: a large card in the center, above everything, with a veil separating it from the
         columns. A click on the veil does not close it: there is unsaved work inside. -->
    <Border x:Name="SetupBackdrop"
            Grid.Row="0"
            Grid.RowSpan="2"
            Background="#66352A1C"
            Visibility="Collapsed"
            Panel.ZIndex="5">
      <local:SetupPanel x:Name="Setup"
                        MaxWidth="1100"
                        Margin="32,24" />
    </Border>

    <!-- Story points meeting: covers the whole window, header included, because it is shown on
         a TV. The veil stays as a frame a few pixels wide and does not close it on click: in a
         meeting a wrong click must not make the timer disappear. The window assigns the
         DataContext (real or demo). -->
    <Border x:Name="MeetingBackdrop"
            Grid.Row="0"
            Grid.RowSpan="2"
            Background="#66352A1C"
            Visibility="Collapsed"
            Panel.ZIndex="5">
      <local:StoryPointsMeetingPanel x:Name="Meeting" Margin="8" />
    </Border>

    <!-- Reads in progress: the island rises from the bottom left, above the columns and below the
         panels. With the mouse over it, it slides to the right side, and from there back to the
         left: it never covers what you are looking at. -->
    <local:LoadingIsland Grid.Row="1"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="18,0,18,14"
                         FromBottom="True"
                         DodgesMouse="True"
                         Panel.ZIndex="4" />

    <!-- Card of a header chip: it appears when hovering the chip, centered below it, and stays
         open while the mouse moves from the chip to the card (MainWindow.xaml.cs, ChipCard_*).
         It looks like the environment card: name, tags, status dot and note (read-only), then
         the branches of each present repository in a LaneGrid and the button that shows or hides
         the column. The DataContext is the chip's environment. -->
    <Popup x:Name="ChipCard"
           AllowsTransparency="True"
           StaysOpen="True"
           Placement="Custom"
           PopupAnimation="Fade"
           Focusable="False">
      <Border Style="{StaticResource Section}"
              local:CardTint.AllOnDev="{Binding AllOnDev}"
              Margin="12,2,12,16"
              Padding="14,8,14,12"
              MinWidth="340"
              MaxWidth="480"
              TextElement.Foreground="{DynamicResource Theme.Text}"
              MouseEnter="ChipCard_MouseEnter"
              MouseLeave="ChipCard_MouseLeave">
        <Border.Effect>
          <DropShadowEffect Direction="270" ShadowDepth="3" BlurRadius="14" Opacity="0.2" Color="#5C4A2A" />
        </Border.Effect>
        <StackPanel>
          <DockPanel Style="{StaticResource CardHeader}" Cursor="Arrow">
            <local:StatusDot DockPanel.Dock="Right" Color="{Binding StatusColor}" IsLoading="{Binding IsHeaderBusy}" ToolTip="{Binding StatusLine}" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="ExtraBold" FontSize="15" Foreground="{DynamicResource Theme.TextStrong}" VerticalAlignment="Center" />
            <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource EnvironmentTags}" Focusable="False" IsTabStop="False" VerticalAlignment="Center" />
          </DockPanel>

          <Border Margin="0,6,0,2" CornerRadius="10" Background="{DynamicResource Theme.Note}">
            <Grid>
              <TextBlock Text="No note" Visibility="{Binding NotePlaceholderVisibility}" Style="{StaticResource NotePlaceholder}" />
              <TextBox Text="{Binding Note, Mode=OneWay}"
                       Style="{StaticResource NoteBox}"
                       IsReadOnly="True"
                       IsHitTestVisible="False"
                       Focusable="False" />
            </Grid>
          </Border>

          <!-- Branch of each present repository, in the cards' standard grid: the repository
               in the badge, the branch as text. -->
          <local:LaneGrid ItemsSource="{Binding ChipBranches}" Margin="0,8,0,0">
            <local:LaneGrid.ItemTemplate>
              <DataTemplate>
                <local:Lane Badge="{Binding Repository}" Text="{Binding Branch}" ToolTip="{Binding Branch}" />
              </DataTemplate>
            </local:LaneGrid.ItemTemplate>
          </local:LaneGrid>

          <Button HorizontalAlignment="Right" Margin="0,8,0,0" Click="ChipCardToggle_Click">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                <Setter Property="Content" Value="Hide environment" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter Property="Content" Value="Show environment" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Enlarged environment preview: covers the header and the columns. -->
    <local:PreviewOverlay x:Name="Overlay" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="3" />
  </Grid>
</Window>
