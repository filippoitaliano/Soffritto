<!-- Le sezioni riprendono quelle della VSIX (UI/StatusControl.xaml): stesse righe e solo i
     contenuti (migrazioni, porte, errori) cambiano altezza. A differenza della VSIX, l'exe non
     scrive stato e «aggiornato HH:mm:ss» sotto le card: stanno nel tooltip del pallino. Le icone sono glifi Segoe Fluent Icons
     al posto dei KnownMonikers, che fuori da Visual Studio non esistono.
     Il colore #26808080 e' un grigio traslucido usato per i separatori. -->
<Window x:Class="Soffritto.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Soffritto.Desktop"
        Title="{Binding WindowTitle}"
        Width="1900"
        Height="950"
        MinWidth="1100"
        MinHeight="600"
        WindowState="Maximized"
        UseLayoutRounding="True"
        FontSize="14"
        FontFamily="{StaticResource Rounded}"
        FontWeight="SemiBold"
        Foreground="{DynamicResource Theme.Text}"
        Background="{DynamicResource Theme.WindowBackground}">
  <Window.Resources>
    <!-- Avvia/ferma dei servizi (Tag = IsStop del gruppo): grigio standard quando avvia, viola
         pieno quando ferma, cosi' cio' che e' acceso e va fermato si vede a colpo d'occhio senza
         il peso del rosso delle segnalazioni; il glifo bianco sopra sta a circa 4.6:1. Il
         template e' quello di IconButton con l'hover che scurisce il viola invece del grigio. -->
    <Style x:Key="ServiceToggle" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Background" Value="#8764B8" />
          <Setter Property="Foreground" Value="White" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Riquadro delle risorse della macchina nella testata: etichetta, barra e valore. -->
    <Style x:Key="MeterLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MeterValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Meter" TargetType="ProgressBar">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Margin" Value="6,1,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="4" Background="{DynamicResource Theme.MeterBar}" />
              <Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="BadgeGlyph" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,-1,0,0" />
    </Style>

    <!-- Tag della copia intera: gli stessi colori di Tag gia' composti sul bianco della card,
         ma pieni, perche' sopra i pulsanti un tag traslucido li lascerebbe trasparire. -->
    <Style x:Key="OpaqueTag" TargetType="Border" BasedOn="{StaticResource Tag}">
      <Setter Property="Background" Value="{DynamicResource Theme.OpaqueTagBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.OpaqueTagBorder}" />
    </Style>

    <!-- Copia intera dei tag sopra la riga, nella stessa posizione dei tag veri: senza fondo ne'
         ombra, solo i tag, in dissolvenza col mouse sulla riga. -->
    <Style x:Key="TagsOverlay" TargetType="Border">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Seconda riga dei tooltip dei pallini: «aggiornato HH:mm:ss» in piccolo e in grigio; vuota sparisce. -->
    <Style x:Key="DotStamp" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
        <Trigger Property="Text" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Nota dell'intestazione di colonna: post-it tratteggiato alto almeno due righe, testo
         centrato in orizzontale e in verticale, fino a quattro righe visibili e poi scroll. Il
         bordo diventa verde pieno mentre si scrive. L'altezza minima sta sulla casella e non sulle
         righe (MinLines): con MinLines l'area del testo sarebbe alta due righe e una nota di una
         riga resterebbe in alto. Fondo trasparente perche' sotto c'e' il segnaposto, centrato
         allo stesso modo. -->
    <Style x:Key="NoteBox" TargetType="TextBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="MaxLines" Value="4" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}" />
      <Setter Property="BorderBrush" Value="#26808080" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="ToolTip" Value="Nota dell'ambiente: si salva da sola ed e' la stessa nella VSIX" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid Background="{TemplateBinding Background}">
              <Rectangle x:Name="Frame"
                         RadiusX="10"
                         RadiusY="10"
                         Stroke="{DynamicResource Theme.NoteFrame}"
                         StrokeThickness="1.2"
                         StrokeDashArray="4 3"
                         SnapsToDevicePixels="True" />
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Stroke" Value="{DynamicResource Theme.NoteFrameHover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="Stroke" Value="#3E9B78" />
                <Setter TargetName="Frame" Property="StrokeDashArray" Value="{x:Null}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tag dell'intestazione di un ambiente: database protetto per primo, poi Docker, database e
         server del backend predefinito. Ogni tag sta a 4 px dal precedente e il gruppo a 4 px dal
         titolo, cosi' il primo visibile e' sempre a 8 px. Li usano la card dell'ambiente e la scheda
         del suo chip nella testata. -->
    <DataTemplate x:Key="EnvironmentTags">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
        <!-- Ambiente locale con database protetto: le migrazioni si leggono ma non si applicano. -->
        <Border Visibility="{Binding ProtectedDatabaseVisibility}" ToolTip="{Binding ProtectedDatabaseToolTip}">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Tag}">
              <Setter Property="Margin" Value="4,0,0,0" />
              <Setter Property="Background" Value="#26DC2626" />
              <Setter Property="BorderBrush" Value="#80DC2626" />
              <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.ProtectedDatabaseTagText}" />
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding ProtectedDatabaseTag}" Style="{StaticResource TagText}" />
        </Border>
        <Border Visibility="{Binding KindBadgeVisibility}"
                ToolTip="Ambiente Docker: worktree dai cloni sorgente, api, web e database nei container dello slot">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Tag}">
              <Setter Property="Margin" Value="4,0,0,0" />
              <Setter Property="Background" Value="#1A7C3AED" />
              <Setter Property="BorderBrush" Value="#4D7C3AED" />
              <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.DockerTagText}" />
            </Style>
          </Border.Style>
          <TextBlock Text="Docker" Style="{StaticResource TagText}" />
        </Border>
        <!-- Database e server del backend predefinito dell'ambiente, letti dagli
             appsettings. In un ambiente Docker il server e' sempre il container dello
             slot e non si mostra. Arancione, ognuno per conto suo, il tag il cui nome
             la configurazione chiede di evidenziare (highlightedTags del backend). -->
        <Border Visibility="{Binding DatabaseTagVisibility}" ToolTip="{Binding DatabaseTagToolTip}">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Tag}">
              <Setter Property="Margin" Value="4,0,0,0" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDatabaseHighlighted}" Value="True">
                  <Setter Property="Background" Value="#26F59E0B" />
                  <Setter Property="BorderBrush" Value="#80D97706" />
                  <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.HighlightTagText}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding DatabaseTag}" Style="{StaticResource TagText}" />
        </Border>
        <Border Visibility="{Binding ServerTagVisibility}" ToolTip="{Binding ServerTagToolTip}">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Tag}">
              <Setter Property="Margin" Value="4,0,0,0" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsServerHighlighted}" Value="True">
                  <Setter Property="Background" Value="#26F59E0B" />
                  <Setter Property="BorderBrush" Value="#80D97706" />
                  <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.HighlightTagText}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding ServerTag}" Style="{StaticResource TagText}" />
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- Stesso aspetto dei microtesti grigi delle card (lo stato git sotto la tendina). -->
    <Style x:Key="NotePlaceholder" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Ogni sezione della colonna e' una card come quelle del pannello delle PR: angoli ampi,
         bordo appena accennato, staccata dalla successiva di 8 px. Sopra e sotto il padding e'
         piu' corto che ai lati perche' la riga dell'intestazione (26 px) aggiunge gia' aria.
         Padding verticale, margine del separatore e margine delle intestazioni annidate valgono
         tutti 8 px: cosi' ogni riga di intestazione ha la stessa aria sopra e sotto ed e'
         centrata nella sua fascia.
         Effetto vetro opaco leggero: bianco al 97-95% che lascia appena trasparire il gradiente.
         WPF non sfoca lo sfondo dietro un elemento, quindi l'opacita' resta alta per tenere
         leggibile il testo anche sopra il paesaggio di Ctrl+T. -->
    <Style x:Key="Section" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Theme.CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardBorder}" />
      <Setter Property="BorderThickness" Value="1,1,1,3" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Style.Triggers>
        <!-- Ambiente tutto su dev, di solito inutilizzato: la card e' piena come le altre ma con
             un tramonto appena accennato, pesca in alto a sinistra che sfuma nel rosa in basso a
             destra, cosi' sembra "a riposo" accanto al bianco caldo degli ambienti in uso senza
             l'aria di cosa disabilitata. -->
        <Trigger Property="local:CardTint.AllOnDev" Value="True">
          <Setter Property="Background" Value="{DynamicResource Theme.CardBackgroundAllOnDev}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardBorderAllOnDev}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Separatore tra intestazione e corpo di una card, da bordo a bordo come nel pannello
         delle PR: i margini negativi annullano il padding laterale della Section. Segue la
         visibilita' del corpo, cosi' a card chiusa non resta una riga orfana. -->
    <Style x:Key="CardSeparator" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Theme.Separator}" />
      <Setter Property="Margin" Value="-14,8,-14,0" />
    </Style>

    <!-- Freccia di apertura delle card: l'intestazione intera e' cliccabile (MouseBinding), i
         bottoni che contiene gestiscono il proprio clic e non la aprono. -->
    <Style x:Key="ExpanderGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Width" Value="12" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- Intestazione delle card: stessa altezza minima con o senza bottoni, cosi' freccia,
         icona, titolo e pallino stanno sulla stessa linea in tutte le card. -->
    <Style x:Key="CardHeader" TargetType="DockPanel">
      <Setter Property="LastChildFill" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="26" />
    </Style>

    <!-- Larghezza fissa: icone diverse non spostano il titolo. -->
    <Style x:Key="CardIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Width" Value="16" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Sezione «Log» chiusa di default (LogSectionViewModel): log del container nella card del
         repository, log delle operazioni nella card dell'ambiente Docker. Il testo si seleziona e
         si copia; a sezione aperta resta sull'ultima riga se chi legge e' in fondo. -->
    <DataTemplate x:Key="LogSectionTemplate">
      <StackPanel>
        <Border Style="{StaticResource CardSeparator}" />
        <DockPanel Style="{StaticResource CardHeader}" Margin="0,8,0,0">
          <DockPanel.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{Binding Expander.ToggleCommand}" />
          </DockPanel.InputBindings>
          <TextBlock DockPanel.Dock="Left" Text="{Binding Expander.Glyph}" Style="{StaticResource ExpanderGlyph}" />
          <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" Style="{StaticResource CardIcon}" />
          <Button DockPanel.Dock="Right"
                  Command="{Binding ConsoleCommand}"
                  Visibility="{Binding ConsoleVisibility}"
                  ToolTip="{Binding ConsoleToolTip}"
                  Style="{StaticResource IconButton}"
                  Content="&#xE756;" />
          <TextBlock DockPanel.Dock="Right"
                     Text="{Binding State}"
                     ToolTip="{Binding State}"
                     Opacity="0.6"
                     FontSize="11"
                     MaxWidth="260"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     Margin="8,0,0,0" />
          <TextBlock DockPanel.Dock="Left" Text="{Binding Header}" Style="{StaticResource CardTitle}" />
        </DockPanel>
        <TextBox Visibility="{Binding Expander.BodyVisibility}"
                 Text="{Binding Text, Mode=OneWay}"
                 local:LogAutoScroll.IsEnabled="True"
                 Style="{StaticResource LogBox}"
                 MinHeight="60"
                 Margin="0,8,0,0" />
      </StackPanel>
    </DataTemplate>

    <!-- Una card per repository: sezione git con fetch, pull, pulizia branch e tendina, poi il
         riquadro errori. Clone e branch non hanno un'intestazione propria: si leggono gia' dalla
         riga del repository e dalla tendina. -->
    <DataTemplate x:Key="RepoCardTemplate">
      <Border Style="{StaticResource Section}" local:CardBusy.IsBusy="{Binding IsBusyVisual}">
        <StackPanel>
          <StackPanel Visibility="{Binding MissingVisibility}">
            <TextBlock Text="{Binding RepoLine}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding RepoDetail}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
          </StackPanel>

          <StackPanel Visibility="{Binding ContentVisibility}">
            <!-- Pull resta in fast-forward only: e' git a rifiutare quando non e' un
                 fast-forward, per questo il pulsante puo' stare sempre visibile. -->
            <DockPanel Style="{StaticResource CardHeader}">
              <DockPanel.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding Expander.ToggleCommand}" />
              </DockPanel.InputBindings>
              <!-- Stato: verde acceso, arancio solo console aperta, grigio spento, azzurro
                   pulsante mentre si legge il repository. In ogni intestazione il pallino e' il
                   primo elemento ancorato a destra, quindi sta sul bordo della card, dopo i
                   bottoni: lo stato si legge sempre nello stesso punto. L'host del tunnel ha il
                   suo pallino nella sezione del tunnel, nel corpo delle card di backend e frontend. -->
              <local:StatusDot DockPanel.Dock="Right"
                               Color="{Binding Tool.StateColor}"
                               IsLoading="{Binding IsLoading}">
                <local:StatusDot.ToolTip>
                  <StackPanel>
                    <TextBlock Text="{Binding Tool.StateToolTip}" />
                    <TextBlock Text="{Binding RepoStamp}" Style="{StaticResource DotStamp}" />
                  </StackPanel>
                </local:StatusDot.ToolTip>
              </local:StatusDot>
              <TextBlock DockPanel.Dock="Left" Text="{Binding Expander.Glyph}" Style="{StaticResource ExpanderGlyph}" />
              <TextBlock DockPanel.Dock="Left" Text="&#xEA68;" FontFamily="{StaticResource Codicons}" FontSize="16" Style="{StaticResource CardIcon}" />
              <Button DockPanel.Dock="Right"
                      Command="{Binding PullCommand}"
                      Visibility="{Binding GitActionsVisibility}"
                      ToolTip="{Binding PullToolTip}"
                      IsEnabled="{Binding IsNotBusy}"
                      Style="{StaticResource IconButton}"
                      FontFamily="{StaticResource Codicons}" FontSize="16"
                      Content="&#xEA9A;" />
              <Button DockPanel.Dock="Right"
                      Command="{Binding FetchCommand}"
                      Visibility="{Binding GitActionsVisibility}"
                      ToolTip="git fetch — aggiorna i remote-tracking ref e rilegge lo stato del repository"
                      IsEnabled="{Binding IsNotBusy}"
                      Style="{StaticResource IconButton}"
                      FontFamily="{StaticResource Codicons}" FontSize="16"
                      Content="&#xF101;" />
              <Button DockPanel.Dock="Right"
                      Command="{Binding PruneCommand}"
                      Visibility="{Binding GitActionsVisibility}"
                      ToolTip="Elimina i branch locali il cui branch remoto non esiste piu' (chiede conferma)"
                      IsEnabled="{Binding IsNotBusy}"
                      Style="{StaticResource IconButton}"
                      Content="&#xE74D;" />
              <!-- L'editor (Visual Studio o VS Code, lo dice il tooltip) e' la prima azione dopo quelle di git. -->
              <Button DockPanel.Dock="Right"
                      Command="{Binding Tool.OpenCommand}"
                      ToolTip="{Binding Tool.OpenToolTip}"
                      Style="{StaticResource IconButton}"
                      Content="&#xE943;" />
              <!-- Avvia e ferma sono lo stesso bottone: il glifo dice cosa fara', rosso se ferma. -->
              <Button DockPanel.Dock="Right"
                      Command="{Binding Tool.ToggleCommand}"
                      Visibility="{Binding Tool.ToggleVisibility}"
                      IsEnabled="{Binding Tool.ToggleEnabled}"
                      ToolTip="{Binding Tool.ToggleToolTip}"
                      ToolTipService.ShowOnDisabled="True"
                      Tag="{Binding Tool.IsStop}"
                      Style="{StaticResource ServiceToggle}"
                      Content="{Binding Tool.ToggleGlyph}" />
              <Button DockPanel.Dock="Right"
                      Command="{Binding Tool.SideCommand}"
                      Visibility="{Binding Tool.SideIconVisibility}"
                      IsEnabled="{Binding Tool.SideEnabled}"
                      ToolTip="{Binding Tool.SideToolTip}"
                      ToolTipService.ShowOnDisabled="True"
                      Style="{StaticResource IconButton}"
                      Content="{Binding Tool.SideGlyph}" />
              <Button DockPanel.Dock="Right"
                      Command="{Binding Tool.SideCommand}"
                      Visibility="{Binding Tool.SideTextVisibility}"
                      IsEnabled="{Binding Tool.SideEnabled}"
                      ToolTip="{Binding Tool.SideToolTip}"
                      ToolTipService.ShowOnDisabled="True"
                      Style="{StaticResource TextButton}"
                      Content="{Binding Tool.SideText}" />
              <Button DockPanel.Dock="Right"
                      Command="{Binding Tool.ExtraCommand}"
                      Visibility="{Binding Tool.ExtraVisibility}"
                      ToolTip="{Binding Tool.ExtraToolTip}"
                      Style="{StaticResource TextButton}"
                      Content="{Binding Tool.ExtraText}" />
              <TextBlock DockPanel.Dock="Left"
                         Text="{Binding RepoLine}"
                         ToolTip="{Binding RepoToolTip}"
                         Style="{StaticResource CardTitle}" />
              <!-- Il tag della card: l'id del catalogo, solo per i repository non predefiniti (dice
                   quale dei due backend e' questo). Database e server stanno sulla card
                   dell'ambiente. Nella riga i tag si tagliano; al passaggio del mouse
                   una copia intera compare sopra i pulsanti (Canvas, che non taglia, e ZIndex sopra
                   i fratelli del DockPanel). La copia non intercetta il mouse: spostandosi sui
                   pulsanti sparisce e li lascia cliccabili. -->
              <Grid VerticalAlignment="Center" Visibility="{Binding TagsVisibility}" Background="Transparent" Panel.ZIndex="1">
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                  <Border Style="{StaticResource Tag}" Visibility="{Binding IdTagVisibility}" Margin="0,0,4,0">
                    <Border.ToolTip>
                      <TextBlock Text="{Binding Id, StringFormat='Id nel catalogo: {0}. Console e dev tunnel di questo repository usano nomi con questo id.'}" />
                    </Border.ToolTip>
                    <TextBlock Text="{Binding Id}" Style="{StaticResource TagText}" />
                  </Border>
                </StackPanel>
                <Canvas>
                  <Border Style="{StaticResource TagsOverlay}">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                      <Border Style="{StaticResource OpaqueTag}" Visibility="{Binding IdTagVisibility}" Margin="0,0,4,0">
                        <TextBlock Text="{Binding Id}" Style="{StaticResource TagText}" />
                      </Border>
                    </StackPanel>
                  </Border>
                </Canvas>
              </Grid>
            </DockPanel>

            <!-- Corpo della card: a card chiusa restano intestazione, timestamp ed errori. -->
            <Border Visibility="{Binding Expander.BodyVisibility}" Style="{StaticResource CardSeparator}" />
            <StackPanel Visibility="{Binding Expander.BodyVisibility}">
            <!-- Tendina editabile con ricerca integrata: scrivendo le voci si filtrano per
                 sottostringa e il menu si apre da solo; le frecce spostano solo l'evidenziato e
                 una scelta (Invio o clic) esegue git switch.
                 IsTextSearchEnabled=False lascia al ViewModel il filtro invece del salto per
                 prefisso; StaysOpenOnEdit tiene il menu aperto mentre si scrive. -->
            <local:BranchComboBox DataContext="{Binding BranchPicker}"
                                  ItemsSource="{Binding Branches}"
                                  SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                                  Text="{Binding BranchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsDropDownOpen="{Binding BranchDropDownOpen, Mode=TwoWay}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True"
                                  Visibility="{Binding DataContext.GitActionsVisibility, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                  IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                  ToolTip="Scrivi per cercare, frecce per scorrere, Invio o clic per cambiare branch (git switch)"
                                  FontFamily="Consolas" FontWeight="Normal"
                                  FontSize="13"
                                  Margin="0,6,0,0" />

            <!-- Stato git e avviso sulla stessa riga, centrati: se lo spazio non basta si accorcia lo stato. -->
            <DockPanel HorizontalAlignment="Center" Margin="0,6,0,0">
              <TextBlock DockPanel.Dock="Right"
                         Text="{Binding UpstreamWarning}"
                         Visibility="{Binding UpstreamWarningVisibility}"
                         Foreground="#C42B1C"
                         FontSize="12"
                         FontWeight="Bold" />
              <TextBlock DockPanel.Dock="Right"
                         Text="·"
                         Visibility="{Binding UpstreamWarningVisibility}"
                         Opacity="0.65"
                         FontSize="12"
                         Margin="5,0" />
              <TextBlock Text="{Binding RepoDetail}"
                         ToolTip="{Binding RepoDetail}"
                         Opacity="0.65"
                         FontSize="12"
                         TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- Dev tunnel, nelle card del backend e del frontend: sezione con la sua
                 intestazione, che si apre e chiude da sola dentro il corpo della card. -->
            <StackPanel DataContext="{Binding Tunnel}"
                        Visibility="{Binding DataContext.TunnelVisibility, RelativeSource={RelativeSource AncestorType=Border}}">
              <Border Style="{StaticResource CardSeparator}" />
              <DockPanel Style="{StaticResource CardHeader}" Margin="0,8,0,0">
                <DockPanel.InputBindings>
                  <MouseBinding Gesture="LeftClick" Command="{Binding State.Expander.ToggleCommand}" />
                </DockPanel.InputBindings>
                <TextBlock DockPanel.Dock="Left" Text="{Binding State.Expander.Glyph}" Style="{StaticResource ExpanderGlyph}" />
                <TextBlock DockPanel.Dock="Left" Text="&#xE774;" Style="{StaticResource CardIcon}" />
                <!-- Nessun comando qui: il tunnel si accende e si spegne per tutto l'ambiente,
                     dall'intestazione. Il pallino e' lo stato dell'host. -->
                <local:StatusDot DockPanel.Dock="Right"
                                 Color="{Binding Host.StateColor}"
                                 IsLoading="{Binding State.IsLoading}">
                  <local:StatusDot.ToolTip>
                    <StackPanel>
                      <TextBlock Text="{Binding Host.StateToolTip}" />
                      <TextBlock Text="{Binding State.Stamp}" Style="{StaticResource DotStamp}" />
                    </StackPanel>
                  </local:StatusDot.ToolTip>
                </local:StatusDot>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding State.Line}"
                           ToolTip="{Binding State.Line}"
                           Style="{StaticResource CardTitle}" />
              </DockPanel>

              <StackPanel DataContext="{Binding State}" Visibility="{Binding Expander.BodyVisibility}">
                <TextBlock Text="{Binding Detail}"
                           Visibility="{Binding DetailVisibility}"
                           Opacity="0.65"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,8,0,0" />

                <!-- Una riga per porta: numero nel badge, host senza schema (gli URL pubblici sono https),
                     due bottoni a destra: copia dell'URL e apertura nel browser
                     predefinito. La nota compare solo per una porta che non risponde o per il
                     feedback della copia. -->
                <local:LaneGrid ItemsSource="{Binding Ports}"
                                Visibility="{Binding PortsVisibility}"
                                Margin="0,8,0,0">
                  <local:LaneGrid.ItemTemplate>
                    <DataTemplate>
                      <local:Lane Badge="{Binding PortNumber}" Text="{Binding Host}" Note="{Binding Note}" NoteBrush="{Binding NoteColor}">
                        <local:LaneAction Glyph="&#xE8C8;" Command="{Binding CopyCommand}" ToolTip="{Binding CopyToolTip}" />
                        <local:LaneAction Glyph="&#xE8A7;" Command="{Binding OpenCommand}" ToolTip="{Binding OpenToolTip}" />
                      </local:Lane>
                    </DataTemplate>
                  </local:LaneGrid.ItemTemplate>
                </local:LaneGrid>

                <!-- Nessun tunnel corrisponde al clone: tunnel dell'account con stato sintetico. -->
                <!-- Pallino di stato, nome del tunnel e, nella nota grigia, host e porte. -->
                <local:LaneGrid ItemsSource="{Binding List}"
                                Visibility="{Binding ListVisibility}"
                                Margin="0,8,0,0">
                  <local:LaneGrid.ItemTemplate>
                    <DataTemplate>
                      <local:Lane Dot="{Binding StatusColor}" Text="{Binding Title}" ToolTip="{Binding Title}" Note="{Binding Kind}" NoteBrush="#5F6368" />
                    </DataTemplate>
                  </local:LaneGrid.ItemTemplate>
                </local:LaneGrid>
              </StackPanel>

            </StackPanel>

            <!-- Anteprima del frontend, solo nella card del frontend: il browser di playwright-cli
                 aperto sulla porta del dev server di questo ambiente, dal vivo e utilizzabile in
                 un riquadro 16:9. Il pallino e' verde quando il browser di Claude c'e'. -->
            <StackPanel DataContext="{Binding Preview}"
                        Visibility="{Binding DataContext.PreviewVisibility, RelativeSource={RelativeSource AncestorType=Border}}">
              <Border Style="{StaticResource CardSeparator}" />
              <DockPanel Style="{StaticResource CardHeader}" Margin="0,8,0,0">
                <DockPanel.InputBindings>
                  <MouseBinding Gesture="LeftClick" Command="{Binding Expander.ToggleCommand}" />
                </DockPanel.InputBindings>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Expander.Glyph}" Style="{StaticResource ExpanderGlyph}" />
                <TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" Style="{StaticResource CardIcon}" />
                <local:StatusDot DockPanel.Dock="Right"
                                 Color="{Binding SessionColor}"
                                 ToolTip="{Binding HeaderToolTip}" />
                <Button DockPanel.Dock="Right"
                        Click="OpenPreview_Click"
                        ToolTip="Ingrandisci a tutta la finestra"
                        Style="{StaticResource IconButton}"
                        Content="&#xE740;" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding OpenExternalCommand}"
                        ToolTip="Apri nel browser predefinito la pagina del browser di Claude (o il dev server se non c'e')"
                        Style="{StaticResource IconButton}"
                        Content="&#xE8A7;" />
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Header}"
                           ToolTip="{Binding HeaderToolTip}"
                           Style="{StaticResource CardTitle}" />
              </DockPanel>

              <!-- Il Viewbox da' l'altezza massima: 16:9, o la proporzione del fotogramma quando
                   e' piu' largo. Con un fotogramma il riquadro si stringe sull'immagine (l'Image
                   Uniform misura solo l'area del fotogramma), senza resta pieno. Il contenuto
                   si ritaglia sugli angoli stondati con una maschera: ClipToBounds taglierebbe
                   solo in rettangolo. -->
              <Grid Visibility="{Binding Expander.BodyVisibility}" Margin="0,8,0,0">
                <Viewbox x:Name="PreviewSizer" Stretch="Uniform">
                  <Rectangle Width="{Binding SizerWidth}" Height="{Binding SizerHeight}" />
                </Viewbox>
                <Border MaxHeight="{Binding ActualHeight, ElementName=PreviewSizer}">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource LaneFrame}">
                      <Setter Property="HorizontalAlignment" Value="Center" />
                      <Setter Property="VerticalAlignment" Value="Top" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Frame}" Value="{x:Null}">
                          <Setter Property="HorizontalAlignment" Value="Stretch" />
                          <Setter Property="VerticalAlignment" Value="Stretch" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Border x:Name="PreviewMask" CornerRadius="12" Background="{DynamicResource Theme.Field}" />
                    <Grid>
                      <Grid.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=PreviewMask}" />
                      </Grid.OpacityMask>
                      <local:PlaywrightLiveView Visibility="{Binding ClaudeViewVisibility}" />
                      <TextBlock Text="{Binding ClaudePlaceholder}"
                                 Visibility="{Binding ClaudePlaceholderVisibility}"
                                 Opacity="0.55"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Margin="12" />
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </StackPanel>

            <!-- Log del container, solo nelle card di backend e frontend di un ambiente Docker:
                 si legge solo a sezione aperta (DevToolsController.FollowContainerLogAsync). -->
            <ContentControl Content="{Binding ContainerLog}"
                            ContentTemplate="{StaticResource LogSectionTemplate}"
                            Visibility="{Binding ContainerLogVisibility}"
                            Focusable="False" />

            <!-- Migrazioni e context, solo nella card del backend: una sezione ciascuno in fondo
                 al corpo, prima le migrazioni applicate che il codice non conosce, perche' vanno
                 viste prima di leggere i contatori dei context. -->
            <StackPanel DataContext="{Binding Migrations}"
                        Visibility="{Binding DataContext.MigrationsVisibility, RelativeSource={RelativeSource AncestorType=Border}}">
              <StackPanel Visibility="{Binding UnknownVisibility}">
                <Border Style="{StaticResource CardSeparator}" />
                <DockPanel Style="{StaticResource CardHeader}" Margin="0,8,0,0">
                  <DockPanel.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding UnknownExpander.ToggleCommand}" />
                  </DockPanel.InputBindings>
                  <TextBlock DockPanel.Dock="Left" Text="{Binding UnknownExpander.Glyph}" Style="{StaticResource ExpanderGlyph}" />
                  <TextBlock DockPanel.Dock="Left" Text="&#xE9CE;" Style="{StaticResource CardIcon}" />
                  <local:StatusDot DockPanel.Dock="Right" Color="#E76F6F" ToolTip="{Binding UnknownHeader}" />
                  <TextBlock DockPanel.Dock="Left"
                             Text="{Binding UnknownHeader}"
                             ToolTip="{Binding UnknownHeader}"
                             Style="{StaticResource CardTitle}" />
                </DockPanel>
                <local:LaneGrid ItemsSource="{Binding Unknown}" Margin="0,8,0,0" Visibility="{Binding UnknownExpander.BodyVisibility}">
                  <local:LaneGrid.ItemTemplate>
                    <DataTemplate>
                      <local:Lane Text="{Binding MigrationId}" ToolTip="{Binding MigrationId}" />
                    </DataTemplate>
                  </local:LaneGrid.ItemTemplate>
                </local:LaneGrid>
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Contexts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <Border Style="{StaticResource CardSeparator}" />
                      <!-- Intestazione cliccabile: apre e chiude la sezione. Il database update
                           parte dalle righe delle migrazioni, non da qui. -->
                      <DockPanel Style="{StaticResource CardHeader}" Margin="0,8,0,0">
                        <DockPanel.InputBindings>
                          <MouseBinding Gesture="LeftClick" Command="{Binding Expander.ToggleCommand}" />
                        </DockPanel.InputBindings>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Expander.Glyph}" Style="{StaticResource ExpanderGlyph}" />
                        <TextBlock DockPanel.Dock="Left" Text="&#xEE94;" Style="{StaticResource CardIcon}" />
                        <!-- Verde allineato, arancio con migrazioni da sistemare. -->
                        <local:StatusDot DockPanel.Dock="Right"
                                         Color="{Binding StatusColor}"
                                         IsLoading="{Binding IsLoading}">
                          <local:StatusDot.ToolTip>
                            <StackPanel>
                              <TextBlock Text="{Binding StatusToolTip}" />
                              <TextBlock Text="{Binding Stamp}" Style="{StaticResource DotStamp}" />
                            </StackPanel>
                          </local:StatusDot.ToolTip>
                        </local:StatusDot>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding Name}"
                                   ToolTip="{Binding Name}"
                                   Style="{StaticResource CardTitle}" />
                      </DockPanel>

                      <!-- Corpo: aperto di default solo se il context non e' allineato. -->
                      <StackPanel Visibility="{Binding Expander.BodyVisibility}">
                      <TextBlock Text="{Binding Note}"
                                 Visibility="{Binding NoteVisibility}"
                                 Opacity="0.65"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 Margin="0,8,0,0" />

                      <!-- Ultime migrazioni, con la posizione nel context nel badge: il bottone
                           della riga lancia l'update fino a quella migrazione, con conferma. Il
                           glifo dice la direzione: Play in avanti, Undo per un rollback. -->
                      <local:LaneGrid ItemsSource="{Binding Recent}"
                                      Visibility="{Binding RecentVisibility}"
                                      Margin="0,8,0,0">
                        <local:LaneGrid.ItemTemplate>
                          <DataTemplate>
                            <local:Lane Badge="{Binding Position}" Text="{Binding Name}" Note="{Binding Note}" NoteBrush="{Binding NoteColor}">
                              <local:LaneAction Glyph="{Binding RunGlyph}" Command="{Binding RunCommand}" IsEnabled="{Binding RunEnabled}" ToolTip="{Binding RunToolTip}" />
                            </local:Lane>
                          </DataTemplate>
                        </local:LaneGrid.ItemTemplate>
                      </local:LaneGrid>

                      <StackPanel Orientation="Horizontal"
                                  HorizontalAlignment="Center"
                                  Visibility="{Binding PagerVisibility}"
                                  Margin="0,8,0,0">
                        <Button Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}"
                                ToolTip="Migrazioni più recenti"
                                Style="{StaticResource IconButton}"
                                Margin="0"
                                Content="&#xE76B;" />
                        <TextBlock Text="{Binding PageLabel}"
                                   FontSize="11"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"
                                   Margin="6,0,2,0" />
                        <Button Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoNext}"
                                ToolTip="Migrazioni più vecchie"
                                Style="{StaticResource IconButton}"
                                Content="&#xE76C;" />
                      </StackPanel>
                      </StackPanel>

                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            </StackPanel>

            <!-- Errori di configurazione, database, git o azioni: rosso ad alfa bassa, si
                 stacca senza gridare. -->
            <Border CornerRadius="12"
                    Background="#14C42B1C"
                    BorderBrush="#40C42B1C"
                    BorderThickness="1"
                    Padding="8,7"
                    Margin="0,8,0,0"
                    Visibility="{Binding ErrorVisibility}">
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Background="#C42B1C" Style="{StaticResource Badge}" VerticalAlignment="Top">
                  <TextBlock Text="&#10005;" Style="{StaticResource BadgeGlyph}" />
                </Border>
                <TextBlock Text="{Binding ErrorLine}" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Sfondo della finestra sotto l'intestazione e le card: il gradiente del brand,
         senza logo. Una base lavanda chiara che scurisce verso il basso a destra, piu' tre
         macchie morbide: azzurra in alto a sinistra, chiara in alto al centro, lilla in basso a
         destra. Copre anche la riga dell'intestazione, cosi' negli angoli stondati si vede il
         gradiente. -->
    <Grid Grid.Row="0" Grid.RowSpan="3">
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="{DynamicResource Theme.Base0}" />
            <GradientStop Offset="0.5" Color="{DynamicResource Theme.Base1}" />
            <GradientStop Offset="1" Color="{DynamicResource Theme.Base2}" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border>
        <Border.Background>
          <RadialGradientBrush Center="0.15,0.08" GradientOrigin="0.15,0.08" RadiusX="0.25" RadiusY="0.4">
            <GradientStop Offset="0" Color="{DynamicResource Theme.SpotMint}" />
            <GradientStop Offset="1" Color="{DynamicResource Theme.SpotMintClear}" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>
      <Border>
        <Border.Background>
          <RadialGradientBrush Center="0.45,0.05" GradientOrigin="0.45,0.05" RadiusX="0.3" RadiusY="0.45">
            <GradientStop Offset="0" Color="{DynamicResource Theme.SpotLight}" />
            <GradientStop Offset="1" Color="{DynamicResource Theme.SpotLightClear}" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>
      <Border>
        <Border.Background>
          <RadialGradientBrush Center="0.88,0.95" GradientOrigin="0.88,0.95" RadiusX="0.25" RadiusY="0.35">
            <GradientStop Offset="0" Color="{DynamicResource Theme.SpotWarm}" />
            <GradientStop Offset="1" Color="{DynamicResource Theme.SpotWarmClear}" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>
    </Grid>

    <!-- Easter egg di Ctrl+T: un paesaggio in pixel art sopra il gradiente, sotto testata e
         card, col terreno sul bordo del footer come i piedi del gattino. -->
    <local:PixelScenery x:Name="Scenery" Grid.Row="0" Grid.RowSpan="2" />

    <!-- Intestazione fissa (riga delle app e intestazioni delle colonne): una card unica,
         sullo stesso piano delle card delle colonne: stesso fondo, bordo, raggio e distanza dal
         bordo della finestra (stile Section), e 8 px dalla prima card come tra le card. Niente
         ombra. L'ombra resta ai pannelli, che stanno sopra. -->
    <Border x:Name="HeaderCard"
            Grid.Row="0"
            Margin="8,8,8,0"
            CornerRadius="20"
            Background="{DynamicResource Theme.CardBackground}"
            BorderBrush="{DynamicResource Theme.CardBorder}"
            BorderThickness="1,1,1,3"
            TextElement.Foreground="{DynamicResource Theme.Text}">
      <StackPanel>
        <!-- Riga delle app, nello spirito del telefono di Animal Crossing: un bottone per pannello
             (icona tonda colorata ed etichetta). A sinistra i pannelli di lavoro, a destra, da
             sinistra a destra, risorse della macchina, Setup, Aggiorna tutto e Notifiche: col Dock a destra
             il primo dichiarato e' il piu' a destra. Le letture in corso le mostra l'isola in
             cima alla finestra. -->
        <!-- Quattro gruppi nella stessa griglia: pannelli a sinistra, comandi a destra, chip degli
             ambienti subito dopo i pannelli e risorse della macchina subito prima dei comandi. Se non
             stanno tutti in una riga, chip e risorse scendono nella seconda, i chip a sinistra e le
             risorse a destra; le risorse vanno nella terza solo se neanche li' c'e' posto
             (TopBar_SizeChanged). -->
        <Grid x:Name="TopBar" Margin="12,10,12,10" SizeChanged="TopBar_SizeChanged">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel x:Name="TopBarLeft" Orientation="Horizontal" HorizontalAlignment="Left" SizeChanged="TopBar_SizeChanged">
          <Button x:Name="PullRequestsButton"
                  DockPanel.Dock="Left"
                  Click="OpenPullRequests_Click"
                  ToolTip="Le pull request che ti riguardano, raggruppate per work item"
                  Style="{StaticResource AppButton}"
                  Tag="#3FB8A0"
                  Content="&#xE943;"
                  local:AppButton.Label="Pull request" />
          <Button DockPanel.Dock="Left"
                  Click="OpenMeeting_Click"
                  ToolTip="Gioco a turni e a tempo per dare i punti alle storie utente"
                  Style="{StaticResource AppButton}"
                  Tag="#E07A9B"
                  Content="&#xE716;"
                  local:AppButton.Label="Punti storia" />
          <Button x:Name="TomatoButton"
                  DockPanel.Dock="Left"
                  Click="OpenTomato_Click"
                  ToolTip="Il tomato timer del giardino, in un pannello che a chiuderlo non ferma il timer"
                  Style="{StaticResource AppButton}"
                  Tag="#D9544D"
                  Content="&#xE916;"
                  local:AppButton.Label="Pomodoro" />
          </StackPanel>
          <DockPanel x:Name="TopBarRight" LastChildFill="False" HorizontalAlignment="Right" SizeChanged="TopBar_SizeChanged">
          <Button x:Name="NotificationsButton"
                  DockPanel.Dock="Right"
                  Click="OpenNotifications_Click"
                  ToolTip="I lavori nuovi sulle pull request, finché non li leggi"
                  Style="{StaticResource AppButton}"
                  Tag="#A98BE3"
                  Content="&#xEA8F;"
                  local:AppButton.Label="Notifiche"
                  local:AppButton.Badge="{Binding Notifications.BadgeText}" />
          <Button DockPanel.Dock="Right"
                  Command="{Binding RefreshAllCommand}"
                  ToolTip="Rilegge tutti gli ambienti liberi: git fetch, migrazioni e dev tunnel"
                  Style="{StaticResource AppButton}"
                  Tag="#7CC56A"
                  Content="&#xE72C;"
                  local:AppButton.Label="Aggiorna tutto" />
          <!-- Il badge conta le migrazioni di dev che mancano al seed: si allinea dalla scheda «Docker». -->
          <Button x:Name="SetupButton"
                  DockPanel.Dock="Right"
                  Click="OpenSetup_Click"
                  ToolTip="Preferenze dell'exe (tema, gattino, sfondo, demo), ambienti, repository, Docker (seed, spazio, log), tunnel e DevOps"
                  Style="{StaticResource AppButton}"
                  Tag="#55B7EA"
                  Content="&#xE713;"
                  local:AppButton.Label="Setup"
                  local:AppButton.Badge="{Binding Docker.MissingBadge}" />
          </DockPanel>
          <!-- Risorse della macchina (SystemLoad: disco di sistema e RAM): in prima riga a sinistra di
               Setup, oppure a destra nella riga dei chip quando la prima non basta (TopBar_SizeChanged).
               La sagoma dei bottoni-app
               ma piatta, senza labbro e con un filo di bordo, perche' non sembri cliccabile. La
               barra piena e' la parte usata, il binario
               vuoto quella libera; i valori in GB e le percentuali libere stanno nel tooltip.
               La sorgente e' statica: resta anche quando la demo di Ctrl+D cambia il DataContext. -->
          <Grid x:Name="TopBarMeter"
                Height="34"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                SizeChanged="TopBar_SizeChanged"
                DataContext="{x:Static local:SystemLoad.Current}"
                ToolTip="{Binding ToolTip}"
                ToolTipService.InitialShowDelay="200"
                TextElement.Foreground="{DynamicResource Theme.TextSoft}">
            <Border CornerRadius="13" Background="{DynamicResource Theme.MeterTrack}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
              <TextBlock Text="{Binding DiskLabel}" Style="{StaticResource MeterLabel}" />
              <ProgressBar Value="{Binding DiskPercent, Mode=OneWay}" Foreground="{Binding DiskBrush}" Style="{StaticResource Meter}" />
              <TextBlock Text="{Binding DiskText}" Style="{StaticResource MeterValue}" />
              <Border Width="1" Height="14" Background="{DynamicResource Theme.MeterSeparator}" Margin="10,0" />
              <TextBlock Text="RAM" Style="{StaticResource MeterLabel}" />
              <ProgressBar Value="{Binding RamPercent, Mode=OneWay}" Foreground="{Binding RamBrush}" Style="{StaticResource Meter}" />
              <TextBlock Text="{Binding RamText}" Style="{StaticResource MeterValue}" />
            </StackPanel>
          </Grid>
          <StackPanel x:Name="TopBarChips" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" SizeChanged="TopBar_SizeChanged">
          <!-- Un chip per ambiente, sempre visibile anche scorrendo le colonne in orizzontale. Da
               sinistra: numero, pallino di stato (azzurro pulsante mentre l'ambiente legge o i container
               partono) e i segni dell'ambiente solo quando valgono: pila di livelli viola per
               Docker, lucchetto rosso per il database protetto, spunta verde acqua se ogni repository e' su dev.
               Lo sfondo dice solo se la colonna e' mostrata (beige caldo, in rilievo) o nascosta (ardesia,
               piatta).
               Col mouse sopra si apre la scheda dell'ambiente (ChipCard, in fondo alla finestra). Il
               clic mostra o nasconde la colonna; mostrandola la porta in vista. -->
          <ItemsControl ItemsSource="{Binding Environments}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Click="StatusChip_Click"
                        MouseEnter="StatusChip_MouseEnter"
                        MouseLeave="ChipCard_MouseLeave"
                        AutomationProperties.Name="{Binding Title}"
                        AutomationProperties.HelpText="{Binding StatusLine}"
                        Margin="0,0,5,0"
                        Padding="8,1,9,0">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                      <Style.Triggers>
                        <!-- Colonna nascosta: chip piatto, senza il labbro e il riflesso dei bottoni,
                             con un filo di bordo; resta il velo in hover perche' si veda che e' cliccabile. -->
                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Theme.ChipHidden}" />
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="Button">
                                <Grid>
                                  <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Theme.ChipHiddenBorder}" BorderThickness="1" CornerRadius="{DynamicResource ButtonRadius}" />
                                  <Border x:Name="Veil" Background="White" Opacity="0" CornerRadius="{DynamicResource ButtonRadius}" />
                                  <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Veil" Property="Opacity" Value="0.3" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Number}" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    <local:StatusDot Color="{Binding StatusColor}" IsLoading="{Binding IsHeaderBusy}" DotSize="8" Width="8" Height="8" Margin="6,0,0,0" />
                    <TextBlock Text="&#xE81E;" Visibility="{Binding KindBadgeVisibility}" Foreground="{DynamicResource Theme.DockerTagText}" Style="{StaticResource ChipGlyph}" />
                    <TextBlock Text="&#xE72E;" Visibility="{Binding ProtectedDatabaseVisibility}" Foreground="{DynamicResource Theme.ProtectedDatabaseTagText}" Style="{StaticResource ChipGlyph}" />
                    <TextBlock Text="&#xE930;" Visibility="{Binding SunsetVisibility}" Foreground="{DynamicResource Theme.ChipSunset}" Style="{StaticResource ChipGlyph}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Dopo i chip degli ambienti: apre il riquadro di creazione di un ambiente Docker. -->
          <Button x:Name="NewDockerButton"
                  DockPanel.Dock="Left"
                  Click="OpenDocker_Click"
                  Visibility="{Binding NewDockerVisibility}"
                  ToolTip="Nuovo ambiente Docker: worktree dai cloni sorgente, database dal seed e container dello slot"
                  Style="{StaticResource TextButton}"
                  Margin="0"
                  VerticalAlignment="Center"
                  FontWeight="Bold"
                  Content="+" />
          <TextBlock DockPanel.Dock="Left"
                     Text="{Binding DemoBanner}"
                     Foreground="{DynamicResource Theme.TagText}"
                     FontWeight="Bold"
                     FontSize="13"
                     VerticalAlignment="Center"
                     Margin="12,0,0,0" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Un solo scroll per tutte le colonne, card dell'ambiente comprese: scorrono insieme, e la
         riga della griglia e' alta quanto la colonna piu' lunga. La scrollbar compare solo se c'e'
         qualcosa da scorrere. In orizzontale la griglia e' larga quanto il viewport, ma mai meno di
         ColumnsMinWidth (MinWidth vince su Width): sotto quella soglia le colonne non si stringono
         e compare lo scroll orizzontale. -->
    <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextElement.Foreground="{DynamicResource Theme.Text}">
      <ItemsControl x:Name="BodyColumns"
                    ItemsSource="{Binding Environments}"
                    MinWidth="{Binding ColumnsMinWidth}"
                    Width="{Binding ViewportWidth, ElementName=BodyScroll}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <local:ColumnsPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="local:ColumnsPanel.IsCollapsed" Value="{Binding IsCollapsed}" />
            <Setter Property="Visibility" Value="{Binding ColumnVisibility}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- La prima riga e' la card dell'ambiente, alta quanto il suo contenuto: ogni colonna
                 ha la sua. Una colonna nascosta sparisce del tutto e si riapre dal suo chip nella testata. -->
            <Grid x:Name="Column"
                  Margin="8,8,8,3"
                  local:CardTint.AllOnDev="{Binding AllOnDev}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
                <!-- La card dell'ambiente, in cima alla colonna: nome, pallino, attivita', azioni
                     d'ambiente, occhio per nascondere la colonna e nota. -->
                <Border Style="{StaticResource Section}" Visibility="{Binding ColumnVisibility}" local:CardBusy.IsBusy="{Binding IsHeaderBusy}">
                  <StackPanel>
                    <DockPanel Style="{StaticResource CardHeader}" Cursor="Arrow">
                      <!-- Azzurro pulsante mentre l'ambiente legge, esegue un'azione o (Docker) i
                           container partono; rosso se un container e' in errore. -->
                      <local:StatusDot DockPanel.Dock="Right"
                                       Color="{Binding StatusColor}"
                                       IsLoading="{Binding IsHeaderBusy}"
                                       ToolTip="{Binding StatusLine}" />
                      <Button DockPanel.Dock="Right"
                              Command="{Binding ToggleCollapseCommand}"
                              ToolTip="Nasconde la colonna: si riapre dal suo numero nella testata"
                              Style="{StaticResource IconButton}"
                              Content="&#xED1A;" />
                      <Button DockPanel.Dock="Right"
                              Command="{Binding RefreshCommand}"
                              ToolTip="Rilegge l'ambiente, esegue git fetch e interroga i dev tunnel"
                              Style="{StaticResource IconButton}"
                              Content="&#xE72C;" />
                      <!-- Avvia/ferma d'ambiente: Kestrel, dev server e host dei tunnel di tutte le
                           card; lo stop ferma anche app e Metro, l'avvio no (vedi DevToolsController). -->
                      <Button DockPanel.Dock="Right"
                              Command="{Binding Tools.Stack.ToggleCommand}"
                              IsEnabled="{Binding Tools.Stack.ToggleEnabled}"
                              ToolTip="{Binding Tools.Stack.ToggleToolTip}"
                              ToolTipService.ShowOnDisabled="True"
                              Tag="{Binding Tools.Stack.IsStop}"
                              Style="{StaticResource ServiceToggle}"
                              Content="{Binding Tools.Stack.ToggleGlyph}" />
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="ExtraBold" FontSize="15" Foreground="{DynamicResource Theme.TextStrong}" VerticalAlignment="Center" />
                      <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource EnvironmentTags}" Focusable="False" IsTabStop="False" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- Solo negli ambienti Docker: docker che non risponde e avvisi degli env dello slot (nomi, mai valori). -->
                    <TextBlock Text="{Binding Docker.UnreachableText}"
                               Visibility="{Binding Docker.UnreachableVisibility, FallbackValue=Collapsed}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource Theme.DockerErrorText}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Docker.EnvWarningText}"
                               Visibility="{Binding Docker.EnvWarningVisibility, FallbackValue=Collapsed}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource Theme.DockerWarningText}"
                               Margin="0,4,0,0" />
                    <!-- Nota libera dell'ambiente, condivisa con la VSIX: si scrive qui e si salva da
                         sola. Il segnaposto sta sotto la casella trasparente. -->
                    <Border Margin="0,6,0,2" CornerRadius="10" Background="{DynamicResource Theme.Note}">
                      <Grid>
                        <!-- Mentre si scrive il segnaposto sparisce: il cursore centrato gli cadrebbe in mezzo. -->
                        <TextBlock Text="Note"
                                   Visibility="{Binding NotePlaceholderVisibility}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NotePlaceholder}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=NoteInput}" Value="True">
                                  <Setter Property="Opacity" Value="0" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="NoteInput"
                                 Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NoteBox}" />
                      </Grid>
                    </Border>
                    <!-- Azioni secondarie sotto la nota: l'intestazione tiene solo avvia/ferma, rilettura
                         e occhio, cosi' nome, tag e stato hanno spazio. L'interruttore del tunnel sta
                         a sinistra, le azioni a destra. -->
                    <DockPanel LastChildFill="False" Margin="0,6,0,0">
                      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <!-- Il tunnel dell'ambiente: spuntato, l'ambiente ha un tunnel del pool con una
                             porta per ogni repository che ne espone una. -->
                        <TextBlock Text="Tunnel"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.TextStrong}"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding TunnelToolTip}"
                                   Margin="0" />
                        <CheckBox Style="{StaticResource Switch}"
                                  IsChecked="{Binding TunnelOn, Mode=OneWay}"
                                  Command="{Binding TunnelCommand}"
                                  IsEnabled="{Binding TunnelEnabled}"
                                  ToolTip="{Binding TunnelToolTip}"
                                  ToolTipService.ShowOnDisabled="True"
                                  VerticalAlignment="Center"
                                  Margin="6,0,4,0" />
                      </StackPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- Solo negli ambienti Docker: «Distruggi ambiente» e «Ripara env». Gli env dei locali si
                             riallineano da soli a ogni rilettura completa (EnvironmentController.Refresh). -->
                        <Button Command="{Binding Docker.DestroyCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Visibility="{Binding KindBadgeVisibility}"
                                ToolTip="Distrugge l'ambiente: container e volume del database, worktree (solo se non hanno codice da perdere), cartella dello slot, immagini dell'api e del web, porte del pool e voce. Restano i branch e la nota"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource TextButton}"
                                Content="Distruggi ambiente" />
                        <Button Command="{Binding Docker.RepairEnvCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Visibility="{Binding KindBadgeVisibility}"
                                ToolTip="Riscrive gli env dei worktree e gli env_file dei container dalla configurazione; i valori impostati a mano che lo slot non sa calcolare restano"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource TextButton}"
                                Content="Ripara env" />
                        <!-- Reset: stessa logica del checkout delle PR, con tutti i repository su dev. -->
                        <Button Command="{Binding ResetCommand}"
                                ToolTip="Spegne tutto l'ambiente, app compresa, e se i repository sono puliti li riporta su dev con il pull"
                                Style="{StaticResource TextButton}"
                                Content="Reset to dev" />
                      </StackPanel>
                    </DockPanel>
                    <!-- Solo negli ambienti Docker: il log delle operazioni dell'ambiente
                         (creazione, avvio, stop, ripara env, distruggi). -->
                    <ContentControl Content="{Binding OperationLog}"
                                    ContentTemplate="{StaticResource LogSectionTemplate}"
                                    Visibility="{Binding KindBadgeVisibility}"
                                    Focusable="False" />
                  </StackPanel>
                </Border>
                <!-- Le card del catalogo che l'ambiente include, nell'ordine del catalogo. -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Repos}" ItemTemplate="{StaticResource RepoCardTemplate}" Visibility="{Binding ColumnVisibility}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Easter egg di Ctrl+G: sopra il contenuto, coi piedi sul bordo del footer. -->
    <local:PixelCat x:Name="Cat" Grid.Row="1" VerticalAlignment="Bottom" Panel.ZIndex="2" />

    <!-- Pannello delle pull request: una card che galleggia su un lato (sinistro all'avvio, «Cambia
         lato» lo sposta: MainWindow.SwitchPullRequestsSide), sopra testata e
         colonne (che sotto i 480 px l'una non si stringono: un pannello affiancato le manderebbe
         in scroll), staccata dai bordi. Il DataContext e' il suo ViewModel, assegnato
         dalla finestra: la demo di Ctrl+D non lo tocca. Scala e spostamento servono all'animazione
         di apertura (MainWindow.ShowPullRequests). -->
    <local:PullRequestsPanel x:Name="PullRequests"
                             Grid.Row="0"
                             Grid.RowSpan="2"
                             Width="620"
                             Margin="8,8,0,8"
                             HorizontalAlignment="Left"
                             Visibility="Collapsed"
                             RenderTransformOrigin="0,0"
                             Panel.ZIndex="2">
      <local:PullRequestsPanel.RenderTransform>
        <TransformGroup>
          <ScaleTransform />
          <TranslateTransform />
        </TransformGroup>
      </local:PullRequestsPanel.RenderTransform>
    </local:PullRequestsPanel>

    <!-- Pannello del pomodoro: card galleggiante sul lato sinistro come le PR, con il tomato
         timer in una WebView2. Chiuderlo lo rende trasparente e non cliccabile ma non lo
         nasconde (MainWindow.HideTomato): per Chromium la pagina resta visibile e il timer non
         viene rallentato. -->
    <local:TomatoPanel x:Name="Tomato"
                       Grid.Row="0"
                       Grid.RowSpan="2"
                       Width="620"
                       Margin="8,8,0,8"
                       HorizontalAlignment="Left"
                       Visibility="Collapsed"
                       RenderTransformOrigin="0,0"
                       Panel.ZIndex="2">
      <local:TomatoPanel.RenderTransform>
        <TransformGroup>
          <ScaleTransform />
          <TranslateTransform />
        </TransformGroup>
      </local:TomatoPanel.RenderTransform>
    </local:TomatoPanel>

    <!-- Pannello delle notifiche: card galleggiante sul lato destro, con le stesse animazioni del
         pannello delle PR. I due non stanno aperti insieme: se le PR sono passate a destra si
         sovrapporrebbero. Il DataContext lo assegna la finestra (vero o demo). -->
    <local:NotificationsPanel x:Name="Notifications"
                              Grid.Row="0"
                              Grid.RowSpan="2"
                              Width="460"
                              Margin="0,8,8,8"
                              HorizontalAlignment="Right"
                              Visibility="Collapsed"
                              RenderTransformOrigin="1,0"
                              Panel.ZIndex="2">
      <local:NotificationsPanel.RenderTransform>
        <TransformGroup>
          <ScaleTransform />
          <TranslateTransform />
        </TransformGroup>
      </local:NotificationsPanel.RenderTransform>
    </local:NotificationsPanel>

    <!-- Riquadro «Nuovo ambiente Docker» del «+»: galleggiante a destra come le notifiche, con cui
         non sta aperto insieme, alto quanto il suo contenuto. -->
    <local:DockerPanel x:Name="Docker"
                       DataContext="{Binding Docker}"
                       Grid.Row="0"
                       Grid.RowSpan="2"
                       Width="520"
                       Margin="0,8,8,8"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Visibility="Collapsed"
                       RenderTransformOrigin="1,0"
                       Panel.ZIndex="2">
      <local:DockerPanel.RenderTransform>
        <TransformGroup>
          <ScaleTransform />
          <TranslateTransform />
        </TransformGroup>
      </local:DockerPanel.RenderTransform>
    </local:DockerPanel>

    <!-- Nessun ambiente configurato (primo avvio): al posto delle colonne un invito al setup. -->
    <StackPanel Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding EmptyVisibility}">
      <TextBlock Text="Nessun ambiente configurato" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Theme.TextStrong}" HorizontalAlignment="Center" />
      <TextBlock Text="Apri il setup per indicare repository, cartelle e numero di ambienti." Opacity="0.7" Margin="0,4,0,0" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- Setup: una card grande al centro, sopra tutto, con un velo che la separa dalle colonne.
         Un clic sul velo non la chiude: dentro c'e' lavoro non salvato. -->
    <Border x:Name="SetupBackdrop"
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="#66352A1C"
            Visibility="Collapsed"
            Panel.ZIndex="5">
      <local:SetupPanel x:Name="Setup"
                        MaxWidth="1100"
                        Margin="32,24" />
    </Border>

    <!-- Riunione punti storia: copre tutta la finestra, footer compreso, perche' va proiettata
         su un televisore. Il velo resta come cornice di pochi pixel e non la chiude al clic: in
         riunione un clic sbagliato non deve far sparire il timer. Il DataContext lo assegna la
         finestra (vero o demo). -->
    <Border x:Name="MeetingBackdrop"
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="#66352A1C"
            Visibility="Collapsed"
            Panel.ZIndex="5">
      <local:StoryPointsMeetingPanel x:Name="Meeting" Margin="8" />
    </Border>

    <!-- Letture in corso: l'isola sale dal basso a sinistra, sopra le colonne e sotto i pannelli.
         Col mouse sopra scivola sul lato destro, e da li' torna a sinistra: non copre mai
         quello che si sta guardando. -->
    <local:LoadingIsland Grid.Row="1"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="18,0,18,14"
                         FromBottom="True"
                         DodgesMouse="True"
                         Panel.ZIndex="4" />

    <!-- Scheda di un chip della testata: compare col mouse sopra il chip, centrata sotto di lui, e
         resta aperta mentre il mouse passa dal chip alla scheda (MainWindow.xaml.cs, ChipCard_*).
         Ha l'aspetto della card dell'ambiente: nome, tag, pallino di stato e nota (in sola lettura), poi i
         branch di ogni repository presente in una LaneGrid e il bottone che mostra o nasconde la colonna. Il
         DataContext e' l'ambiente del chip. -->
    <Popup x:Name="ChipCard"
           AllowsTransparency="True"
           StaysOpen="True"
           Placement="Custom"
           PopupAnimation="Fade"
           Focusable="False">
      <Border Style="{StaticResource Section}"
              local:CardTint.AllOnDev="{Binding AllOnDev}"
              Margin="12,2,12,16"
              Padding="14,8,14,12"
              MinWidth="340"
              MaxWidth="480"
              TextElement.Foreground="{DynamicResource Theme.Text}"
              MouseEnter="ChipCard_MouseEnter"
              MouseLeave="ChipCard_MouseLeave">
        <Border.Effect>
          <DropShadowEffect Direction="270" ShadowDepth="3" BlurRadius="14" Opacity="0.2" Color="#5C4A2A" />
        </Border.Effect>
        <StackPanel>
          <DockPanel Style="{StaticResource CardHeader}" Cursor="Arrow">
            <local:StatusDot DockPanel.Dock="Right" Color="{Binding StatusColor}" IsLoading="{Binding IsHeaderBusy}" ToolTip="{Binding StatusLine}" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="ExtraBold" FontSize="15" Foreground="{DynamicResource Theme.TextStrong}" VerticalAlignment="Center" />
            <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource EnvironmentTags}" Focusable="False" IsTabStop="False" VerticalAlignment="Center" />
          </DockPanel>

          <Border Margin="0,6,0,2" CornerRadius="10" Background="{DynamicResource Theme.Note}">
            <Grid>
              <TextBlock Text="Nessuna nota" Visibility="{Binding NotePlaceholderVisibility}" Style="{StaticResource NotePlaceholder}" />
              <TextBox Text="{Binding Note, Mode=OneWay}"
                       Style="{StaticResource NoteBox}"
                       IsReadOnly="True"
                       IsHitTestVisible="False"
                       Focusable="False" />
            </Grid>
          </Border>

          <!-- Branch di ogni repository presente, nella griglia standard delle card: il repository
               nel badge, il branch come testo. -->
          <local:LaneGrid ItemsSource="{Binding ChipBranches}" Margin="0,8,0,0">
            <local:LaneGrid.ItemTemplate>
              <DataTemplate>
                <local:Lane Badge="{Binding Repository}" Text="{Binding Branch}" ToolTip="{Binding Branch}" />
              </DataTemplate>
            </local:LaneGrid.ItemTemplate>
          </local:LaneGrid>

          <Button HorizontalAlignment="Right" Margin="0,8,0,0" Click="ChipCardToggle_Click">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                <Setter Property="Content" Value="Nascondi ambiente" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter Property="Content" Value="Mostra ambiente" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Anteprima di un ambiente ingrandita: copre testata e colonne, il footer resta. -->
    <local:PreviewOverlay x:Name="Overlay" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="3" />

    <!-- Footer minimale, testo bianco: versione dell'exe. Il fondo, scuro e intonato
         allo sfondo acceso (gradiente o scena di Ctrl+T), lo da' MainWindow.xaml.cs insieme alla
         barra del titolo. -->
    <Border x:Name="Footer" Grid.Row="2">
      <TextBlock HorizontalAlignment="Center"
                 Margin="0,4,0,6"
                 FontSize="11"
                 Foreground="White"
                 Opacity="0.85">
        <Run Text="{Binding AppVersion, Mode=OneWay}" /><Run Text="{Binding UpdateNotice, Mode=OneWay}" />
      </TextBlock>
    </Border>
  </Grid>
</Window>
