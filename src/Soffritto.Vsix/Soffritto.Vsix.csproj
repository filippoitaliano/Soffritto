<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows8.0</TargetFramework>
    <RootNamespace>Soffritto.Vsix</RootNamespace>
    <NoWarn>$(NoWarn);NETSDK1057</NoWarn>

    <!-- The VSIX contains no .deps.json, so no RID-based resolution happens at runtime:
         the host would load the placeholder Microsoft.Data.SqlClient.dll at the root (~911 KB), which
         throws "not supported on this platform". Pinning the RID makes MSBuild flatten into the root
         the real Windows implementation (~2.1 MB) and the matching native SNI. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="18.12.1603" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="18.12.1606" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Soffritto.Core\Soffritto.Core.csproj" />
    <ProjectReference Include="..\Soffritto.Presentation\Soffritto.Presentation.csproj" />
  </ItemGroup>

  <!-- The RemoteUserControl resolves its view as an embedded resource named after the type:
       without an explicit LogicalName the build succeeds and the control blows up when opened. -->
  <ItemGroup>
    <EmbeddedResource Include="UI\StatusControl.xaml" LogicalName="Soffritto.Vsix.UI.StatusControl.xaml" />
  </ItemGroup>

  <!-- Icon and preview for the extension manager: the Build SDK puts Content items in the package. -->
  <ItemGroup>
    <Content Include="Images\icon.png" />
    <Content Include="Images\preview.png" />
  </ItemGroup>

</Project>
